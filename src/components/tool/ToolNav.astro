---
// The suite strip for the merged Read/Create surface ("Workbench +
// satellites"): the Audit at /audit plus the three rooms that keep their
// own doors - Transcript and Cross-document take different input objects
// (the Ahrefs different-input test), Documents is the library. Modeled on
// StudioNav, which serves the satellite rooms themselves. The first tab
// cut over from /labs/workbench to /audit on 2026-07-19; the satellite
// links still point at their studio rooms until the full cutover flips
// them to the reserved URL contract (/audit?type=transcript,
// /audit?compare=1 - already honoured by /audit as redirects).
//
// The StudioTag lock markers and the Subscribe pill are gone (2026-08-16):
// every engine is on the free tier (owner decision 2026-08-14), so a lock
// grammar and a pricing link inside the tool would advertise a split that
// no longer exists.
interface Props {
  /** Omit on pages that aren't one of the tabs (e.g. the frozen workbench
     artifact) — no tab renders active, so aria-current can't point at a
     page the user isn't on. */
  current?: 'audit' | 'transcript' | 'cross-document' | 'documents';
  /** Ignored. Retained so existing call sites keep compiling until they drop it. */
  isPro?: boolean;
}
const { current } = Astro.props;

const tabs: { key: NonNullable<Props['current']>; label: string; href: string }[] = [
  { key: 'audit',          label: 'Audit',          href: '/audit' },
  { key: 'transcript',     label: 'Transcript',     href: '/creator/studio/transcript' },
  { key: 'cross-document', label: 'Cross-document', href: '/creator/studio/cross-document' },
  { key: 'documents',      label: 'Documents',      href: '/creator/documents' },
];
---
{/* Same mobile pattern as StudioNav: single-row horizontal scroll with ~44px
   targets; sm+ wraps. */}
<nav class="mb-4 flex items-center justify-between gap-3 flex-nowrap sm:flex-wrap border-b border-hairline pb-0 sm:pb-2" aria-label="Audit tools">
  <div class="flex items-center gap-1 sm:gap-4 flex-nowrap sm:flex-wrap overflow-x-auto sm:overflow-visible min-w-0">
    {tabs.map((t) => (
      <a
        href={t.href}
        aria-current={current === t.key ? 'page' : undefined}
        class={`shrink-0 whitespace-nowrap inline-flex items-center gap-1.5 text-sm px-2 py-2.5 sm:px-0 sm:py-0 sm:pb-0.5 sm:-mb-2 border-b-2 transition-colors ${
          current === t.key
            ? 'text-ink-strong font-semibold border-accent-support'
            : 'text-muted border-transparent hover:text-ink'
        }`}
      >
        {t.label}
      </a>
    ))}
  </div>
</nav>
