---
// CSS-only component for retrieved sources — rendered client-side.
---

<style is:global>
  .wk-section {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #f3f4f6;
  }
  .wk-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 0.75rem;
  }
  .wk-loading {
    font-size: 0.8125rem;
    color: #9ca3af;
    font-style: italic;
  }
  .wk-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .wk-card {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #e5e7eb;
    background: #fafafa;
  }
  .wk-card-top {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }
  .wk-badge {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .wk-badge-supports    { background: #d1fae5; color: #065f46; }
  .wk-badge-contradicts { background: #fee2e2; color: #991b1b; }
  .wk-badge-context     { background: #f3f4f6; color: #6b7280; }
  .wk-title {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #1d4ed8;
    text-decoration: none;
    line-height: 1.4;
    word-break: break-word;
  }
  .wk-title:hover { text-decoration: underline; }
  .wk-description {
    font-size: 0.8125rem;
    color: #4b5563;
    line-height: 1.5;
    margin-bottom: 0.375rem;
  }
  .wk-quote {
    font-size: 0.75rem;
    color: #6b7280;
    font-style: italic;
    border-left: 2px solid #d1d5db;
    padding-left: 0.625rem;
    line-height: 1.5;
    margin: 0;
  }
  /* Muted inline note for rate-limited / unavailable states — no header */
  .wk-notice {
    font-size: 0.8125rem;
    color: #374151;
    background: #f9fafb;
    font-style: italic;
    padding: 0.625rem 0.875rem;
    border-radius: 0.375rem;
    border: 1px solid #f3f4f6;
    line-height: 1.5;
    margin: 0;
  }
</style>
