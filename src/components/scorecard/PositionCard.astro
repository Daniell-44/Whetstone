---
import type { ScorecardPosition } from '../../lib/scorecard';
import LabelWithTooltip from '../ui/LabelWithTooltip';
import { leaningStyle } from '../topic/types';

interface Props {
  position: ScorecardPosition;
}

const { position } = Astro.props;
const lean = typeof position.leaning === 'number' ? leaningStyle(position.leaning) : null;

// Pull a clean domain for each source as a lightweight "outlet" cue.
function hostOf(url: string): string {
  try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; }
}
---

<article class="flex flex-col rounded-xl border border-gray-200 bg-white overflow-hidden">

  <!-- Position label + leaning -->
  <header class="px-5 pt-5 pb-4 border-b border-gray-100 flex items-center gap-2 flex-wrap">
    <h2 class="text-xs font-semibold tracking-widest text-indigo-500 uppercase">
      {position.label}
    </h2>
    {lean && (
      <span class={`text-xs font-medium px-1.5 py-0.5 rounded ml-auto ${lean.pill}`}>{lean.label}</span>
    )}
  </header>

  <div class="flex flex-col flex-1 px-5 py-5 gap-6">

    <!-- In the media (sources promoted to faces) -->
    <section>
      <h3 class="text-xs font-semibold tracking-widest text-gray-400 uppercase mb-3">In the media</h3>
      <ul class="space-y-2">
        {position.sources.map(source => (
          <li>
            <a
              href={source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block rounded-lg border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50/40 px-3 py-2 transition-colors"
            >
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-xs font-semibold text-gray-800">{source.publication}</span>
                {hostOf(source.url) && <span class="text-xs text-gray-400">· {hostOf(source.url)}</span>}
              </div>
              <p class="text-xs text-gray-600 group-hover:text-indigo-700 leading-snug transition-colors">{source.title} →</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- The claim (scannable essence) -->
    <section>
      <h3 class="text-xs font-semibold tracking-widest text-gray-400 uppercase mb-2">The case</h3>
      <p class="text-sm text-gray-800 leading-relaxed">{position.bestCase.claim}</p>

      <!-- Full Toulmin breakdown, one click away to keep the card scannable -->
      <details class="group mt-2">
        <summary class="cursor-pointer list-none text-xs font-medium text-indigo-600 hover:text-indigo-800 select-none">
          <span class="group-open:hidden">Full case + assumption ↓</span>
          <span class="hidden group-open:inline">Hide ↑</span>
        </summary>
        <dl class="space-y-3 mt-3">
          <div class="pl-3 border-l-2 border-indigo-200">
            <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-0.5"><LabelWithTooltip label="toulminGrounds" /></dt>
            <dd class="text-xs text-gray-600 leading-relaxed">{position.bestCase.grounds}</dd>
          </div>
          <div class="pl-3 border-l-4 border-indigo-500">
            <dt class="text-xs font-semibold text-indigo-600 uppercase tracking-wide mb-0.5"><LabelWithTooltip label="toulminWarrant" /></dt>
            <dd class="text-xs text-indigo-800 leading-relaxed">{position.bestCase.warrant}</dd>
          </div>
        </dl>
      </details>
    </section>

    <!-- Fatal Flaw (the punchy differentiator — always visible) -->
    <section class="mt-auto">
      <div class="rounded-lg bg-amber-50 border border-amber-200 p-3">
        <p class="text-xs font-semibold text-amber-700 mb-1">
          <span aria-hidden="true" class="mr-1">⚠</span>Fatal flaw: {position.fatalFlaw.name}
        </p>
        <p class="text-xs text-amber-900 leading-relaxed">{position.fatalFlaw.explanation}</p>
      </div>
    </section>

  </div>

</article>
