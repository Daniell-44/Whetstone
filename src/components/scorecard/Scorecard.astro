---
import type { Scorecard } from '../../lib/scorecard';
import PositionCard from './PositionCard.astro';

interface Props {
  scorecard: Scorecard;
}

const { scorecard } = Astro.props;

const n = scorecard.positions.length;
const gridClass =
  n === 2 || n === 4
    ? 'sm:grid-cols-2'
    : 'sm:grid-cols-2 lg:grid-cols-3';

const dateFormatted = new Date(scorecard.publishedDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<!-- Briefing header -->
<header class="mb-8">
  <p class="text-xs font-semibold tracking-widest text-indigo-500 uppercase mb-4">Briefing</p>
  <h1 class="font-serif text-3xl sm:text-4xl text-gray-900 leading-tight mb-4">
    {scorecard.question}
  </h1>
  <p class="text-lg text-gray-500 leading-relaxed max-w-2xl mb-4 font-serif italic">
    {scorecard.dek}
  </p>
  <p class="text-xs text-gray-400 border-t border-gray-100 pt-3">
    By <span class="font-medium text-gray-600">The Whetstone</span> · {dateFormatted}
  </p>
</header>

<!-- The bottom line (synthesis, led up front like a standfirst) -->
<section aria-label="The bottom line" class="mb-12">
  <div class="border-l-4 border-indigo-500 pl-5 sm:pl-6 py-1">
    <p class="text-xs font-semibold tracking-widest text-indigo-500 uppercase mb-2">The bottom line</p>
    <p class="font-serif text-xl sm:text-2xl text-gray-900 leading-snug mb-3">
      {scorecard.metaAnalysis.bridgingWarrant}
    </p>
    <p class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-2xl">
      {scorecard.metaAnalysis.explanation}
    </p>
  </div>
</section>

<!-- Positions grid -->
<section aria-label="Positions" class="mb-16">
  <div class="flex items-center gap-3 mb-5">
    <h2 class="text-xs font-semibold tracking-widest text-gray-400 uppercase shrink-0">The sides</h2>
    <div class="h-px flex-1 bg-gray-200" />
  </div>
  <div class={`grid grid-cols-1 ${gridClass} gap-6`}>
    {scorecard.positions.map(position => (
      <PositionCard position={position} />
    ))}
  </div>
</section>

<!-- CTA -->
<section class="text-center py-8 border-t border-gray-100">
  <p class="text-sm text-gray-500 mb-4">Want to stress-test your own argument before you publish it?</p>
  <a
    href="/creator/studio"
    class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors"
  >
    Run this audit on your own draft
    <span aria-hidden="true">→</span>
  </a>
</section>
