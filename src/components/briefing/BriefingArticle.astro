---
import PopulatedSpectrum from './PopulatedSpectrum.astro';
import BandedSpectrum from './BandedSpectrum.astro';
import type { BriefingArticle } from '../../../functions/_lib/briefing/types';

interface Props { briefing: BriefingArticle }
const { briefing } = Astro.props;

// Must match the spectrum palette (PositionSpectrum / SPECTRUM_DOT).
const COLOURS = [
  { rule: '#185FA5', chipBg: '#E6F1FB', chipText: '#185FA5' },
  { rule: '#993C1D', chipBg: '#FAECE7', chipText: '#993C1D' },
  { rule: '#BA7517', chipBg: '#FAEEDA', chipText: '#854F0B' },
  { rule: '#1D9E75', chipBg: '#E1F5EE', chipText: '#0F6E56' },
  { rule: '#534AB7', chipBg: '#EEEDFE', chipText: '#3C3489' },
];
const KIND_LABEL: Record<string, string> = { structural: 'Logic', interpretive: 'Judgment call', empirical: 'Factual' };
// Groundedness chips via semantic tokens (the Instrument wiring — squared, mono).
const KIND_STYLE: Record<string, string> = {
  structural:   'bg-logic-bg text-logic border-logic/30',
  interpretive: 'bg-judgment-bg text-judgment border-judgment/30',
  empirical:    'bg-factual-bg text-factual border-factual/30',
};

const leftSources  = briefing.sources.filter((s) => s.side === 'left');
const rightSources = briefing.sources.filter((s) => s.side === 'right');
const isExplainer  = briefing.kind === 'explainer';
const fmtDate = new Date(briefing.publishedDate + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const firstPositionIdx = briefing.blocks.findIndex((b) => b.type === 'position');
// The landscape block is the LEDE — it renders before the spectrum (the map is
// a figure that follows the opening claim, not a diagram the reader hits before
// any prose). Pulled out here and skipped in the block map below.
const landscapeBlock = briefing.blocks.find((b) => b.type === 'landscape');
const landscapeText  = landscapeBlock && 'text' in landscapeBlock ? landscapeBlock.text : '';
// "The settled facts" box: extracted like landscape and rendered boxed near the
// top (below the deck/date), so the reader meets the uncontested ground before
// the contested positions — the Verity facts/spin separation, on-brand.
const contextBlock = briefing.blocks.find((b) => b.type === 'context');
// Explainers have no landscape lede; their first prose paragraph is the dek.
const firstProseIdx  = briefing.blocks.findIndex((b) => b.type === 'prose');

// Editor's-read leader: the verdict's first sentence surfaces under the lede,
// so the reader isn't 600+ words from any editorial signal. The full view
// (with "why this might be wrong") stays at #discussion.
const editorBlock = briefing.blocks.find((b) => b.type === 'editorView');
function firstSentence(t: string): string {
  const flat = t.replace(/\s+/g, ' ').trim();
  // Sentence-ending punctuation (optionally closing a quote/bracket) followed
  // by a space or end-of-text; non-greedy so the FIRST sentence wins.
  const m = flat.match(/^.*?[.!?…]["')\]]*(?=\s|$)/);
  if (m) return m[0];
  if (flat.length <= 180) return flat;
  let cut = flat.slice(0, 180);
  const sp = cut.lastIndexOf(' ');
  if (sp > 0) cut = cut.slice(0, sp);
  return cut + '…';
}
const editorLead = editorBlock && 'text' in editorBlock ? firstSentence(editorBlock.text) : '';

// A position's `quote` is the verbatim extract AND it also sits inside the
// paragraph (that is the authored contract: the paragraph contains the quote).
// Rendering both would print the sentence twice, so split the paragraph around
// it and promote the extract to a pull quote. That is readability rule 7 from
// the assessment playbook, and it puts a scan anchor exactly where the
// argument turns. Curly-to-straight normalisation is 1:1 per character, so
// indices found in the normalised copy are valid in the original.
function splitOnQuote(paragraph: string, quote: string): { before: string; pull: string; after: string } {
  const q = (quote ?? '').trim();
  if (!q) return { before: paragraph, pull: '', after: '' };
  const norm = (s: string) => s.replace(/[‘’]/g, "'").replace(/[“”]/g, '"');
  const hay = norm(paragraph);
  const needle = norm(q).replace(/^["']|["']$/g, '');
  const i = hay.indexOf(needle);
  // Not found (the author quoted a different source than the paragraph body):
  // keep the paragraph whole and hang the extract underneath it.
  if (i === -1) return { before: paragraph, pull: q, after: '' };
  let start = i;
  let end = i + needle.length;
  if (hay[start - 1] === '"') start -= 1;
  if (hay[end] === '"') end += 1;
  return {
    before: paragraph.slice(0, start).replace(/[\s:,]+$/, ''),
    pull:   needle,
    after:  paragraph.slice(end).replace(/^[\s.,;]+/, ''),
  };
}

// v2 source model (D2 Option A): positions plot, evidence is a bibliography.
const posSrc = briefing.positionSources ?? [];
const eviSrc = briefing.evidenceSources ?? [];
const v2 = posSrc.length > 0;
const hasTakes = briefing.blocks.some((b) => b.type === 'takes');
// Stance poles — the Instrument palette: drafting blue vs oxide rust (never the redline).
const stanceCol = (s: number) => (s < 0 ? '#345D7E' : s > 0 ? '#8C4A2F' : '#6E7370');
// Provenance chips for standard-form rows (diverge columns).
const PROV_CHIP: Record<string, string> = {
  quoted:   'bg-logic-bg text-logic border-logic/30',
  stated:   'border-hairline text-muted',
  supplied: 'border-accent-support/40 text-accent-support',
};
// Colour is never the only channel (Daniel is colourblind; so are ~8% of male
// readers): every stance encoding carries a positional tick-rule and a text
// pole label alongside the hue. The tick device is the calibration-rule motif.
const STANCE_STEPS = [-2, -1, 0, 1, 2] as const;
const poleLabel = (s: number) =>
  s === 0 ? 'centre'
  : `${Math.abs(s) === 1 ? 'leans ' : ''}${s < 0 ? briefing.spectrumAxis.left : briefing.spectrumAxis.right}`;
const stanceById = new Map(posSrc.map((s) => [s.id, s.stance] as const));
const posSourceById = new Map(posSrc.map((s) => [s.id, s] as const));
// Sources plotted on the spectrum but WITHOUT a full ::position block —
// they get an inline commentary card (label + interest + their quote + one-
// line audit). This is the merged-in former ::takes format for sources
// too small to warrant a full block. Sorted by stance so cards read
// left-to-right in axis order.
const blockSourceIds = new Set(briefing.blocks.flatMap((b) => (b.type === 'position' ? [b.sourceId] : [])));
const inlineCommentary = posSrc
  .filter((s) => !blockSourceIds.has(s.id) && s.quote && s.auditNote)
  .sort((a, b) => a.stance - b.stance);
// The kicker names the register so a reader always knows what they're reading.
// review = drafting-blue, opinion = oxide-rust (clearly the author's voice),
// explainer = accent-support, briefing = muted. Decided 2026-07-21.
const KIND = briefing.kind ?? 'briefing';
const kickerLabel = KIND === 'explainer' ? 'Explainer' : KIND === 'review' ? 'Review' : KIND === 'opinion' ? 'Essay' : 'Briefing';
const kickerCls = KIND === 'opinion' ? 'text-[#8C4A2F]' : (KIND === 'explainer' || KIND === 'review') ? 'text-accent-support' : 'text-muted';
---
<article class="max-w-[36rem] mx-auto">
  <span class={`font-mono text-[11px] uppercase tracking-[0.1em] ${kickerCls}`}>{kickerLabel}{briefing.category ? ` · ${briefing.category}` : ''}</span>
  <h1 id="overview" class="font-serif text-3xl sm:text-4xl text-ink-strong leading-tight mt-2 mb-2 scroll-mt-24">{briefing.question}</h1>
  {/* The deck: front-matter `hook` was parsed and typed but rendered nowhere.
     One serif line under the headline, the first anchor before the long
     opening run (the question-as-deck convention). */}
  {briefing.hook && (
    <p class="font-serif text-lg sm:text-xl text-ink leading-snug mb-3">{briefing.hook}</p>
  )}
  <p class="text-xs text-muted mb-6 tabular-nums">{fmtDate}</p>

  {/* The settled facts: the uncontested ground, boxed and set apart from the
     contested positions below (the Verity facts/spin separation, in the
     Instrument register). Static, no redline. Especially load-bearing on
     non-opinion pieces where the reader needs the shared reality first. */}
  {contextBlock && contextBlock.type === 'context' && contextBlock.items.length > 0 && (
    <div class="mb-7 border border-hairline bg-surface">
      <div class="instrument-rule"></div>
      <div class="px-4 py-3.5">
        <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-2.5">{contextBlock.label}</span>
        <ul class="space-y-2">
          {contextBlock.items.map((it) => (
            <li class="grid grid-cols-[0.75rem_1fr] gap-2.5 text-[15px] text-ink leading-snug">
              <span class="text-muted" aria-hidden="true">·</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  {/* The lede opens the piece; the map (spectrum) follows it, so the reader
     meets a claim about the world before a methodology diagram. */}
  {!isExplainer && landscapeText && (
    <p class="text-lg text-ink leading-relaxed mb-6">{landscapeText}</p>
  )}

  {/* Two-line editor's-read leader: kicker + first sentence of the verdict,
     anchored to the full editor's view below. */}
  {!isExplainer && editorLead && (
    <div class="mb-6">
      <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-1.5">Our read</span>
      <p class="font-serif text-base text-ink-strong leading-relaxed">{editorLead}</p>
      <a href="#discussion" class="mt-1 inline-block text-xs font-medium text-accent-support hover:underline">Full editor's view, and the devil's advocate →</a>
    </div>
  )}

  {/* Tier 1 — the principals: the primary sources UNDER audit, each → its own
     review. Rendered as cards ABOVE the commentary spectrum so the reader sees
     what is being assessed before who is weighing in (the stratification
     decided 2026-07-21). Not audited inline: their audit is the review. */}
  {!isExplainer && briefing.principals && briefing.principals.length > 0 && (
    <div class="mb-7">
      <div class="flex items-center gap-3 mb-3">
        <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-ink-strong">The sources under audit</span>
        <span class="h-px flex-1 bg-hairline"></span>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {briefing.principals.map((p) => (
          <div class="bg-paper border border-hairline border-t-[3px] border-t-ink-strong px-4 py-3 flex flex-col gap-1.5">
            <span class="font-serif text-base font-semibold text-ink-strong leading-tight">{p.name}</span>
            {p.finding && <span class="text-[13px] text-ink leading-snug">{p.finding}</span>}
            {p.interest && <span class="font-mono text-[10px] uppercase tracking-[0.03em] text-[#8C4A2F] leading-snug">Interest: {p.interest}</span>}
            {p.reviewSlug
              ? <a href={`/briefing/${p.reviewSlug}`} class="mt-auto pt-1 font-mono text-[10px] uppercase tracking-[0.04em] text-accent-support hover:text-accent">Full review →</a>
              : <span class="mt-auto pt-1 font-mono text-[10px] uppercase tracking-[0.04em] text-muted">Review forthcoming</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  {/* The commentary spectrum normally renders inside the block map, just before
     the first position (so cruxes/matrix come first). Fallback: a briefing with
     NO ::position blocks (legacy ::sources only) still needs its spectrum, so
     render it here in that case. */}
  {!isExplainer && firstPositionIdx === -1 && (posSrc.length > 0 || briefing.sources.length > 0) && (
    <div class="mb-7">
      {v2
        ? <BandedSpectrum positions={posSrc} axis={briefing.spectrumAxis} />
        : <PopulatedSpectrum sources={briefing.sources} axis={briefing.spectrumAxis} />}
      <div class="border-b border-hairline mt-4"></div>
    </div>
  )}

  <div class="space-y-5">
    {briefing.blocks.map((block, idx) => {
      if (block.type === 'landscape') {
        // Rendered as the lede above; skip here.
        return null;
      }
      if (block.type === 'context') {
        // Rendered boxed at the top; skip in the flow.
        return null;
      }
      if (block.type === 'line') {
        // Named section marker (de-numbered 2026-07-21: the five lines are
        // parallel, not a 1→5 sequence, so an ordinal was decoration that
        // implied a false order). A hairline + serif name, no number.
        return (
          <div class="border-t border-hairline pt-2.5">
            <span class="font-serif text-lg font-semibold text-ink-strong leading-snug">{block.name}</span>
          </div>
        );
      }
      if (block.type === 'cruxes') {
        // Crux display A: the disagreement shown as a named set at once, so the
        // reader sees the whole shape before the prose walks it. No numbers.
        return (
          <div class="bg-surface border border-hairline px-4 py-3.5">
            <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-2.5">{block.label}</span>
            <div class="flex flex-wrap gap-2">
              {block.items.map((it) => (
                <span class="border border-hairline bg-paper px-2.5 py-1 text-sm text-ink-strong">{it}</span>
              ))}
            </div>
          </div>
        );
      }
      if (block.type === 'matrix') {
        // Crux display C: who-disagrees-on-what. Restyled 2026-07-21 from a
        // hairline table into cards-per-crux with the two actor columns
        // sharing the piece's stance palette (drafting-blue vs oxide-rust)
        // and mono values — reads as claims, not a spreadsheet. Two actors
        // is the strong case (the parent's principals); three or more falls
        // back to a compact table so wide grids don't blow out mobile.
        const twoActor = block.actors.length === 2;
        return (
          <div class="my-4">
            {/* A small heading for the block so it reads as an anchor, not
               an inline afterthought. Serif h3, matching the tier heading
               grammar but one level down. */}
            {block.caption && <h3 class="font-serif text-lg text-ink-strong mb-3 leading-snug">{block.caption}</h3>}
            {twoActor ? (
              <div class="grid gap-2">
                {/* Column headers — the two actors, coloured by stance. */}
                <div class="grid grid-cols-[6.5rem_1fr_1fr] gap-2 pb-2 border-b border-hairline">
                  <span></span>
                  {block.actors.map((a, i) => (
                    <span class={`font-mono text-[10px] font-semibold uppercase tracking-[0.06em] ${i === 0 ? 'text-[#345D7E]' : 'text-[#8C4A2F]'}`}>{a}</span>
                  ))}
                </div>
                {block.rows.map((r) => (
                  <div class="grid grid-cols-[6.5rem_1fr_1fr] gap-2 items-baseline border-b border-hairline/60 pb-2">
                    <span class="font-mono text-[10.5px] uppercase tracking-[0.05em] text-muted leading-snug">{r.crux}</span>
                    {r.cells.map((c, i) => (
                      <span class={`font-serif text-[15px] leading-tight ${i === 0 ? 'text-[#345D7E]' : 'text-[#8C4A2F]'}`}>{c}</span>
                    ))}
                  </div>
                ))}
              </div>
            ) : (
              /* Fallback: compact table for 3+ actors. */
              <div class="overflow-x-auto border border-hairline">
                <table class="w-full border-collapse text-[13px]">
                  <thead>
                    <tr>
                      <th class="text-left align-bottom p-2 border-b border-hairline bg-paper font-mono text-[10px] uppercase tracking-wide text-muted font-semibold">Crux</th>
                      {block.actors.map((a) => (
                        <th class="text-left align-bottom p-2 border-b border-l border-hairline bg-paper font-mono text-[10px] uppercase tracking-wide text-muted font-semibold whitespace-nowrap">{a}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {block.rows.map((r) => (
                      <tr>
                        <th class="text-left align-top p-2 border-t border-hairline font-semibold text-ink-strong text-[13px]">{r.crux}</th>
                        {r.cells.map((c) => (
                          <td class="align-top p-2 border-t border-l border-hairline text-ink">{c}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        );
      }
      if (block.type === 'diverge') {
        // Decision 3 (A+C combined, 2026-08-05): parallel standard form as the
        // default register, the authored prose behind a pure-CSS toggle. Radio
        // inputs + sibling selectors — the briefing pages stay zero-JS.
        const pinData = block.pins.map((pin) => {
          const src = posSourceById.get(pin.sourceId);
          const posBlock = briefing.blocks.find((x) => x.type === 'position' && x.sourceId === pin.sourceId);
          const audit = posBlock && posBlock.type === 'position' ? posBlock.audit : undefined;
          return src ? {
            pin, src,
            finding: audit?.name,
            kind: audit?.kind ?? src.auditKind,
            note: pin.note ?? src.auditNote ?? '',
            // Quote precedence: the source row's inline quote, else the quote
            // authored on its full ::position block (grattan/aemo pattern).
            quote: src.quote ?? (posBlock && posBlock.type === 'position' ? posBlock.quote : '') ?? '',
          } : null;
        }).filter((x) => x !== null);
        return (
          <section class="not-prose">
            <hr class="border-0 border-t border-ink-strong mb-4" />
            <h2 class="font-serif text-2xl text-ink-strong mb-1 leading-tight">{block.label}</h2>
            {block.house && <p class="text-sm text-muted mb-4">{block.house}</p>}
            <div class="dv">
              <input type="radio" name={`dv-${idx}`} id={`dv-${idx}-prem`} class="dv-r-prem" checked />
              <input type="radio" name={`dv-${idx}`} id={`dv-${idx}-prose`} class="dv-r-prose" />
              <div class="dv-tabs flex w-max border border-ink-strong mb-5">
                <label for={`dv-${idx}-prem`} class="font-mono text-[10.5px] uppercase tracking-[0.08em] px-3 py-1.5 cursor-pointer text-muted">The arguments, numbered</label>
                <label for={`dv-${idx}-prose`} class="font-mono text-[10.5px] uppercase tracking-[0.08em] px-3 py-1.5 cursor-pointer text-muted">As written</label>
              </div>
              <div class="dv-pane dv-pane-prem">
                {/* Premises pair by INDEX across the two columns and share a
                   grid row, so matching premises sit vertically aligned — the
                   layout echoes a table without being one (Daniel,
                   2026-08-05). An optional 4th pipe column names the crux the
                   pair answers; a missing counterpart renders as an explicit
                   gap, which is information (absence-as-signal). */}
                {(() => {
                  const aPrem = block.a.rows.filter((r) => r.provenance !== 'conclusion');
                  const bPrem = block.b.rows.filter((r) => r.provenance !== 'conclusion');
                  const aConc = block.a.rows.find((r) => r.provenance === 'conclusion');
                  const bConc = block.b.rows.find((r) => r.provenance === 'conclusion');
                  {/* Pairing: by index, with one exception that makes
                     asymmetric premises honest (Daniel, 2026-08-05): when the
                     two rows at an index carry DIFFERENT crux labels, they are
                     different claims and each gets its own row with a gap
                     opposite. A row's crux otherwise comes from whichever side
                     authored one, so labels need not be duplicated. */}
                  const pairs = [];
                  for (let ri = 0; ri < Math.max(aPrem.length, bPrem.length); ri++) {
                    const a = aPrem[ri];
                    const b = bPrem[ri];
                    if (a && b && a.crux && b.crux && a.crux !== b.crux) {
                      pairs.push({ a, b: undefined, crux: a.crux });
                      pairs.push({ a: undefined, b, crux: b.crux });
                    } else {
                      pairs.push({ a, b, crux: a?.crux ?? b?.crux });
                    }
                  }
                  {/* Cell layout: provenance chip (and number, when no crux
                     row carries it) on its own line, the argument text below
                     at full cell width (Daniel, 2026-08-05). */}
                  const cell = (r, hasCrux) => r ? (
                    <div class="py-2">
                      <div class="flex items-center gap-2 mb-1">
                        {!hasCrux && <span class="font-mono text-[10.5px] text-muted tabular-nums">{r.id}</span>}
                        <span class={`font-mono text-[8.5px] uppercase tracking-wide px-1 py-0.5 border ${PROV_CHIP[r.provenance]}`}>{r.provenance === 'supplied' ? '★ supplied' : r.provenance}</span>
                      </div>
                      <div class="text-[13.5px] text-ink leading-snug">{r.text}</div>
                    </div>
                  ) : (
                    <div class="py-2 text-[12px] text-muted italic">no corresponding premise</div>
                  );
                  return (
                    <div class="overflow-x-auto">
                      <div class="grid grid-cols-2 gap-x-6 min-w-[34rem]">
                        {[block.a, block.b].map((col) => (
                          <div class="border-b border-ink-strong pb-1.5">
                            <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-ink-strong">{col.label}</span>
                            {col.interest && <span class="block text-[11px] text-muted leading-snug mt-0.5">{col.interest}</span>}
                          </div>
                        ))}
                        {pairs.map((p) => (
                          <>
                            {p.crux && (
                              <div class="col-span-2 border-t border-hairline pt-1.5 -mb-1">
                                <span class="font-mono text-[9.5px] uppercase tracking-[0.06em] text-muted"><span class="tabular-nums">{(p.a ?? p.b)?.id}</span> · {p.crux}</span>
                              </div>
                            )}
                            <div class={p.crux ? '' : 'border-t border-hairline'}>{cell(p.a, !!p.crux)}</div>
                            <div class={p.crux ? '' : 'border-t border-hairline'}>{cell(p.b, !!p.crux)}</div>
                          </>
                        ))}
                        <div class="border-t border-ink-strong/40 mt-1 pt-2 pb-1">
                          {aConc && <div class="flex gap-2.5 text-[13.5px] font-medium text-ink-strong leading-snug"><span class="font-mono shrink-0">∴</span><span>{aConc.text}</span></div>}
                        </div>
                        <div class="border-t border-ink-strong/40 mt-1 pt-2 pb-1">
                          {bConc && <div class="flex gap-2.5 text-[13.5px] font-medium text-ink-strong leading-snug"><span class="font-mono shrink-0">∴</span><span>{bConc.text}</span></div>}
                        </div>
                      </div>
                    </div>
                  );
                })()}
                {block.sharedNeed && (
                  <div class="mt-4 border border-accent-support/40 bg-surface px-3.5 py-2.5 text-[13.5px] text-ink leading-snug">
                    <span class="font-mono text-[9px] font-semibold uppercase tracking-wide text-accent-support mr-2">★ supplied · both arguments need</span>
                    {block.sharedNeed}
                  </div>
                )}
                {pinData.length > 0 && (
                  <div class="mt-4 space-y-2.5">
                    {pinData.map(({ pin, src, finding, kind, note, quote }) => (
                      <div class="bg-paper border border-hairline px-3.5 py-2.5" style={`border-left:4px solid ${stanceCol(src.stance)}`}>
                        <div class="flex items-baseline gap-x-2 gap-y-1 flex-wrap">
                          <span class="font-serif text-[15px] font-semibold text-ink-strong leading-snug">{src.label}</span>
                          {src.publication && <span class="font-mono text-[9.5px] uppercase tracking-[0.05em] text-muted">{src.publication}</span>}
                          <span class="ml-auto font-mono text-[9px] uppercase tracking-[0.06em] text-muted">pinned → {pin.at}</span>
                        </div>
                        {quote && <blockquote class="font-serif text-[14px] italic text-ink-strong leading-snug mt-1">“{quote}”</blockquote>}
                        <p class="text-[12.5px] text-ink leading-snug mt-1.5">
                          {finding && <span class="font-serif font-semibold text-ink-strong mr-1.5">{finding}.</span>}
                          {kind && <span class={`inline-block mr-1.5 font-mono text-[9px] uppercase tracking-wide px-1 py-0.5 border align-baseline ${KIND_STYLE[kind]}`}>{KIND_LABEL[kind]}</span>}
                          {note}
                          <a href={`#pos-${src.id}`} class="ml-1.5 text-[11px] font-medium text-accent-support hover:underline whitespace-nowrap">full audit ↓</a>
                        </p>
                      </div>
                    ))}
                  </div>
                )}
              </div>
              <div class="dv-pane dv-pane-prose space-y-5">
                {block.prose.map((p) =>
                  p.type === 'line' ? (
                    <div class="border-t border-hairline pt-2.5">
                      <span class="font-serif text-lg font-semibold text-ink-strong leading-snug">{p.name}</span>
                    </div>
                  ) : p.type === 'prose' ? (
                    <p class="text-base text-ink leading-[1.75]">{p.text}</p>
                  ) : null
                )}
              </div>
            </div>
          </section>
        );
      }
      if (block.type === 'prose') {
        // An explainer's first paragraph is its dek: lede-sized, like the
        // landscape opening on a briefing.
        if (isExplainer && idx === firstProseIdx) {
          return <p class="text-lg text-ink leading-relaxed">{block.text}</p>;
        }
        return <p class="text-base text-ink leading-[1.75]">{block.text}</p>;
      }
      if (block.type === 'position') {
        // Stance pole (drafting blue / oxide rust / grey) for migrated briefings;
        // legacy rainbow only if the source isn't a v2 position.
        const st = stanceById.get(block.sourceId);
        const rule = st !== undefined ? stanceCol(st) : COLOURS[((block.colourIndex % COLOURS.length) + COLOURS.length) % COLOURS.length].rule;
        const kindStyle = KIND_STYLE[block.audit.kind] ?? KIND_STYLE.structural;
        return (
          <div id={`pos-${block.sourceId}`} class="scroll-mt-24">
            {/* Keeps the ToC "#positions" anchor working on the first position
               (a block can't carry two ids; the spectrum markers jump here by
               `pos-<sourceId>`). Zero-height, no layout impact. */}
            {idx === firstPositionIdx && <span id="positions" class="block scroll-mt-24" aria-hidden="true"></span>}
            {/* The commentary tier — spectrum + cui-bono interest — renders once,
               immediately above the first position, so it follows any cruxes/
               matrix and introduces the audited commentary. */}
            {idx === firstPositionIdx && (
              <div id="commentary" class="mb-8 not-prose scroll-mt-24">
                {/* Full-width tier heading — the reader needs to know the
                   register just changed (principals → commentary). Serif h2 +
                   rule across the reading column, not a mono kicker. */}
                {briefing.principals && briefing.principals.length > 0 && (
                  <>
                    <hr class="border-0 border-t border-ink-strong mb-4" />
                    <h2 class="font-serif text-2xl text-ink-strong mb-1 leading-tight">The commentary</h2>
                    <p class="text-sm text-muted mb-5">How others read the two reports — each source's stance, its interest, and one quoted line audited.</p>
                  </>
                )}
                <div class="mb-4">
                  {v2
                    ? <BandedSpectrum positions={posSrc} axis={briefing.spectrumAxis} />
                    : <PopulatedSpectrum sources={briefing.sources} axis={briefing.spectrumAxis} />}
                </div>
                {inlineCommentary.length > 0 && (
                  <div class="grid gap-4">
                    {inlineCommentary.map((s) => {
                      const rule = stanceCol(s.stance);
                      const kindStyleIC = KIND_STYLE[s.auditKind ?? 'interpretive'] ?? KIND_STYLE.interpretive;
                      return (
                        /* S1 row anatomy (Decision 4, 2026-08-05): fixed slots
                           learned once — name · outlet · position, hairline,
                           interest, quote, audit. The stance rail is 4px, and
                           position is NEVER colour-only: a tick on a five-step
                           rule plus a text pole label carry it chromatically-
                           blind (Ground News fixed-row-anatomy pattern). */
                        <div id={`pos-${s.id}`} class="scroll-mt-24 pl-3.5 py-1.5" style={`border-left:4px solid ${rule}`}>
                          <div class="flex items-baseline gap-x-2.5 gap-y-1 flex-wrap border-b border-hairline pb-1.5 mb-1.5">
                            <span class="font-serif text-[17px] font-semibold text-ink-strong leading-snug">{s.label}</span>
                            {s.publication && <span class="font-mono text-[10px] uppercase tracking-[0.05em] text-muted">{s.publication}</span>}
                            <span class="ml-auto inline-flex items-center gap-1.5" title={`Position: ${poleLabel(s.stance)}`}>
                              <span class="inline-flex items-end gap-[3px] h-[11px]" aria-hidden="true">
                                {STANCE_STEPS.map((v) => (
                                  <span class={v === s.stance ? 'w-[3px] h-[11px]' : 'w-[3px] h-[5px] bg-hairline'} style={v === s.stance ? `background:${rule}` : undefined}></span>
                                ))}
                              </span>
                              <span class="font-mono text-[9px] uppercase tracking-[0.05em] text-muted">{poleLabel(s.stance)}</span>
                            </span>
                          </div>
                          {s.interest && <p class="text-[12px] text-muted leading-snug mb-1"><span class="font-mono text-[9px] uppercase tracking-[0.03em] text-[#8C4A2F] mr-1">Interest</span>{s.interest}</p>}
                          <blockquote class="font-serif text-[15px] italic text-ink-strong leading-snug mb-1.5">“{s.quote}”</blockquote>
                          <p class="text-[13px] text-ink leading-snug pl-3 border-l-2 border-hairline">
                            <span class={`inline-block mr-2 font-mono text-[9px] font-semibold uppercase tracking-wide px-1.5 py-0.5 border ${kindStyleIC}`}>{KIND_LABEL[s.auditKind ?? 'interpretive']}</span>
                            {s.auditNote}
                          </p>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            )}
            <div class="pl-4" style={`border-left:2px solid ${rule}`}>
              {/* The stance label was authored, typed, and used only on feed
                 cards; here it is the waypoint that ties a spectrum marker to
                 its section and breaks the prose run between audit cards. */}
              {block.label && (
                <span class="block font-serif text-[15px] font-semibold text-ink-strong leading-snug mb-1.5">{block.label}</span>
              )}
              {/* Interest disclosure (cui-bono) — moves from the mini-table
                 into the position body itself, next to the source label,
                 where it disambiguates the voice speaking. */}
              {(() => {
                const src = posSourceById.get(block.sourceId);
                return src?.interest && (
                  <p class="text-[13px] leading-snug text-muted mb-2.5">
                    <span class="font-mono text-[10px] uppercase tracking-[0.03em] text-[#8C4A2F] mr-1.5">Interest</span>
                    {src.interest}
                  </p>
                );
              })()}
              {(() => {
                const { before, pull, after } = splitOnQuote(block.paragraph, block.quote);
                return (
                  <>
                    {before && <p class="text-base text-ink leading-[1.75]">{before}</p>}
                    {/* Pull quote: type carries it, not a second rule (the block
                       already has the stance rule two levels out). */}
                    {pull && (
                      <blockquote class={`font-serif text-lg italic text-ink-strong leading-snug ${before ? 'mt-3' : ''}`}>
                        “{pull}”
                      </blockquote>
                    )}
                    {after && <p class="text-base text-ink leading-[1.75] mt-3">{after}</p>}
                  </>
                );
              })()}
              {/* Merged former ::takes atom: a representative quote from the
                 source with a one-line audit. Only renders when authored on
                 the source (positions.quote / auditNote). Layout mirrors the
                 old take (serif quote + rule + audit) so nothing is lost. */}
              {(() => {
                const src = posSourceById.get(block.sourceId);
                if (!src?.quote) return null;
                const kindStyleSrc = KIND_STYLE[src.auditKind ?? 'interpretive'] ?? KIND_STYLE.interpretive;
                return (
                  <div class="mt-4 pt-3 border-t border-hairline/60">
                    <span class="font-mono text-[10px] uppercase tracking-[0.06em] text-muted mb-1.5 block">Their own words</span>
                    <blockquote class="font-serif text-base italic text-ink-strong leading-snug mb-2">“{src.quote}”</blockquote>
                    {src.auditNote && (
                      <p class="text-[13.5px] text-ink leading-snug pl-3 border-l-2 border-hairline">
                        <span class={`inline-block mr-2 font-mono text-[9px] font-semibold uppercase tracking-wide px-1.5 py-0.5 border ${kindStyleSrc}`}>{KIND_LABEL[src.auditKind ?? 'interpretive']}</span>
                        {src.auditNote}
                      </p>
                    )}
                  </div>
                );
              })()}
            </div>
            {block.structure && (
              /* "The argument, numbered" — reveal-after-reading disclosure,
                 below the prose so it reads as an answer key, not a diagram
                 competing with the paragraph (avoids the split-attention /
                 redundancy traps). Static <details>, zero JS. NO strength
                 score: the "need" line says what the step requires, and the
                 supports/asserts pair is the overclaim gap, not a rating. */
              <details class="audit-disclosure mt-3 bg-paper border border-hairline">
                <div class="instrument-rule"></div>
                <summary class="flex items-center gap-2.5 px-3.5 py-2.5 cursor-pointer">
                  <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted shrink-0">The argument, numbered</span>
                  <svg class="audit-chevron ml-auto shrink-0 w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-3.5 pb-3.5">
                  <dl class="text-[15px] leading-snug">
                    {block.structure.rows.map((r) => (
                      <div class={`grid grid-cols-[1.4rem_1fr] gap-2.5 py-1.5 ${r.provenance === 'conclusion' ? 'border-t border-ink-strong/40 mt-1 pt-2.5' : 'border-t border-hairline first:border-t-0'}`}>
                        <dt class={`font-mono text-[11px] tabular-nums ${r.provenance === 'conclusion' ? 'text-ink-strong font-semibold' : 'text-muted'}`}>{r.provenance === 'conclusion' ? '∴' : r.id}</dt>
                        <dd class={r.provenance === 'conclusion' ? 'text-ink-strong font-medium' : 'text-ink'}>
                          <span>{r.text}</span>
                          {r.provenance === 'supplied' && (
                            <span class="ml-1.5 font-mono text-[10px] uppercase tracking-wide text-accent-support align-baseline" title="Not stated by the source — supplied by this audit">★ supplied</span>
                          )}
                          {r.provenance === 'stated' && (
                            <span class="ml-1.5 font-mono text-[10px] uppercase tracking-wide text-muted align-baseline">stated</span>
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                  {block.structure.need && (
                    <div class="mt-3 pl-3 border-l-2 border-accent-support">
                      <span class="block font-mono text-[10px] uppercase tracking-[0.08em] text-muted mb-1">What the step needs</span>
                      <p class="text-sm text-ink leading-relaxed">{block.structure.need}</p>
                    </div>
                  )}
                  {block.structure.supports && block.structure.asserts && (
                    <div class="mt-3 grid grid-cols-[4.5rem_1fr] gap-x-3 gap-y-1.5 text-sm">
                      <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-muted pt-0.5">Supports</span>
                      <span class="text-ink">{block.structure.supports}</span>
                      <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-muted pt-0.5">Asserts</span>
                      <span class="text-ink-strong font-medium">{block.structure.asserts}</span>
                    </div>
                  )}
                </div>
              </details>
            )}
            {block.audit.name && (
              <details class="audit-disclosure mt-3 bg-surface border border-hairline" open={idx === firstPositionIdx}>
                <div class="instrument-rule"></div>
                <summary class="flex items-center gap-2.5 px-3.5 py-2.5 cursor-pointer">
                  <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted shrink-0">Audit</span>
                  <span class="font-serif text-[15px] font-semibold text-ink-strong">{block.audit.name}</span>
                  <span class={`font-mono text-[9px] font-semibold uppercase tracking-wide px-1.5 py-0.5 border shrink-0 ${kindStyle}`}>{KIND_LABEL[block.audit.kind] ?? block.audit.kind}</span>
                  <svg class="audit-chevron ml-auto shrink-0 w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                {/* The audit body matches the position paragraph's size (15px):
                   the per-claim audit is the differentiator, it must not read
                   as a footnote to the text it audits. The per-card watermark
                   line was in-page noise (8.5px) and now lives only on share
                   exports. The deep-link is a chip, not a footnote link. */}
                <div class="px-3.5 pb-3.5">
                  <p class="text-base text-ink leading-relaxed mb-2.5">{block.audit.explanation}</p>
                  {/* Fallibility line: a publication whose product is scrutiny
                     should invite it. Converts a sceptic's bounce into a click. */}
                  <div class="flex items-center flex-wrap gap-x-3 gap-y-2">
                    <a href={`/audit?audit=${briefing.slug}&pos=${encodeURIComponent(block.sourceId)}`} class="inline-flex items-center gap-1.5 text-xs font-medium text-accent-support hover:text-accent hover:border-accent-support/50 border border-hairline rounded px-3 py-2 transition-colors">Audit this argument →</a>
                    <a href="/feedback" class="text-xs text-muted hover:text-ink transition-colors">Does this reading seem wrong? →</a>
                  </div>
                </div>
              </details>
            )}
          </div>
        );
      }
      if (block.type === 'shared') {
        return (
          <div id="shared" class="pl-4 scroll-mt-24 border-l-2 border-accent-support">
            <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-accent-support mb-1.5">The shared assumption</span>
            <p class="text-base text-ink leading-relaxed">{block.text}</p>
          </div>
        );
      }
      if (block.type === 'editorView') {
        return (
          <div id="discussion" class="rounded-md bg-paper border border-hairline p-4 scroll-mt-24">
            <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-1.5">Editor's view · opinion</span>
            <p class="text-base text-ink leading-relaxed">{block.text}</p>
            {/* Devil's advocate lives INSIDE the editor's opinion as a normal
               serif heading, not a mono kicker (Daniel, 2026-08-05) — it's a
               first-class part of the opinion, the editor arguing against the
               view just given. Future direction (recorded in the shelf file):
               community takes an editor steelmans, organised by philosophical
               framework. */}
            {block.whyWrong && (
              <div class="mt-3.5 pt-3 border-t border-hairline">
                <h3 class="font-serif text-lg font-semibold text-ink-strong mb-1.5 leading-snug">Devil's advocate</h3>
                <p class="text-sm text-ink leading-relaxed">{block.whyWrong}</p>
              </div>
            )}
          </div>
        );
      }
      if (block.type === 'takes') {
        return (
          <div>
            <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-2.5">Other takes · audited</span>
            <div class="space-y-2.5">
              {block.items.map((t) => (
                <div class="rounded-md border border-hairline bg-surface p-3">
                  <p class="text-base text-ink leading-snug">“{t.quote}”</p>
                  <p class="text-xs text-muted mt-1.5">
                    {t.url
                      ? <a href={t.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">{t.source}</a>
                      : t.source}
                  </p>
                  <p class="text-[13px] text-muted mt-2 pl-2.5 leading-relaxed" style="border-left:2px solid #1E5C5A"><span class="font-medium text-ink">Audit:</span> {t.audit}</p>
                </div>
              ))}
            </div>
          </div>
        );
      }
      return null;
    })}
  </div>

  {/* Other-takes absence stated (D2 policy) — but only if there IS no
     commentary tier absorbing them. Since the 2026-07-21 takes-merge, a
     briefing with commentary positions already displays every take as an
     inline commentary card, so this note only fires when there are ALSO no
     commentary sources. */}
  {!isExplainer && !hasTakes && briefing.otherTakes === 'none' && posSrc.length === 0 && (
    <div class="mt-8">
      <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-1.5">Other takes</span>
      <p class="text-sm text-muted italic">No further takes surveyed for this question.</p>
    </div>
  )}

  {/* ONE Sources section (a single bibliography, not two competing ones):
     the plotted positions first, then the evidence the argument cites. */}
  {!isExplainer && (v2 || briefing.sources.length > 0) && (
    <div class="mt-10 pt-6 border-t border-hairline">
      <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-4">Sources</span>
      {v2 ? (
        <div class="space-y-6">
          <div>
            <span class="block font-mono text-[10px] uppercase tracking-[0.08em] text-muted/80 mb-2">Positions · {posSrc.length}</span>
            <ul class="space-y-1.5">
              {posSrc.map((s) => (
                <li class="flex items-baseline gap-2">
                  <span class="shrink-0 text-[10px] font-semibold tabular-nums px-1.5 py-0.5 rounded border" style={`color:${stanceCol(s.stance)};border-color:${stanceCol(s.stance)}55;`}>{s.stance > 0 ? `+${s.stance}` : s.stance}</span>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-xs text-ink hover:text-accent">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a>
                  <span class="text-[10px] text-muted">({s.confidence} confidence)</span>
                </li>
              ))}
            </ul>
          </div>
          {eviSrc.length > 0 && (
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.08em] text-muted/80 mb-2">Further evidence · {eviSrc.length}</span>
              <ul class="space-y-1.5">
                {eviSrc.map((s) => (
                  <li class="text-xs leading-relaxed">
                    <a href={s.url} target="_blank" rel="noopener noreferrer" class="font-medium text-ink hover:text-accent">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a>
                    {s.note && <span class="text-muted">: {s.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ) : (
        <div>
          <span class="block font-mono text-[10px] uppercase tracking-[0.08em] text-muted/80 mb-2">Positions · {briefing.sources.length}</span>
          <div class="grid sm:grid-cols-2 gap-5">
            <div class="border-l-2 pl-3" style="border-color:#185FA5">
              <span class="text-xs font-semibold uppercase tracking-wide text-sky-700">{briefing.spectrumAxis.left}</span>
              <ul class="mt-1.5 space-y-1">
                {leftSources.map((s) => (
                  <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="text-xs text-ink hover:text-accent">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a></li>
                ))}
              </ul>
            </div>
            <div class="border-l-2 pl-3" style="border-color:#993C1D">
              <span class="text-xs font-semibold uppercase tracking-wide text-orange-700">{briefing.spectrumAxis.right}</span>
              <ul class="mt-1.5 space-y-1">
                {rightSources.map((s) => (
                  <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="text-xs text-ink hover:text-accent">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )}
    </div>
  )}
</article>

<style>
  /* Collapsible per-claim audit (presentation C). Hide the native disclosure
     triangle; the chevron is our affordance and rotates when open. */
  .audit-disclosure > summary { list-style: none; }
  .audit-disclosure > summary::-webkit-details-marker { display: none; }
  .audit-chevron { transition: transform 0.15s ease; }
  .audit-disclosure[open] > summary .audit-chevron { transform: rotate(180deg); }

  /* Diverge premise ⇄ prose toggle (Decision 3, A+C): pure CSS, zero JS. The
     radios sit visually removed but focusable; their labels are the tabs. */
  .dv { position: relative; }
  .dv > input { position: absolute; opacity: 0; pointer-events: none; }
  .dv .dv-pane { display: none; }
  .dv .dv-r-prem:checked ~ .dv-pane-prem { display: block; }
  .dv .dv-r-prose:checked ~ .dv-pane-prose { display: block; }
  .dv .dv-r-prem:checked ~ .dv-tabs label[for$="-prem"],
  .dv .dv-r-prose:checked ~ .dv-tabs label[for$="-prose"] {
    background: var(--color-ink-strong);
    color: var(--color-paper);
  }
  /* Keyboard affordance: when a hidden radio holds focus, ring its tab. */
  .dv .dv-r-prem:focus-visible ~ .dv-tabs label[for$="-prem"],
  .dv .dv-r-prose:focus-visible ~ .dv-tabs label[for$="-prose"] {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
