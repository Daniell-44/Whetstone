---
import PopulatedSpectrum from './PopulatedSpectrum.astro';
import BandedSpectrum from './BandedSpectrum.astro';
import type { BriefingArticle } from '../../../functions/_lib/briefing/types';

interface Props { briefing: BriefingArticle }
const { briefing } = Astro.props;

// Must match the spectrum palette (PositionSpectrum / SPECTRUM_DOT).
const COLOURS = [
  { rule: '#185FA5', chipBg: '#E6F1FB', chipText: '#185FA5' },
  { rule: '#993C1D', chipBg: '#FAECE7', chipText: '#993C1D' },
  { rule: '#BA7517', chipBg: '#FAEEDA', chipText: '#854F0B' },
  { rule: '#1D9E75', chipBg: '#E1F5EE', chipText: '#0F6E56' },
  { rule: '#534AB7', chipBg: '#EEEDFE', chipText: '#3C3489' },
];
const KIND_LABEL: Record<string, string> = { structural: 'Logic', interpretive: 'Judgment call', empirical: 'Factual' };
// Groundedness chips via semantic tokens (the Instrument wiring — squared, mono).
const KIND_STYLE: Record<string, string> = {
  structural:   'bg-logic-bg text-logic border-logic/30',
  interpretive: 'bg-judgment-bg text-judgment border-judgment/30',
  empirical:    'bg-factual-bg text-factual border-factual/30',
};

const leftSources  = briefing.sources.filter((s) => s.side === 'left');
const rightSources = briefing.sources.filter((s) => s.side === 'right');
const isExplainer  = briefing.kind === 'explainer';
const fmtDate = new Date(briefing.publishedDate + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const firstPositionIdx = briefing.blocks.findIndex((b) => b.type === 'position');
// Decision 22-B (2026-08-08): the audited positions render FIRST, straight
// after the diverge grid (they are the page's argument); the commentary tier
// (map + shorter voices) follows the last of them as the survey of the field.
const lastPositionIdx = briefing.blocks.reduce((acc, b, i) => (b.type === 'position' ? i : acc), -1);
// The landscape block is the LEDE — it renders before the spectrum (the map is
// a figure that follows the opening claim, not a diagram the reader hits before
// any prose). Pulled out here and skipped in the block map below.
const landscapeBlock = briefing.blocks.find((b) => b.type === 'landscape');
const landscapeText  = landscapeBlock && 'text' in landscapeBlock ? landscapeBlock.text : '';
// "The settled facts" box: extracted like landscape and rendered boxed near the
// top (below the deck/date), so the reader meets the uncontested ground before
// the contested positions — the Verity facts/spin separation, on-brand.
const contextBlock = briefing.blocks.find((b) => b.type === 'context');
// When a context box exists, the shared premise is authored INTO its lead
// paragraph (Daniel, 2026-08-06) and the ::shared block renders nowhere on
// this page — it survives in the parse tree solely as the feed card's dek.
// Briefings without a context box keep the standalone shared section.
const sharedBlock = briefing.blocks.find((b) => b.type === 'shared');
const foldShared = !!(contextBlock && sharedBlock);
// Premise pins (from ::diverge) render as "contests →" tags on the voices
// themselves rather than duplicate cards (Daniel, 2026-08-06): each pinned
// source's block links up to the premise it contests.
const divergeBlk = briefing.blocks.find((b) => b.type === 'diverge');
const pinBySource = new Map((divergeBlk && divergeBlk.type === 'diverge' ? divergeBlk.pins : []).map((p) => [p.sourceId, p] as const));
// Explainers have no landscape lede; their first prose paragraph is the dek.
const firstProseIdx  = briefing.blocks.findIndex((b) => b.type === 'prose');

// Editor's-read leader: the verdict's first sentence surfaces under the lede,
// so the reader isn't 600+ words from any editorial signal. The full view
// (with "why this might be wrong") stays at #discussion.
const editorBlock = briefing.blocks.find((b) => b.type === 'editorView');
function firstSentence(t: string): string {
  const flat = t.replace(/\s+/g, ' ').trim();
  // Sentence-ending punctuation (optionally closing a quote/bracket) followed
  // by a space or end-of-text; non-greedy so the FIRST sentence wins.
  const m = flat.match(/^.*?[.!?…]["')\]]*(?=\s|$)/);
  if (m) return m[0];
  if (flat.length <= 180) return flat;
  let cut = flat.slice(0, 180);
  const sp = cut.lastIndexOf(' ');
  if (sp > 0) cut = cut.slice(0, sp);
  return cut + '…';
}
const editorLead = editorBlock && 'text' in editorBlock ? firstSentence(editorBlock.text) : '';

// A position's `quote` is the verbatim extract AND it also sits inside the
// paragraph (that is the authored contract: the paragraph contains the quote).
// Rendering both would print the sentence twice, so split the paragraph around
// it and promote the extract to a pull quote. That is readability rule 7 from
// the assessment playbook, and it puts a scan anchor exactly where the
// argument turns. Curly-to-straight normalisation is 1:1 per character, so
// indices found in the normalised copy are valid in the original.
function splitOnQuote(paragraph: string, quote: string): { before: string; pull: string; after: string } {
  const q = (quote ?? '').trim();
  if (!q) return { before: paragraph, pull: '', after: '' };
  const norm = (s: string) => s.replace(/[‘’]/g, "'").replace(/[“”]/g, '"');
  const hay = norm(paragraph);
  const needle = norm(q).replace(/^["']|["']$/g, '');
  const i = hay.indexOf(needle);
  // Not found (the author quoted a different source than the paragraph body):
  // keep the paragraph whole and hang the extract underneath it.
  if (i === -1) return { before: paragraph, pull: q, after: '' };
  let start = i;
  let end = i + needle.length;
  if (hay[start - 1] === '"') start -= 1;
  if (hay[end] === '"') end += 1;
  return {
    before: paragraph.slice(0, start).replace(/[\s:,]+$/, ''),
    pull:   needle,
    after:  paragraph.slice(end).replace(/^[\s.,;]+/, ''),
  };
}

// v2 source model (D2 Option A): positions plot, evidence is a bibliography.
const posSrc = briefing.positionSources ?? [];
const eviSrc = briefing.evidenceSources ?? [];
const v2 = posSrc.length > 0;
const hasTakes = briefing.blocks.some((b) => b.type === 'takes');
// Stance poles — the Instrument palette: drafting blue vs oxide rust (never the redline).
const stanceCol = (s: number) => (s < 0 ? '#345D7E' : s > 0 ? '#8C4A2F' : '#6E7370');
// Colour is never the only channel (Daniel is colourblind; so are ~8% of male
// readers): every stance encoding carries a positional tick-rule and a text
// pole label alongside the hue. The tick device is the calibration-rule motif.
const STANCE_STEPS = [-2, -1, 0, 1, 2] as const;
const poleLabel = (s: number) =>
  s === 0 ? 'centre'
  : `${Math.abs(s) === 1 ? 'leans ' : ''}${s < 0 ? briefing.spectrumAxis.left : briefing.spectrumAxis.right}`;
const stanceById = new Map(posSrc.map((s) => [s.id, s.stance] as const));
const posSourceById = new Map(posSrc.map((s) => [s.id, s] as const));
// Sources plotted on the spectrum but WITHOUT a full ::position block —
// they get an inline commentary card (label + interest + their quote + one-
// line audit). This is the merged-in former ::takes format for sources
// too small to warrant a full block. Sorted by stance so cards read
// left-to-right in axis order.
const blockSourceIds = new Set(briefing.blocks.flatMap((b) => (b.type === 'position' ? [b.sourceId] : [])));
const inlineCommentary = posSrc
  .filter((s) => !blockSourceIds.has(s.id) && s.quote && s.auditNote)
  .sort((a, b) => a.stance - b.stance);
// The kicker names the register so a reader always knows what they're reading.
// review = drafting-blue, opinion = oxide-rust (clearly the author's voice),
// explainer = accent-support, briefing = muted. Decided 2026-07-21.
const KIND = briefing.kind ?? 'briefing';
// E-2 register for essays (Daniel, 2026-08-06): serif body one size up, the
// hook as a large italic standfirst. The ::skeleton block renders in the page
// margin (E-3), not inline — see /briefing/[slug].astro.
const isOpinion = KIND === 'opinion';
const kickerLabel = KIND === 'explainer' ? 'Explainer' : KIND === 'review' ? 'Review' : KIND === 'opinion' ? 'Essay' : 'Briefing';
const kickerCls = KIND === 'opinion' ? 'text-[#8C4A2F]' : (KIND === 'explainer' || KIND === 'review') ? 'text-accent-support' : 'text-muted';
---
<article class="max-w-[36rem] mx-auto">
  <span class={`font-mono text-[13px] uppercase tracking-[0.08em] ${kickerCls}`}>{kickerLabel}{briefing.category ? ` · ${briefing.category}` : ''}</span>
  <h1 id="overview" class="font-serif text-[34px] text-ink-strong leading-tight mt-2 mb-2 scroll-mt-24">{briefing.question}</h1>
  {/* The deck: front-matter `hook` was parsed and typed but rendered nowhere.
     One serif line under the headline, the first anchor before the long
     opening run (the question-as-deck convention). */}
  {briefing.hook && (
    <p class={isOpinion ? 'font-serif text-[20px] italic text-muted leading-snug mb-4' : 'font-serif text-[20px] text-ink leading-snug mb-3'}>{briefing.hook}</p>
  )}
  <p class="font-mono text-[13px] text-muted mb-6 tabular-nums">{fmtDate}</p>

  {/* The settled facts: the uncontested ground, boxed and set apart from the
     contested positions below (the Verity facts/spin separation, in the
     Instrument register). Static, no redline. Especially load-bearing on
     non-opinion pieces where the reader needs the shared reality first. */}
  {contextBlock && contextBlock.type === 'context' && contextBlock.items.length > 0 && (
    <div id="context" class="mb-7 border border-hairline bg-surface scroll-mt-24">
      <div class="instrument-rule"></div>
      <div class="px-4 py-3.5">
        <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-2.5">{contextBlock.label}</span>
        {contextBlock.lead && <p class="font-serif text-[15px] text-ink leading-relaxed mb-2.5">{contextBlock.lead}</p>}
        {contextBlock.items.length > 0 && (
          <ul class="space-y-2">
            {contextBlock.items.map((it) => (
              <li class="grid grid-cols-[0.75rem_1fr] gap-2.5 font-serif text-[15px] text-ink leading-snug">
                <span class="text-muted" aria-hidden="true">·</span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  )}

  {/* The lede opens the piece; the map (spectrum) follows it, so the reader
     meets a claim about the world before a methodology diagram. */}
  {!isExplainer && landscapeText && (
    <p class="font-serif text-[20px] text-ink leading-relaxed mb-6">{landscapeText}</p>
  )}

  {/* Two-line editor's-read leader: kicker + first sentence of the verdict,
     anchored to the full editor's view below. */}
  {/* The editor teleport (Daniel, 2026-08-06): contrast box, and this is
     where authorship is declared — the apparatus above is engine-assisted,
     the view it jumps to is human-written. Smooth scroll comes from the
     site-wide rule in global.css, so the reader sees the page travel and
     can scroll back up to the figures. */}
  {!isExplainer && editorLead && (
    <div class="mb-6 border border-hairline border-l-[3px] border-l-ink-strong bg-surface px-4 py-3">
      <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-1.5">Our read</span>
      <p class="font-serif text-[17px] text-ink-strong leading-relaxed">{editorLead}</p>
      <div class="flex items-baseline justify-between gap-3 flex-wrap mt-1.5">
        <a href="#discussion" class="inline-block text-[13px] font-medium text-accent-support hover:underline">Full editor's view, and the devil's advocate ↓</a>
        <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted">Briefing: engine-assisted · view: human</span>
      </div>
    </div>
  )}

  {/* Tier 1 — the principals: the primary sources UNDER audit, each → its own
     review. Rendered as cards ABOVE the commentary spectrum so the reader sees
     what is being assessed before who is weighing in (the stratification
     decided 2026-07-21). Not audited inline: their audit is the review. */}
  {!isExplainer && briefing.principals && briefing.principals.length > 0 && (
    <div class="mb-7">
      {/* Rank-2 heading (23-A): serif semibold, one level under the chapter
         heads — the lone ink-strong mono label was a rank of its own. */}
      <div class="flex items-center gap-3 mb-3">
        <span class="font-serif text-[17px] font-semibold text-ink-strong leading-snug">The sources under audit</span>
        <span class="h-px flex-1 bg-hairline"></span>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {briefing.principals.map((p) => (
          <div class="bg-paper border border-hairline border-t-[3px] border-t-ink-strong px-4 py-3 flex flex-col gap-1.5">
            <span class="font-serif text-[17px] font-semibold text-ink-strong leading-tight">{p.name}</span>
            {p.finding && <span class="font-serif text-[15px] text-ink leading-snug">{p.finding}</span>}
            {p.interest && <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-[#8C4A2F] leading-snug">Stake: {p.interest}</span>}
            {/* No "review forthcoming" promise (Daniel, 2026-08-06): a link
               renders only when the review exists. */}
            {p.reviewSlug && <a href={`/briefing/${p.reviewSlug}`} class="mt-auto pt-1 font-mono text-[13px] uppercase tracking-[0.08em] text-accent-support hover:text-accent">Full review →</a>}
          </div>
        ))}
      </div>
    </div>
  )}

  {/* The commentary spectrum normally renders inside the block map, just before
     the first position (so cruxes/matrix come first). Fallback: a briefing with
     NO ::position blocks (legacy ::sources only) still needs its spectrum, so
     render it here in that case. */}
  {!isExplainer && firstPositionIdx === -1 && (posSrc.length > 0 || briefing.sources.length > 0) && (
    <div class="mb-7">
      {v2
        ? <BandedSpectrum positions={posSrc} axis={briefing.spectrumAxis} />
        : <PopulatedSpectrum sources={briefing.sources} axis={briefing.spectrumAxis} />}
      <div class="border-b border-hairline mt-4"></div>
    </div>
  )}

  <div class="space-y-5">
    {briefing.blocks.map((block, idx) => {
      if (block.type === 'landscape') {
        // Rendered as the lede above; skip here.
        return null;
      }
      if (block.type === 'context') {
        // Rendered boxed at the top; skip in the flow.
        return null;
      }
      if (block.type === 'line') {
        // Named section marker (de-numbered 2026-07-21: the five lines are
        // parallel, not a 1→5 sequence, so an ordinal was decoration that
        // implied a false order). A hairline + serif name, no number.
        return (
          <div class="border-t border-hairline pt-2.5">
            <span class="font-serif text-[17px] font-semibold text-ink-strong leading-snug">{block.name}</span>
          </div>
        );
      }
      if (block.type === 'cruxes') {
        // Crux display A: the disagreement shown as a named set at once, so the
        // reader sees the whole shape before the prose walks it. No numbers.
        return (
          <div class="bg-surface border border-hairline px-4 py-3.5">
            <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-2.5">{block.label}</span>
            <div class="flex flex-wrap gap-2">
              {block.items.map((it) => (
                <span class="border border-hairline bg-paper px-2.5 py-1 font-serif text-[15px] text-ink-strong">{it}</span>
              ))}
            </div>
          </div>
        );
      }
      if (block.type === 'matrix') {
        // Crux display C: who-disagrees-on-what. Restyled 2026-07-21 from a
        // hairline table into cards-per-crux with the two actor columns
        // sharing the piece's stance palette (drafting-blue vs oxide-rust)
        // and mono values — reads as claims, not a spreadsheet. Two actors
        // is the strong case (the parent's principals); three or more falls
        // back to a compact table so wide grids don't blow out mobile.
        const twoActor = block.actors.length === 2;
        return (
          <div class="my-4">
            {/* A small heading for the block so it reads as an anchor, not
               an inline afterthought. Serif h3, matching the tier heading
               grammar but one level down. */}
            {block.caption && <h3 class="font-serif text-[17px] font-semibold text-ink-strong mb-3 leading-snug">{block.caption}</h3>}
            {twoActor ? (
              <div class="grid gap-2">
                {/* Column headers — the two actors, coloured by stance. */}
                <div class="grid grid-cols-[6.5rem_1fr_1fr] gap-2 pb-2 border-b border-hairline">
                  <span></span>
                  {block.actors.map((a, i) => (
                    <span class={`font-mono text-[13px] font-semibold uppercase tracking-[0.08em] ${i === 0 ? 'text-[#345D7E]' : 'text-[#8C4A2F]'}`}>{a}</span>
                  ))}
                </div>
                {block.rows.map((r) => (
                  <div class="grid grid-cols-[6.5rem_1fr_1fr] gap-2 items-baseline border-b border-hairline/60 pb-2">
                    <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted leading-snug">{r.crux}</span>
                    {r.cells.map((c, i) => (
                      <span class={`font-serif text-[15px] leading-tight ${i === 0 ? 'text-[#345D7E]' : 'text-[#8C4A2F]'}`}>{c}</span>
                    ))}
                  </div>
                ))}
              </div>
            ) : (
              /* Fallback: compact table for 3+ actors. */
              <div class="overflow-x-auto border border-hairline">
                <table class="w-full border-collapse text-[13px]">
                  <thead>
                    <tr>
                      <th class="text-left align-bottom p-2 border-b border-hairline bg-paper font-mono text-[13px] uppercase tracking-[0.08em] text-muted font-semibold">Crux</th>
                      {block.actors.map((a) => (
                        <th class="text-left align-bottom p-2 border-b border-l border-hairline bg-paper font-mono text-[13px] uppercase tracking-[0.08em] text-muted font-semibold whitespace-nowrap">{a}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {block.rows.map((r) => (
                      <tr>
                        <th class="text-left align-top p-2 border-t border-hairline font-semibold text-ink-strong text-[13px]">{r.crux}</th>
                        {r.cells.map((c) => (
                          <td class="align-top p-2 border-t border-l border-hairline text-ink">{c}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        );
      }
      if (block.type === 'diverge') {
        // Decision 14-C (2026-08-08, supersedes Decision 3's toggle): ONE
        // pass. The chips and the premise/prose tabs are gone; each crux is
        // a numbered serif heading, then the authored paragraph that used to
        // hide behind "As written", then the two reports' premises side by
        // side. 15-C: paired columns on desktop, a labelled stack on phones —
        // no sideways scroll, content before metadata (provenance rides the
        // cell FOOT, not its head).
        return (() => {
          const aPrem = block.a.rows.filter((r) => r.provenance !== 'conclusion');
          const bPrem = block.b.rows.filter((r) => r.provenance !== 'conclusion');
          const aConc = block.a.rows.find((r) => r.provenance === 'conclusion');
          const bConc = block.b.rows.find((r) => r.provenance === 'conclusion');
          {/* Pairing by index; rows whose crux labels differ are different
             claims — each gets its own row with an explicit gap opposite. */}
          const pairs = [];
          for (let ri = 0; ri < Math.max(aPrem.length, bPrem.length); ri++) {
            const a = aPrem[ri];
            const b = bPrem[ri];
            if (a && b && a.crux && b.crux && a.crux !== b.crux) {
              pairs.push({ a, b: undefined, crux: a.crux });
              pairs.push({ a: undefined, b, crux: b.crux });
            } else {
              pairs.push({ a, b, crux: a?.crux ?? b?.crux });
            }
          }
          {/* The paragraphs authored inside ::diverge pair with the rows 1:1
             by order — the i-th paragraph explains the i-th crux. This is
             the prose that used to live behind the closed tab. */}
          const rowProse = block.prose.filter((p) => p.type === 'prose');
          const cap = (s) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : '');
          const sideName = (l) => l.replace(/^From\s+/i, '');
          {/* One premise cell: the claim first; provenance + side in one mono
             foot line, so stacked mobile cells stay labelled without a
             colour-only channel. ★ supplied keeps its glyph. */}
          const cell = (r, side, colour) => r ? (
            <div class="pl-3 py-1 border-l-2" style={`border-color:${colour}`}>
              <p class="font-serif text-[15px] text-ink leading-snug">{r.text}</p>
              <p class="mt-1 font-mono text-[13px] uppercase tracking-[0.08em] text-muted">
                {r.provenance === 'supplied' ? <span class="text-accent-support">★ supplied</span> : r.provenance}{' · '}{side}
              </p>
            </div>
          ) : (
            <div class="pl-3 py-1 border-l-2 border-hairline font-serif text-[13px] text-muted italic">no premise on this side</div>
          );
          return (
            <section id="diverge" class="scroll-mt-24">
              <hr class="border-0 border-t border-ink-strong mb-4" />
              <h2 class="font-serif text-[26px] text-ink-strong mb-1 leading-tight">{block.label}</h2>
              {/* Apparatus note stays behind the "?" — it teaches the one
                 genuinely unfamiliar convention (quoted/stated/supplied). */}
              {block.house && (
                <details class="mb-2">
                  <summary class="inline-flex items-center gap-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden font-mono text-[13px] uppercase tracking-[0.08em] text-muted hover:text-ink">
                    How to read this <span class="inline-flex items-center justify-center w-5 h-5 border border-hairline rounded-full text-[13px] normal-case" aria-hidden="true">?</span>
                  </summary>
                  <p class="font-serif text-[15px] text-muted mt-1.5 max-w-xl">{block.house}</p>
                </details>
              )}
              {/* The two reports, named once. Text label is the primary
                 channel; the stance hue is redundant on top of it. */}
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1.5 mt-3 mb-2">
                {[block.a, block.b].map((col, ci) => (
                  <div class="border-b pb-1.5" style={`border-color:${ci === 0 ? '#345D7E' : '#8C4A2F'}`}>
                    <span class="font-mono text-[13px] font-semibold uppercase tracking-[0.08em]" style={`color:${ci === 0 ? '#345D7E' : '#8C4A2F'}`}>{col.label}</span>
                    {col.interest && <span class="block font-serif text-[13px] text-muted leading-snug mt-0.5">{col.interest}</span>}
                  </div>
                ))}
              </div>
              {pairs.map((p, pi) => (
                <div class="border-t border-hairline first:border-t-0 pt-3 pb-2.5">
                  <h3 class="font-serif text-[20px] font-semibold text-ink-strong leading-snug mb-1"><span class="font-mono text-[13px] font-normal text-muted mr-1.5 tabular-nums">{pi + 1}</span>{cap(p.crux)}</h3>
                  {rowProse[pi] && rowProse[pi].type === 'prose' && (
                    <p class="font-serif text-[15px] text-ink leading-relaxed mb-2.5 max-w-[34rem]">{rowProse[pi].text}</p>
                  )}
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2">
                    {cell(p.a, sideName(block.a.label), '#345D7E')}
                    {cell(p.b, sideName(block.b.label), '#8C4A2F')}
                  </div>
                </div>
              ))}
              {/* Where each report lands. */}
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 border-t border-ink-strong/40 pt-3">
                {[{ c: aConc, col: block.a, hue: '#345D7E' }, { c: bConc, col: block.b, hue: '#8C4A2F' }].map(({ c, col, hue }) => c && (
                  <div class="pl-3 border-l-2" style={`border-color:${hue}`}>
                    <div class="flex gap-2.5 text-[15px] font-medium text-ink-strong leading-snug"><span class="font-mono shrink-0">∴</span><span>{c.text}</span></div>
                    <p class="mt-1 font-mono text-[13px] uppercase tracking-[0.08em] text-muted">conclusion · {sideName(col.label)}</p>
                  </div>
                ))}
              </div>
              {block.sharedNeed && (
                <div class="mt-4 border border-accent-support/40 bg-surface px-3.5 py-2.5 font-serif text-[15px] text-ink leading-snug">
                  <span class="font-mono text-[13px] font-semibold uppercase tracking-[0.08em] text-accent-support mr-2">★ supplied · both arguments need</span>
                  {block.sharedNeed}
                </div>
              )}
            </section>
          );
        })();
      }
      if (block.type === 'skeleton') {
        // Rendered in the page margin on desktop and above the essay on
        // mobile by /briefing/[slug].astro — never inline here.
        return null;
      }
      if (block.type === 'prose') {
        // An explainer's first paragraph is its dek: lede-sized, like the
        // landscape opening on a briefing.
        if (isExplainer && idx === firstProseIdx) {
          return <p class="font-serif text-[20px] text-ink leading-relaxed">{block.text}</p>;
        }
        if (isOpinion) {
          return <p class="font-serif text-[17px] text-ink leading-[1.8]">{block.text}</p>;
        }
        return <p class="font-serif text-[17px] text-ink leading-[1.75]">{block.text}</p>;
      }
      if (block.type === 'position') {
        // Stance pole (drafting blue / oxide rust / grey) for migrated briefings;
        // legacy rainbow only if the source isn't a v2 position.
        const st = stanceById.get(block.sourceId);
        const rule = st !== undefined ? stanceCol(st) : COLOURS[((block.colourIndex % COLOURS.length) + COLOURS.length) % COLOURS.length].rule;
        const kindStyle = KIND_STYLE[block.audit.kind] ?? KIND_STYLE.structural;
        return (
          <div id={`pos-${block.sourceId}`} class="scroll-mt-24">
            {/* One overarching commentary section (Daniel, 2026-08-09): a
               single rank-1 chapter holding both depths, each declared by a
               rank-2 heading that says what it is and why — the concrete-
               labels rule applied to the structure question ("what is the
               difference between these and the commentary?"). */}
            {idx === firstPositionIdx && (
              <div id="commentary" class="scroll-mt-24">
                <hr class="border-0 border-t border-ink-strong mb-4" />
                <h2 class="font-serif text-[26px] text-ink-strong mb-4 leading-tight">The commentary</h2>
                <h3 id="positions" class="font-serif text-[17px] font-semibold text-ink-strong leading-snug border-t border-hairline pt-2.5 mb-4 scroll-mt-24">Three positions, audited in full</h3>
              </div>
            )}
            {/* The turn before a full position block — same register as the
               commentary-card bridges: ONE mechanism for the editor's
               connective voice everywhere (Decision 17-B). */}
            {(() => {
              const src = posSourceById.get(block.sourceId);
              return src?.bridge && (
                <div class="mb-4">
                  <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-0.5">The turn</span>
                  <p class="font-serif text-[17px] text-ink leading-relaxed">{src.bridge}</p>
                </div>
              );
            })()}
            <div class="pl-4" style={`border-left:4px solid ${rule}`}>
              {/* 24-B (Daniel, 2026-08-09): the CLAIM leads at deck size and
                 the name demotes to a byline row beneath it. A reader
                 skimming the section now reads the page's argument as three
                 claims, not three names. */}
              {block.label && (
                <span class="block font-serif text-[20px] font-semibold text-ink-strong leading-[1.3] mb-1">{block.label}</span>
              )}
              {(() => {
                const src = posSourceById.get(block.sourceId);
                if (!src) return null;
                return (
                  <div class="flex items-baseline gap-x-2.5 gap-y-1 flex-wrap border-b border-hairline pb-1.5 mb-1.5">
                    <span class="font-serif text-[15px] font-semibold text-ink-strong leading-snug">{src.label}</span>
                    {src.publication && <span class="font-serif text-[15px] text-muted">{src.publication}</span>}
                    {pinBySource.has(src.id) && <a href="#diverge" class="font-mono text-[13px] uppercase tracking-[0.08em] text-accent-support hover:underline">contests {pinBySource.get(src.id).at} ↑</a>}
                    <span class="ml-auto inline-flex items-center gap-1.5" title={`Position: ${poleLabel(src.stance)}`}>
                      <span class="inline-flex items-end gap-[3px] h-[11px]" aria-hidden="true">
                        {STANCE_STEPS.map((v) => (
                          <span class={v === src.stance ? 'w-[3px] h-[11px]' : 'w-[3px] h-[5px] bg-hairline'} style={v === src.stance ? `background:${rule}` : undefined}></span>
                        ))}
                      </span>
                      <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted">{poleLabel(src.stance)}</span>
                    </span>
                  </div>
                );
              })()}
              {/* Interest disclosure (cui-bono) — moves from the mini-table
                 into the position body itself, next to the source label,
                 where it disambiguates the voice speaking. */}
              {(() => {
                const src = posSourceById.get(block.sourceId);
                return src?.interest && (
                  <p class="text-[13px] leading-snug text-muted mb-2.5">
                    <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-[#8C4A2F] mr-1.5">Stake</span>
                    {src.interest}
                  </p>
                );
              })()}
              {/* Position bodies live at the 15px box register (24-A folded
                 into 24-B): the field cards already do, and the wall complaint
                 was three 17px paragraph runs in a row. The pull quote keeps
                 deck size so the scan spine stays claim → quote. */}
              {(() => {
                const { before, pull, after } = splitOnQuote(block.paragraph, block.quote);
                return (
                  <>
                    {before && <p class="font-serif text-[15px] text-ink leading-[1.65]">{before}</p>}
                    {/* Pull quote: type carries it, not a second rule (the block
                       already has the stance rule two levels out). */}
                    {pull && (
                      <blockquote class={`font-serif text-[20px] italic text-ink-strong leading-snug ${before ? 'mt-2.5' : ''}`}>
                        “{pull}”
                      </blockquote>
                    )}
                    {after && <p class="font-serif text-[15px] text-ink leading-[1.65] mt-2.5">{after}</p>}
                  </>
                );
              })()}
              {/* Merged former ::takes atom: a representative quote from the
                 source with a one-line audit. Only renders when authored on
                 the source (positions.quote / auditNote). Layout mirrors the
                 old take (serif quote + rule + audit) so nothing is lost. */}
              {(() => {
                const src = posSourceById.get(block.sourceId);
                if (!src?.quote) return null;
                const kindStyleSrc = KIND_STYLE[src.auditKind ?? 'interpretive'] ?? KIND_STYLE.interpretive;
                return (
                  <div class="mt-4 pt-3 border-t border-hairline/60">
                    <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-1.5 block">Their own words</span>
                    <blockquote class="font-serif text-[17px] italic text-ink-strong leading-snug mb-2">“{src.quote}”</blockquote>
                    {src.auditNote && (
                      <p class="font-serif text-[15px] text-ink leading-snug pl-3 border-l-2 border-hairline">
                        <span class={`inline-block mr-2 font-mono text-[13px] font-semibold uppercase tracking-[0.08em] px-1.5 py-0.5 border ${kindStyleSrc}`}>{KIND_LABEL[src.auditKind ?? 'interpretive']}</span>
                        {src.auditNote}
                      </p>
                    )}
                  </div>
                );
              })()}
            </div>
            {block.structure && (
              /* "The argument, numbered" — reveal-after-reading disclosure,
                 below the prose so it reads as an answer key, not a diagram
                 competing with the paragraph (avoids the split-attention /
                 redundancy traps). Static <details>, zero JS. NO strength
                 score: the "need" line says what the step requires, and the
                 supports/asserts pair is the overclaim gap, not a rating. */
              <details class="audit-disclosure mt-3 bg-surface border border-hairline">
                <div class="instrument-rule"></div>
                <summary class="flex items-center gap-2.5 px-3.5 py-2.5 cursor-pointer">
                  <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted shrink-0">The argument, numbered</span>
                  <svg class="audit-chevron ml-auto shrink-0 w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-3.5 pb-3.5">
                  <dl class="text-[15px] leading-snug">
                    {block.structure.rows.map((r) => (
                      <div class={`grid grid-cols-[1.4rem_1fr] gap-2.5 py-1.5 ${r.provenance === 'conclusion' ? 'border-t border-ink-strong/40 mt-1 pt-2.5' : 'border-t border-hairline first:border-t-0'}`}>
                        <dt class={`font-mono text-[13px] tabular-nums ${r.provenance === 'conclusion' ? 'text-ink-strong font-semibold' : 'text-muted'}`}>{r.provenance === 'conclusion' ? '∴' : r.id}</dt>
                        <dd class={r.provenance === 'conclusion' ? 'text-ink-strong font-medium' : 'text-ink'}>
                          <span>{r.text}</span>
                          {r.provenance === 'supplied' && (
                            <span class="ml-1.5 font-mono text-[13px] uppercase tracking-[0.08em] text-accent-support align-baseline" title="Not stated by the source — supplied by this audit">★ supplied</span>
                          )}
                          {r.provenance === 'stated' && (
                            <span class="ml-1.5 font-mono text-[13px] uppercase tracking-[0.08em] text-muted align-baseline">stated</span>
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                  {block.structure.need && (
                    <div class="mt-3 pl-3 border-l-2 border-accent-support">
                      <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-1">What the step needs</span>
                      <p class="font-serif text-[15px] text-ink leading-relaxed">{block.structure.need}</p>
                    </div>
                  )}
                  {block.structure.supports && block.structure.asserts && (
                    <div class="mt-3 grid grid-cols-[6rem_1fr] gap-x-3 gap-y-1.5 font-serif text-[15px]">
                      <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted pt-0.5">Supports</span>
                      <span class="text-ink">{block.structure.supports}</span>
                      <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted pt-0.5">Asserts</span>
                      <span class="text-ink-strong font-medium">{block.structure.asserts}</span>
                      {/* The pair was undefined anywhere on the page — one
                         line says what the gap between them means. */}
                      <p class="col-span-2 font-serif text-[13px] text-muted leading-snug">The distance between the two is the overclaim: the part asserted but not supported.</p>
                    </div>
                  )}
                </div>
              </details>
            )}
            {block.audit.name && (
              <details class="audit-disclosure mt-3 bg-surface border border-hairline" open={idx === firstPositionIdx}>
                <div class="instrument-rule"></div>
                <summary class="flex items-center gap-2.5 px-3.5 py-2.5 cursor-pointer">
                  <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted shrink-0">Audit</span>
                  <span class="font-serif text-[17px] font-semibold text-ink-strong">{block.audit.name}</span>
                  <span class={`font-mono text-[13px] font-semibold uppercase tracking-[0.08em] px-1.5 py-0.5 border shrink-0 ${kindStyle}`}>{KIND_LABEL[block.audit.kind] ?? block.audit.kind}</span>
                  <svg class="audit-chevron ml-auto shrink-0 w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                {/* The audit body matches the position paragraph's size (17px):
                   the per-claim audit is the differentiator, it must not read
                   as a footnote to the text it audits. The per-card watermark
                   line was in-page noise (8.5px) and now lives only on share
                   exports. The deep-link is a chip, not a footnote link. */}
                <div class="px-3.5 pb-3.5">
                  <p class="text-[17px] text-ink leading-relaxed mb-2.5">{block.audit.explanation}</p>
                  {/* One audit deep-link per card; the fallibility line moved
                     to a single instance at the article's foot (Decision 21). */}
                  <div class="flex items-center flex-wrap gap-x-3 gap-y-2">
                    <a href={`/audit?audit=${briefing.slug}&pos=${encodeURIComponent(block.sourceId)}`} class="inline-flex items-center gap-1.5 text-[13px] font-medium text-accent-support hover:text-accent hover:border-accent-support/50 border border-hairline rounded px-3 py-2 transition-colors">Audit this argument →</a>
                  </div>
                </div>
              </details>
            )}
            {/* The field — the map and the shorter audited voices — renders
               once, after the LAST position: the second depth of the one
               commentary section, declared as such by its rank-2 heading. */}
            {idx === lastPositionIdx && (
              <div id="field" class="mt-8 scroll-mt-24">
                <h3 class="font-serif text-[17px] font-semibold text-ink-strong leading-snug border-t border-hairline pt-2.5 mb-4">The wider field, one audited line each</h3>
                <div class="mb-4">
                  {v2
                    ? <BandedSpectrum positions={posSrc} axis={briefing.spectrumAxis} />
                    : <PopulatedSpectrum sources={briefing.sources} axis={briefing.spectrumAxis} />}
                </div>
                {inlineCommentary.length > 0 && (
                  <div class="grid gap-4">
                    {inlineCommentary.map((s) => {
                      const rule = stanceCol(s.stance);
                      const kindStyleIC = KIND_STYLE[s.auditKind ?? 'interpretive'] ?? KIND_STYLE.interpretive;
                      return (
                        <>
                        {/* The turn (17-B): the editor's connective sentence
                           rides the 11th ::positions column, full body
                           register — the editor is the guide, not marginalia. */}
                        {s.bridge && (
                          <div class="mt-1.5">
                            <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-0.5">The turn</span>
                            <p class="font-serif text-[17px] text-ink leading-relaxed">{s.bridge}</p>
                          </div>
                        )}
                        {/* S1 row anatomy (Decision 4, 2026-08-05): fixed slots
                           learned once — name · outlet · position, hairline,
                           interest, quote, audit. The stance rail is 4px, and
                           position is NEVER colour-only: a tick on a five-step
                           rule plus a text pole label carry it chromatically-
                           blind (Ground News fixed-row-anatomy pattern). */}
                        <div id={`pos-${s.id}`} class="scroll-mt-24 pl-3.5 py-1.5" style={`border-left:4px solid ${rule}`}>
                          <div class="flex items-baseline gap-x-2.5 gap-y-1 flex-wrap border-b border-hairline pb-1.5 mb-1.5">
                            <span class="font-serif text-[20px] font-semibold text-ink-strong leading-snug">{s.label}</span>
                            {s.publication && <span class="font-serif text-[15px] text-muted">{s.publication}</span>}
                            {pinBySource.has(s.id) && <a href="#diverge" class="font-mono text-[13px] uppercase tracking-[0.08em] text-accent-support hover:underline">contests {pinBySource.get(s.id).at} ↑</a>}
                            <span class="ml-auto inline-flex items-center gap-1.5" title={`Position: ${poleLabel(s.stance)}`}>
                              <span class="inline-flex items-end gap-[3px] h-[11px]" aria-hidden="true">
                                {STANCE_STEPS.map((v) => (
                                  <span class={v === s.stance ? 'w-[3px] h-[11px]' : 'w-[3px] h-[5px] bg-hairline'} style={v === s.stance ? `background:${rule}` : undefined}></span>
                                ))}
                              </span>
                              <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted">{poleLabel(s.stance)}</span>
                            </span>
                          </div>
                          {s.interest && <p class="font-serif text-[13px] text-muted leading-snug mb-1"><span class="font-mono text-[13px] uppercase tracking-[0.08em] text-[#8C4A2F] mr-1">Stake</span>{s.interest}</p>}
                          <blockquote class="font-serif text-[17px] italic text-ink-strong leading-snug mb-1.5">“{s.quote}”</blockquote>
                          <p class="font-serif text-[15px] text-ink leading-snug pl-3 border-l-2 border-hairline">
                            <span class={`inline-block mr-2 font-mono text-[13px] font-semibold uppercase tracking-[0.08em] px-1.5 py-0.5 border ${kindStyleIC}`}>{KIND_LABEL[s.auditKind ?? 'interpretive']}</span>
                            {s.auditNote}
                          </p>
                        </div>
                        </>
                      );
                    })}
                  </div>
                )}
              </div>
            )}
          </div>
        );
      }
      if (block.type === 'shared') {
        // Folded into the context box above when one exists; standalone otherwise.
        if (foldShared) return null;
        return (
          <div id="shared" class="pl-4 scroll-mt-24 border-l-2 border-accent-support">
            <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-accent-support mb-1.5">The shared assumption</span>
            <p class="font-serif text-[17px] text-ink leading-relaxed">{block.text}</p>
          </div>
        );
      }
      if (block.type === 'public') {
        // "The public" (Decisions 8 C-1 + 9 P-A2, 2026-08-06): three storeys
        // above the editor's view — what polls find, where you land, join the
        // conversation. Static, zero JS; the dial renders disabled until its
        // counter endpoint ships. Only verified figures may be authored in.
        const vals = block.ticks.map((t) => t.value);
        const lo = vals.length ? Math.min(...vals) : 0;
        const hi = vals.length ? Math.max(...vals) : 0;
        const axLo = Math.max(0, Math.floor((lo - 4) / 5) * 5);
        const axHi = Math.min(100, Math.ceil((hi + 4) / 5) * 5);
        const posPct = (v) => ((v - axLo) / Math.max(1, axHi - axLo)) * 100;
        const spread = hi - lo;
        const stripNote = (block.stripNote ?? '').replace('{spread}', String(spread));
        return (
          <section id="public" class="scroll-mt-24">
            <hr class="border-0 border-t border-ink-strong mb-4" />
            <h2 class="font-serif text-[26px] text-ink-strong mb-4 leading-tight">{block.label}</h2>

            {/* V1 (Daniel, 2026-08-06): each storey is its own card in the
               context-box grammar with a numbered kicker. Poll rows are cut
               to question + result; the caveat and source open on click
               (each row is a native disclosure). */}

            {/* Storey 1 — what polls find */}
            {(block.ticks.length > 0 || block.questions.length > 0) && (
              <div class="mb-4 border border-hairline bg-surface">
                <div class="instrument-rule"></div>
                <div class="px-4 py-3.5">
                  <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-2">1 · What polls find</span>
                  {block.stripCaption && <p class="font-serif text-[15px] text-ink leading-snug mb-1.5">{block.stripCaption}</p>}
                  {block.ticks.length > 0 && (
                    <>
                      <div class="relative h-11 mx-1" role="img" aria-label={`Support for nuclear by poll: ${block.ticks.map((t) => `${t.value}% ${t.label}`).join('; ')}`}>
                        <div class="absolute left-0 right-0 top-6 border-t-[1.5px] border-ink"></div>
                        <span class="absolute left-0 top-7 font-mono text-[13px] text-muted">{axLo}% support</span>
                        <span class="absolute right-0 top-7 font-mono text-[13px] text-muted">{axHi}% support</span>
                        {/* The highest figure is marked on THREE channels — a
                           taller, wider tick and a semibold numeral alongside
                           the hue — so the emphasis survives colourblind eyes
                           (the redline alone does not: same L* as the greys). */}
                        {block.ticks.map((t) => (
                          <>
                            <span class={t.value === hi ? 'absolute w-[3px] bg-accent' : 'absolute w-[2px] bg-ink-strong'} style={t.value === hi ? `left:${posPct(t.value)}%; top:0.8rem; height:1.2rem` : `left:${posPct(t.value)}%; top:1.05rem; height:0.95rem`}></span>
                            <span class={t.value === hi ? 'absolute font-mono text-[13px] font-semibold text-accent whitespace-nowrap' : 'absolute font-mono text-[13px] text-muted whitespace-nowrap'} style={`left:${posPct(t.value)}%; top:0.05rem; transform:translateX(-50%)`}>{t.value}</span>
                          </>
                        ))}
                      </div>
                      <p class="font-mono text-[13px] text-muted leading-snug mt-1">{block.ticks.map((t) => `${t.value} ${t.label}`).join(' · ')}</p>
                      {stripNote && <p class="font-serif text-[15px] text-ink leading-snug mt-1.5">{stripNote}</p>}
                    </>
                  )}
                  {/* Poll bars (Decision 18-B visual, 18-C ordering): each
                     answer is a proportional segment; sided answers wear the
                     axis colour AND sit on that side of the bar, so hue,
                     position, and the values line all carry the mapping.
                     Unmapped polls render neutral grey. Numbers ride inside
                     segments wide enough to hold them; the values line below
                     repeats every figure in the same order. */}
                  {block.questions.length > 0 && (
                    <div class="border-t border-hairline mt-3 pt-2.5">
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="font-mono text-[13px] uppercase tracking-[0.08em]" style="color:#345D7E">← reads for {briefing.spectrumAxis.left}</span>
                        <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-right" style="color:#8C4A2F">reads for {briefing.spectrumAxis.right} →</span>
                      </div>
                      <p class="font-serif text-[13px] text-muted leading-snug mt-0.5 mb-1">Answers that favour one pathway sit on that side of their bar, in that side's colour. Grey answers favour neither.</p>
                      {block.questions.map((q) => {
                        const total = q.bars.reduce((s, b) => s + b.value, 0);
                        const rest = Math.max(0, 100 - total);
                        const segCol = (b) => b.side === 'left' ? '#345D7E' : b.side === 'right' ? '#8C4A2F' : '#6E7370';
                        return (
                          <details class="border-b border-hairline/60 last:border-b-0">
                            <summary class="py-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                              <span class="flex justify-between items-baseline gap-x-4">
                                <span class="font-serif italic text-[15px] text-ink-strong leading-snug">{q.question}</span>
                                <span class="inline-flex items-center justify-center w-5 h-5 border border-hairline rounded-full font-mono text-[13px] text-muted shrink-0" aria-hidden="true">?</span>
                              </span>
                              <span class="flex h-5 mt-1.5 border border-hairline" role="img" aria-label={`${q.question} ${q.bars.map((b) => `${b.label} ${b.value}%`).join(', ')}${rest > 0 ? `, other or unsure ${rest}%` : ''}`}>
                                {q.bars.map((b) => (
                                  <span class="inline-flex items-center justify-center overflow-hidden" style={`width:${b.value}%;background:${segCol(b)}`}>
                                    {b.value >= 8 && <b class="font-mono text-[13px] text-white tabular-nums">{b.value}</b>}
                                  </span>
                                ))}
                                {rest > 0 && <span style={`width:${rest}%`} class="bg-paper"></span>}
                              </span>
                              <span class="block text-[13px] text-ink leading-snug mt-1">
                                {q.bars.map((b, bi) => (
                                  <>{bi > 0 && <span class="text-muted">{' · '}</span>}{b.label}{' '}<b class="tabular-nums">{b.value}</b></>
                                ))}
                                {rest > 0 && <span class="text-muted">{' · '}other or unsure{' '}<span class="tabular-nums">{rest}</span></span>}
                              </span>
                            </summary>
                            <p class="font-serif text-[13px] text-muted leading-snug pb-2"><span class="font-mono text-[13px] uppercase tracking-[0.08em] mr-1.5">{q.source}</span>{q.note}</p>
                          </details>
                        );
                      })}
                    </div>
                  )}
                  {block.gapNote && <p class="font-serif text-[13px] text-muted leading-snug border-t border-hairline pt-2 mt-2">{block.gapNote}</p>}
                </div>
              </div>
            )}

            {/* Storey 2 — Your turn (Decision 19-B: the dial and the
               conversation merged; the dial is the ask, the invitation box
               and premise links are the follow-up for readers with more to
               say). The dial stays inert until its counter endpoint ships —
               with ONE line saying when results appear, not three apologies. */}
            {(block.dialQuestion || (block.prompts && block.prompts.length > 0)) && (
              <div class="border border-hairline bg-surface">
                <div class="instrument-rule"></div>
                <div class="px-4 py-3.5">
                  <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-2">2 · Your turn</span>
                  {block.dialQuestion && (
                    <>
                      <p class="font-serif text-[15px] text-ink leading-snug mb-2.5">{block.dialQuestion}</p>
                      {/* LIVE dial: a zero-JS POST form. Each step is a submit
                         button; /api/briefing-dial counts the tap and 303s
                         back to #dial-thanks, whose :target style shows the
                         confirmation — no script anywhere in the article. */}
                      <form method="post" action="/api/briefing-dial" class="flex items-center gap-2 flex-wrap">
                        <input type="hidden" name="slug" value={briefing.slug} />
                        <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-right leading-tight" style="color:#345D7E">{briefing.spectrumAxis.left}</span>
                        <span class="inline-flex gap-1.5">
                          {STANCE_STEPS.map((v) => (
                            <button type="submit" name="step" value={String(v)} aria-label={`Answer: ${poleLabel(v)}`} class="w-10 h-8 border font-mono text-[13px] tabular-nums bg-paper hover:bg-surface cursor-pointer transition-colors" style={`border-color:${stanceCol(v)}; color:${stanceCol(v)}; border-width:${Math.abs(v) === 2 ? '1.5px' : '1px'}`}>{v > 0 ? `+${v}` : v}</button>
                          ))}
                        </span>
                        <span class="font-mono text-[13px] uppercase tracking-[0.08em] leading-tight" style="color:#8C4A2F">{briefing.spectrumAxis.right}</span>
                      </form>
                      <p id="dial-thanks" class="hidden target:block scroll-mt-40 font-serif text-[13px] text-ink leading-snug mt-2 border-l-2 border-accent-support pl-2">Counted. Results appear once fifty readers have answered.</p>
                      <p class="font-serif text-[13px] text-muted leading-snug mt-2">One anonymous tap. Results appear once fifty readers have answered.</p>
                    </>
                  )}
                  {/* The invitation box: a zero-JS GET form into the audit.
                     The reader's take rides ?text= (the audit page already
                     honours it); the premise links carry an authored
                     scaffold the same way. Fifty-character floor matches
                     the audit page's shared-text threshold. */}
                  {block.prompts && block.prompts.length > 0 && (
                    <form method="get" action="/audit" class={block.dialQuestion ? 'mt-3 pt-3 border-t border-hairline' : ''}>
                      <p class="font-serif text-[15px] text-ink leading-snug mb-2">Or make the case yourself. It runs through the audit before it runs anywhere.</p>
                      <div class="flex gap-1.5">
                        <input name="text" type="text" required minlength="50" placeholder="Contest a premise, or argue your own…" class="flex-1 min-w-0 bg-paper border border-hairline px-2.5 py-2 text-[13px] text-ink placeholder:text-muted/70 focus:outline-none focus:ring-1 focus:ring-accent-support/50" />
                        <button type="submit" class="px-3 py-2 bg-accent-support text-paper text-[13px] font-medium hover:bg-accent-support/90 transition-colors shrink-0">Audit it →</button>
                      </div>
                      <p class="font-serif text-[13px] text-muted leading-snug mt-2">Start from a premise:{' '}
                        {block.prompts.map((pr, pi) => (
                          <>{pi > 0 && <span>{' · '}</span>}<a href={`/audit?text=${encodeURIComponent(pr.prefill ?? pr.label)}`} class="text-accent-support hover:underline">{pr.label}</a></>
                        ))}
                      </p>
                    </form>
                  )}
                </div>
              </div>
            )}
          </section>
        );
      }
      if (block.type === 'editorView') {
        // Decision 20-B (2026-08-08): a real section, not a grey box. Square
        // like everything else, the same rule + serif h2 as its peers (the
        // rail promised them as equals; the type finally agrees), a plain
        // provenance line where two competing mono labels used to sit, and
        // body at reading size. Devil's advocate stays inside as a normal
        // serif heading (Daniel, 2026-08-05) — the editor arguing against
        // the view just given. Future: community takes, editor-steelmanned,
        // organised by philosophical framework.
        return (
          <section id="discussion" class="scroll-mt-24">
            <hr class="border-0 border-t border-ink-strong mb-4" />
            <h2 class="font-serif text-[26px] text-ink-strong mb-1 leading-tight">The editor's view</h2>
            <p class="font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-3">written by hand · no engine text</p>
            <p class="font-serif text-[17px] text-ink leading-[1.75]">{block.text}</p>
            {block.whyWrong && (
              <div class="mt-4 pt-3 border-t border-hairline">
                <h3 class="font-serif text-[17px] font-semibold text-ink-strong mb-1.5 leading-snug">Devil's advocate</h3>
                <p class="font-serif text-[17px] text-ink leading-[1.75]">{block.whyWrong}</p>
              </div>
            )}
          </section>
        );
      }
      if (block.type === 'takes') {
        return (
          <div>
            <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-2.5">Other takes · audited</span>
            <div class="space-y-2.5">
              {block.items.map((t) => (
                <div class="border border-hairline bg-surface p-3">
                  <p class="font-serif text-[17px] italic text-ink leading-snug">“{t.quote}”</p>
                  <p class="font-serif text-[13px] text-muted mt-1.5">
                    {t.url
                      ? <a href={t.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">{t.source}</a>
                      : t.source}
                  </p>
                  <p class="font-serif text-[15px] text-muted mt-2 pl-2.5 leading-relaxed border-l-2 border-accent-support"><span class="font-medium text-ink">Audit:</span> {t.audit}</p>
                </div>
              ))}
            </div>
          </div>
        );
      }
      return null;
    })}
  </div>

  {/* The single fallibility line (Decision 21: it appeared on every audit
     card; a publication should invite scrutiny once, at the exit). */}
  {!isExplainer && (v2 || briefing.sources.length > 0) && (
    <p class="mt-8 font-serif text-[13px] text-muted">Does a reading here seem wrong? <a href="/feedback" class="text-accent-support hover:underline">Tell the editor →</a></p>
  )}

  {/* Other-takes absence stated (D2 policy) — but only if there IS no
     commentary tier absorbing them. Since the 2026-07-21 takes-merge, a
     briefing with commentary positions already displays every take as an
     inline commentary card, so this note only fires when there are ALSO no
     commentary sources. */}
  {!isExplainer && !hasTakes && briefing.otherTakes === 'none' && posSrc.length === 0 && (
    <div class="mt-8">
      <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-1.5">Other takes</span>
      <p class="font-serif text-[15px] text-muted italic">No further takes surveyed for this question.</p>
    </div>
  )}

  {/* ONE Sources section (a single bibliography, not two competing ones):
     the plotted positions first, then the evidence the argument cites. */}
  {/* Sources at rank 1 (23-A): the rail lists it as a peer of the chapter
     heads, so it gets the same rule + serif h2 — not a box label. */}
  {!isExplainer && (v2 || briefing.sources.length > 0) && (
    <div id="sources" class="mt-10 scroll-mt-24">
      <hr class="border-0 border-t border-ink-strong mb-4" />
      <h2 class="font-serif text-[26px] text-ink-strong mb-4 leading-tight">Sources</h2>
      {v2 ? (
        <div class="space-y-6">
          <div>
            <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted/80 mb-2">Positions · {posSrc.length}</span>
            <ul class="space-y-1.5">
              {posSrc.map((s) => (
                <li class="flex items-baseline gap-2">
                  <span class="shrink-0 font-mono text-[13px] font-semibold tabular-nums px-1.5 py-0.5 border" style={`color:${stanceCol(s.stance)};border-color:${stanceCol(s.stance)}55;`}>{s.stance > 0 ? `+${s.stance}` : s.stance}</span>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="font-serif text-[15px] text-ink hover:text-accent">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a>
                  <span class="font-serif text-[13px] text-muted">(placement: {s.confidence})</span>
                </li>
              ))}
            </ul>
          </div>
          {eviSrc.length > 0 && (
            <div>
              <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted/80 mb-2">Further evidence · {eviSrc.length}</span>
              <ul class="space-y-1.5">
                {eviSrc.map((s) => (
                  <li class="font-serif text-[15px] leading-relaxed">
                    <a href={s.url} target="_blank" rel="noopener noreferrer" class="font-medium text-ink hover:text-accent">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a>
                    {s.note && <span class="text-muted">: {s.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ) : (
        <div>
          <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted/80 mb-2">Positions · {briefing.sources.length}</span>
          <div class="grid sm:grid-cols-2 gap-5">
            <div class="border-l-2 border-spec-left pl-3">
              <span class="font-mono text-[13px] font-semibold uppercase tracking-[0.08em] text-spec-left">{briefing.spectrumAxis.left}</span>
              <ul class="mt-1.5 space-y-1">
                {leftSources.map((s) => (
                  <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="font-serif text-[15px] text-ink hover:text-accent">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a></li>
                ))}
              </ul>
            </div>
            <div class="border-l-2 border-spec-right pl-3">
              <span class="font-mono text-[13px] font-semibold uppercase tracking-[0.08em] text-spec-right">{briefing.spectrumAxis.right}</span>
              <ul class="mt-1.5 space-y-1">
                {rightSources.map((s) => (
                  <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="font-serif text-[15px] text-ink hover:text-accent">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )}
    </div>
  )}
</article>

<style>
  /* Collapsible per-claim audit (presentation C). Hide the native disclosure
     triangle; the chevron is our affordance and rotates when open. */
  .audit-disclosure > summary { list-style: none; }
  .audit-disclosure > summary::-webkit-details-marker { display: none; }
  .audit-chevron { transition: transform 0.15s ease; }
  .audit-disclosure[open] > summary .audit-chevron { transform: rotate(180deg); }

</style>
