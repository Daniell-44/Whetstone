---
import PopulatedSpectrum from './PopulatedSpectrum.astro';
import type { BriefingArticle } from '../../../functions/_lib/briefing/types';

interface Props { briefing: BriefingArticle }
const { briefing } = Astro.props;

// Must match the spectrum palette (PositionSpectrum / SPECTRUM_DOT).
const COLOURS = [
  { rule: '#185FA5', chipBg: '#E6F1FB', chipText: '#185FA5' },
  { rule: '#993C1D', chipBg: '#FAECE7', chipText: '#993C1D' },
  { rule: '#BA7517', chipBg: '#FAEEDA', chipText: '#854F0B' },
  { rule: '#1D9E75', chipBg: '#E1F5EE', chipText: '#0F6E56' },
  { rule: '#534AB7', chipBg: '#EEEDFE', chipText: '#3C3489' },
];
const KIND_LABEL: Record<string, string> = { structural: 'Logic', interpretive: 'Judgment call', empirical: 'Factual' };

const leftSources  = briefing.sources.filter((s) => s.side === 'left');
const rightSources = briefing.sources.filter((s) => s.side === 'right');
const isExplainer  = briefing.kind === 'explainer';
const fmtDate = new Date(briefing.publishedDate + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const firstPositionIdx = briefing.blocks.findIndex((b) => b.type === 'position');
---
<article class="max-w-2xl mx-auto">
  <span class="text-[10px] font-semibold uppercase tracking-[0.08em] text-indigo-600">{isExplainer ? 'Explainer' : 'Briefing'}{briefing.category ? ` · ${briefing.category}` : ''}</span>
  <h1 id="overview" class="font-serif text-3xl sm:text-4xl text-gray-900 leading-tight mt-2 mb-2 scroll-mt-24">{briefing.question}</h1>
  <p class="text-xs text-gray-400 mb-6 tabular-nums">{fmtDate}</p>

  {!isExplainer && (
    <>
      <div class="mb-4">
        <PopulatedSpectrum sources={briefing.sources} axis={briefing.spectrumAxis} />
      </div>
      <div class="border-b border-gray-100 mb-7"></div>
    </>
  )}

  <div class="space-y-5">
    {briefing.blocks.map((block, idx) => {
      if (block.type === 'landscape') {
        return (
          <div>
            <span class="block text-[9px] font-semibold uppercase tracking-[0.06em] text-gray-400 mb-1.5">The landscape</span>
            <p class="text-base text-gray-600 leading-relaxed">{block.text}</p>
          </div>
        );
      }
      if (block.type === 'prose') {
        return <p class="text-[15px] text-gray-600 leading-[1.75]">{block.text}</p>;
      }
      if (block.type === 'position') {
        const c = COLOURS[((block.colourIndex % COLOURS.length) + COLOURS.length) % COLOURS.length];
        return (
          <div id={idx === firstPositionIdx ? 'positions' : undefined} class="scroll-mt-24">
            <div class="pl-4" style={`border-left:3px solid ${c.rule}`}>
              <p class="text-[15px] text-gray-700 leading-[1.75]">{block.paragraph}</p>
            </div>
            {block.audit.name && (
              <div class="mt-3 rounded-md border border-gray-200 overflow-hidden bg-white">
                <div class="flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 border-b border-gray-100">
                  <span class="text-[9px] font-semibold uppercase tracking-[0.06em] text-gray-400">Audit · this claim</span>
                </div>
                <div class="flex">
                  <div class="w-1 shrink-0" style={`background:${c.rule}`}></div>
                  <div class="p-3">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                      <span class="text-sm font-medium text-gray-800">{block.audit.name}</span>
                      <span class="text-[10px] px-1.5 py-0.5 rounded" style={`background:${c.chipBg};color:${c.chipText}`}>{KIND_LABEL[block.audit.kind] ?? block.audit.kind}</span>
                    </div>
                    <p class="text-xs text-gray-600 leading-snug mb-2">{block.audit.explanation}</p>
                    <a href={`/?audit=${briefing.slug}`} class="inline-flex items-center gap-1 text-xs font-medium text-indigo-600 hover:text-indigo-800">Audit the full article →</a>
                  </div>
                </div>
              </div>
            )}
          </div>
        );
      }
      if (block.type === 'shared') {
        return (
          <div id="shared" class="pl-4 scroll-mt-24" style="border-left:2px solid #534AB7">
            <span class="block text-[9px] font-semibold uppercase tracking-[0.06em] text-indigo-500 mb-1.5">The shared assumption</span>
            <p class="text-base text-gray-600 leading-relaxed">{block.text}</p>
          </div>
        );
      }
      if (block.type === 'editorView') {
        return (
          <div id="discussion" class="rounded-md bg-gray-50 border border-gray-200 p-4 scroll-mt-24">
            <span class="block text-[9px] font-semibold uppercase tracking-[0.06em] text-gray-400 mb-1.5">Editor's view · opinion</span>
            <p class="text-[15px] text-gray-600 leading-relaxed">{block.text}</p>
            {block.whyWrong && (
              <p class="text-sm text-gray-400 mt-2"><span class="font-medium">Why this might be wrong:</span> {block.whyWrong}</p>
            )}
          </div>
        );
      }
      if (block.type === 'takes') {
        return (
          <div>
            <span class="block text-[9px] font-semibold uppercase tracking-[0.06em] text-gray-400 mb-2.5">Other takes · audited</span>
            <div class="space-y-2.5">
              {block.items.map((t) => (
                <div class="rounded-md border border-gray-200 bg-white p-3">
                  <p class="text-[15px] text-gray-700 leading-snug">“{t.quote}”</p>
                  <p class="text-[11px] text-gray-400 mt-1.5">
                    {t.url
                      ? <a href={t.url} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600">{t.source}</a>
                      : t.source}
                  </p>
                  <p class="text-xs text-gray-500 mt-2 pl-2.5" style="border-left:2px solid #534AB7"><span class="font-medium text-gray-600">Audit:</span> {t.audit}</p>
                </div>
              ))}
            </div>
          </div>
        );
      }
      return null;
    })}
  </div>

  {briefing.sources.length > 0 && (
  <div class="mt-10 pt-6 border-t border-gray-200">
    <span class="block text-[10px] font-semibold uppercase tracking-[0.06em] text-gray-400 mb-3">Deeper reading · {briefing.sources.length} sources</span>
    <div class="grid sm:grid-cols-2 gap-5">
      <div class="border-l-2 pl-3" style="border-color:#185FA5">
        <span class="text-[9px] font-semibold uppercase tracking-wide text-sky-700">{briefing.spectrumAxis.left}</span>
        <ul class="mt-1.5 space-y-1">
          {leftSources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="text-xs text-gray-600 hover:text-indigo-600">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a></li>
          ))}
        </ul>
      </div>
      <div class="border-l-2 pl-3" style="border-color:#993C1D">
        <span class="text-[9px] font-semibold uppercase tracking-wide text-orange-700">{briefing.spectrumAxis.right}</span>
        <ul class="mt-1.5 space-y-1">
          {rightSources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="text-xs text-gray-600 hover:text-indigo-600">{s.label}{s.publication ? ` · ${s.publication}` : ''}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  )}
</article>
