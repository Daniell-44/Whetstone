---
// THE CONTESTED FOOTING (Daniel picked geometry C, "the ledger", 2026-08-12).
//
// What the argument rests on, and what happened to each part when it was
// checked. It opens the diverge section: the reader gets the shape of the fight
// in about three seconds, then the detailed rows below give them the argument.
//
// ON COLOUR. An earlier render of this had no colour at all, on the reasoning
// that Daniel is colourblind. That was an over-correction and he called it out.
// The rule is that meaning must never rest on colour ALONE, not that colour is
// banned. So the two poles wear the house stance colours exactly as the diverge
// cells below them already do, and every one of them is labelled in words at
// the head of its column. The verdict is a word first and always. Strip every
// hue out of this component and it still reads correctly, which is the test.
//
// Derivation, all from authored content, no engine involvement:
//   UNSTATED  - either side's premise is marked `supplied`, meaning the argument
//               needs it and the report never says it. Also the shared premise.
//   CONTESTED - both sides state something and the two do not agree.
// HOLDS cannot arise inside ::diverge, because a premise both sides agree on is
// not a divergence and is authored into the context box instead. The renderer
// supports it so the component stays honest if the data ever carries one.
import type { BriefingBlock } from '../../../functions/_lib/briefing/types';

interface Props {
  block: Extract<BriefingBlock, { type: 'diverge' }>;
  axis: { left: string; right: string };
}
const { block, axis } = Astro.props;

const LEFT = '#345D7E';
const RIGHT = '#8C4A2F';

type Verdict = 'holds' | 'contested' | 'unstated';
interface Foot {
  crux: string;
  verdict: Verdict;
  a?: string;
  b?: string;
  note?: string;
}

const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : '');
// Long premise text is a paragraph in the rows below; here it is a glance.
const trim = (s: string | undefined, n = 84) =>
  !s ? undefined : s.length <= n ? s : s.slice(0, s.lastIndexOf(' ', n) > 0 ? s.lastIndexOf(' ', n) : n) + '…';

const aPrem = block.a.rows.filter((r) => r.provenance !== 'conclusion');
const bPrem = block.b.rows.filter((r) => r.provenance !== 'conclusion');

const feet: Foot[] = [];
for (let i = 0; i < Math.max(aPrem.length, bPrem.length); i++) {
  const a = aPrem[i];
  const b = bPrem[i];
  const crux = a?.crux ?? b?.crux;
  if (!crux) continue;
  const supplied = a?.provenance === 'supplied' || b?.provenance === 'supplied';
  feet.push({
    crux: cap(crux),
    verdict: supplied ? 'unstated' : 'contested',
    a: trim(a?.text),
    b: trim(b?.text),
    ...(supplied
      ? { note: a?.provenance === 'supplied' ? `Never stated by ${block.a.label.replace(/^From\s+/i, '')}.` : `Never stated by ${block.b.label.replace(/^From\s+/i, '')}.` }
      : {}),
  });
}
if (block.sharedNeed) {
  feet.push({
    crux: 'The frame itself',
    verdict: 'unstated',
    note: 'Neither argument makes this case.',
    a: trim(block.sharedNeed, 120),
  });
}

// Capped at four, and this cap is what stops the Footing being a second copy of
// the rows underneath it. Unstated premises lead, because a step the argument
// needs and nobody ever stated is the most interesting thing on the page and it
// is the one a reader scanning seven rows will miss. The rest stay below as the
// full record, and the count is named rather than silently dropped.
const FOOTING_MAX = 4;
const RANK: Record<Verdict, number> = { unstated: 0, contested: 1, holds: 2 };
const ordered = [...feet].sort((x, y) => RANK[x.verdict] - RANK[y.verdict]);
const shown = ordered.slice(0, FOOTING_MAX);
const rest = feet.length - shown.length;

const WORD: Record<Verdict, string> = { holds: 'Holds', contested: 'Contested', unstated: 'Unstated' };
const sideName = (l: string) => l.replace(/^From\s+/i, '');
---

{feet.length > 0 && (
  <div class="cf mb-6" data-plane="argument">
    <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-muted mb-2">
      What the argument rests on
    </span>
    {/* Deliberately does not say "none of them agreed". One of these is the
       shared premise, which both sides accept and neither argues for, and that
       is a different thing from a disagreement. */}
    <p class="font-serif text-[15px] text-muted leading-snug mb-3">
      {feet.length} load-bearing steps. The {shown.length} carrying the most weight are here, led by
      the ones nobody stated; the rest follow in full below.
    </p>

    <div class="border-t border-ink-strong">
      {shown.map((f) => (
        <div class="grid grid-cols-[5.5rem_1fr] gap-x-4 py-3 border-b border-hairline last:border-b-0">
          {/* The gauge. A picture of the verdict, and only ever a repeat of the
             word beneath it. Solid to the stop holds; short of it is contested;
             dashed was never laid down at all. */}
          <div>
            <span class="block h-[11px] flex items-center" aria-hidden="true">
              {f.verdict === 'holds' && <span class="block h-[2px] w-full bg-ink-strong"></span>}
              {f.verdict === 'contested' && (
                <>
                  <span class="block h-[2px] w-[60%] bg-ink-strong"></span>
                  <span class="block h-[2px] w-[40%] bg-hairline"></span>
                </>
              )}
              {f.verdict === 'unstated' && <span class="block w-full border-t-2 border-dashed border-ink-strong"></span>}
            </span>
            <span class="block font-mono text-[13px] uppercase tracking-[0.08em] text-ink-strong mt-1">
              {WORD[f.verdict]}
            </span>
          </div>

          <div>
            <span class="block font-serif text-[17px] font-semibold text-ink-strong leading-snug">{f.crux}</span>
            {f.note && <span class="block font-serif text-[13px] text-muted leading-snug mt-0.5">{f.note}</span>}
            {(f.a || f.b) && (
              <div class={f.b ? 'grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-1 mt-1.5' : 'mt-1.5'}>
                {f.a && (
                  <div class="pl-2.5 border-l-2" style={`border-color:${LEFT}`}>
                    {f.b && (
                      <span class="block font-mono text-[13px] uppercase tracking-[0.08em]" style={`color:${LEFT}`}>
                        {sideName(block.a.label)}
                      </span>
                    )}
                    <span class="block font-serif text-[15px] text-ink leading-snug">{f.a}</span>
                  </div>
                )}
                {f.b && (
                  <div class="pl-2.5 border-l-2" style={`border-color:${RIGHT}`}>
                    <span class="block font-mono text-[13px] uppercase tracking-[0.08em]" style={`color:${RIGHT}`}>
                      {sideName(block.b.label)}
                    </span>
                    <span class="block font-serif text-[15px] text-ink leading-snug">{f.b}</span>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    <p class="font-serif text-[13px] text-muted leading-snug mt-2">
      {rest > 0 && <>{rest} more {rest === 1 ? 'step' : 'steps'} below. </>}
      Every premise there carries where it came from: {axis.left} on the left, {axis.right} on the right.
    </p>
  </div>
)}
