---
// The v2 map (D2 Option A, 2026-07-07): only audited positions plot, on a
// signed five-band axis named per question. Marker width = placement
// confidence (rubric on /method). Evidence sources never plot — they render
// as a bibliography strip in the article, not here.
import type { BriefingPositionSource } from '../../../functions/_lib/briefing/types';

interface Props { positions: BriefingPositionSource[]; axis: { left: string; right: string } }
const { positions, axis } = Astro.props;

const PCT: Record<string, number> = { '-2': 10, '-1': 30, '0': 50, '1': 70, '2': 90 };
// Stance poles (The Instrument): drafting blue = axisLeft, oxide rust = axisRight.
const COL = (s: number) => (s < 0 ? '#345D7E' : s > 0 ? '#8C4A2F' : '#6E7370');
const W: Record<string, number>  = { high: 15, med: 30, low: 58 };
const OP: Record<string, number> = { high: 1, med: 0.8, low: 0.5 };

// Vertical offset when several positions share a band, so markers never overlap.
const seen: Record<string, number> = {};
const placed = positions.map((s, i) => {
  const k = String(s.stance);
  const within = seen[k] ?? 0;
  seen[k] = within + 1;
  return { s, n: i + 1, within };
});
const rows = Math.max(1, ...Object.values(seen));
const railTop = 18;
const height = railTop + 14 + rows * 20 + 16;
---
{positions.length > 0 && (
  <div>
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.08em] text-muted mb-1">The map · {positions.length} audited {positions.length === 1 ? 'position' : 'positions'}</p>
    <div class="relative" style={`height:${height}px;`}>
      {/* rail + band ticks — Instrument hairline, not the old Ink & Ledger beige */}
      <div class="absolute" style={`top:${railTop + 7}px;left:2%;right:2%;height:2px;background:var(--color-hairline);`}></div>
      {(['-2','-1','0','1','2'] as const).map((b) => (
        <div class="absolute" style={`left:${PCT[b]}%;top:${railTop + 2}px;width:1px;height:12px;background:var(--color-hairline);`}></div>
      ))}
      <span class="absolute text-[9px] text-muted" style={`top:0;left:2%;`}>{axis.left}</span>
      <span class="absolute text-[9px] text-muted" style={`top:0;right:2%;`}>{axis.right}</span>
      {/* markers: width = confidence; stacked rows within a band. The marker is
         an IN-PAGE index — it jumps to that position's block (and its audit
         card) rather than ejecting to an external site. This is the only
         behaviour that works on touch, where the marker's hover tooltip is
         invisible and an external tap-out is hostile mid-article. The "read the
         source" affordance stays in the legend below. */}
      {placed.map(({ s, n, within }) => (
        <a
          href={`#pos-${s.id}`}
          title={`${s.label}${s.publication ? ' · ' + s.publication : ''}, placed ${s.stance > 0 ? '+' + s.stance : s.stance} (${s.confidence} confidence). Jump to this position.`}
          class="absolute flex items-center justify-center text-white text-[10px] font-semibold hover:opacity-100 transition-opacity"
          style={`left:${PCT[String(s.stance)]}%;top:${railTop + 8 + within * 20}px;width:${W[s.confidence]}px;height:15px;border-radius:8px;background:${COL(s.stance)};opacity:${OP[s.confidence]};transform:translate(-50%,-50%);box-shadow:0 0 0 3px var(--color-paper);`}
        >{n}</a>
      ))}
    </div>
    {/* Numbered discs only (Decision 21): the cards directly below carry
       every name, and the Sources list carries them again — a third full
       listing here was noise. Each disc still links out to the source
       (name in the accessible label and title). */}
    <div class="flex flex-wrap gap-x-2 gap-y-1.5 mt-1 items-center">
      {placed.map(({ s, n }) => (
        s.url
          ? <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label}${s.publication ? ', ' + s.publication : ''} — read the source`} title={`${s.label}${s.publication ? ' · ' + s.publication : ''} — read the source`} class="inline-flex items-center justify-center w-5 h-5 rounded-full text-white text-[9px] font-semibold hover:opacity-80 transition-opacity" style={`background:${COL(s.stance)};`}>{n}</a>
          : <span aria-label={s.label} title={s.label} class="inline-flex items-center justify-center w-5 h-5 rounded-full text-white text-[9px] font-semibold" style={`background:${COL(s.stance)};`}>{n}</span>
      ))}
      <span class="font-mono text-[9px] uppercase tracking-[0.05em] text-muted ml-1">tap a disc for the source</span>
    </div>
    <details class="mt-1.5">
      <summary class="inline-flex items-center gap-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden font-mono text-[10px] uppercase tracking-[0.08em] text-muted hover:text-ink">
        How to read the map <span class="inline-flex items-center justify-center w-4 h-4 border border-hairline rounded-full text-[10px] normal-case" aria-hidden="true">?</span>
      </summary>
      <p class="text-xs text-muted mt-1 leading-snug max-w-xl">
        A wider marker means we are less sure exactly where that voice sits on the axis (<a href="/method#placement" class="text-accent-support hover:text-accent">how placement works</a>).
      </p>
    </details>
  </div>
)}
