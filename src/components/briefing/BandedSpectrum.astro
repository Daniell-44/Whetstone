---
// The v2 map (D2 Option A, 2026-07-07): only audited positions plot, on a
// signed five-band axis named per question. Marker width = placement
// confidence (rubric on /method). Evidence sources never plot — they render
// as a bibliography strip in the article, not here.
import type { BriefingPositionSource } from '../../../functions/_lib/briefing/types';

interface Props { positions: BriefingPositionSource[]; axis: { left: string; right: string } }
const { positions, axis } = Astro.props;

const PCT: Record<string, number> = { '-2': 10, '-1': 30, '0': 50, '1': 70, '2': 90 };
// Brand hues: teal = the axisLeft pole, brick = the axisRight pole (sign-derived).
const COL = (s: number) => (s < 0 ? '#1E5C5A' : s > 0 ? '#9A2B1F' : '#8A8377');
const W: Record<string, number>  = { high: 15, med: 30, low: 58 };
const OP: Record<string, number> = { high: 1, med: 0.8, low: 0.5 };

// Vertical offset when several positions share a band, so markers never overlap.
const seen: Record<string, number> = {};
const placed = positions.map((s, i) => {
  const k = String(s.stance);
  const within = seen[k] ?? 0;
  seen[k] = within + 1;
  return { s, n: i + 1, within };
});
const rows = Math.max(1, ...Object.values(seen));
const railTop = 18;
const height = railTop + 14 + rows * 20 + 16;
---
{positions.length > 0 && (
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.06em] text-muted mb-1">The map · {positions.length} audited {positions.length === 1 ? 'position' : 'positions'}</p>
    <div class="relative" style={`height:${height}px;`}>
      {/* rail + band ticks */}
      <div class="absolute" style={`top:${railTop + 7}px;left:2%;right:2%;height:2px;background:#E0D8CA;`}></div>
      {(['-2','-1','0','1','2'] as const).map((b) => (
        <div class="absolute" style={`left:${PCT[b]}%;top:${railTop + 2}px;width:1px;height:12px;background:#C9BFAE;`}></div>
      ))}
      <span class="absolute text-[9px] text-muted" style={`top:0;left:2%;`}>{axis.left}</span>
      <span class="absolute text-[9px] text-muted" style={`top:0;right:2%;`}>{axis.right}</span>
      {/* markers: width = confidence; stacked rows within a band */}
      {placed.map(({ s, n, within }) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          title={`${s.label}${s.publication ? ' · ' + s.publication : ''} — placed ${s.stance > 0 ? '+' + s.stance : s.stance} (${s.confidence} confidence)`}
          class="absolute flex items-center justify-center text-white text-[10px] font-semibold hover:opacity-100 transition-opacity"
          style={`left:${PCT[String(s.stance)]}%;top:${railTop + 8 + within * 20}px;width:${W[s.confidence]}px;height:15px;border-radius:8px;background:${COL(s.stance)};opacity:${OP[s.confidence]};transform:translate(-50%,-50%);box-shadow:0 0 0 3px #FBF7F0;`}
        >{n}</a>
      ))}
    </div>
    {/* numbered legend */}
    <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1">
      {placed.map(({ s, n }) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-ink hover:text-accent transition-colors">
          <span class="inline-flex items-center justify-center w-4 h-4 rounded-full text-white text-[9px] font-semibold" style={`background:${COL(s.stance)};`}>{n}</span>
          {s.label}{s.publication ? ` · ${s.publication}` : ''}
        </a>
      ))}
    </div>
    <p class="text-xs text-muted mt-1.5 leading-snug">
      Every point is an audited position; marker width shows how confidently it's placed
      (<a href="/method#placement" class="text-accent hover:text-accent-support">method</a>). Evidence sources are listed below, not plotted.
    </p>
  </div>
)}
