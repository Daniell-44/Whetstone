---
// Single briefing/explainer card, used across the home feed at several sizes.
// One source of truth for the card look so the featured band and the asymmetric
// mosaic can't drift apart.
//
// size:
//   featured  — large, always has a banner (real image or category placeholder)
//   wide      — the mosaic's wide feature cell; always has a banner
//   standard  — the mosaic's normal cell; image-OPTIONAL (banner only if a real
//               image exists), otherwise text-first
// Explainers are always text-first regardless of size.
import PositionSpectrum from '../scorecard/PositionSpectrum.astro';
import type { BriefingArticle } from '../../../functions/_lib/briefing/types';
import { auditSignature } from '../../../functions/_lib/briefing/signature';
import { categoryColour } from '../../lib/category-colour';

interface Props {
  b: BriefingArticle;
  size?: 'featured' | 'wide' | 'standard';
  style?: string;
  class?: string;
}
const { b, size = 'standard', style, class: extraClass = '' } = Astro.props;

// Category colour-banners + the rainbow spectrum-dot cycle were abolished under
// The Instrument (2026-07-08) — category is now a mono kicker, legend markers
// are graphite. The old maps are gone.

function landscapeText(a: BriefingArticle): string {
  const l = a.blocks.find((bl) => bl.type === 'landscape');
  return l && 'text' in l ? l.text : '';
}

const isExplainer = b.kind === 'explainer';
// Mini-map placement: v2 positions carry a 5-band stance (map to the compact
// renderer's -100..100 scale); legacy sources carry a raw leaning.
const leaningById: Record<string, number> = {
  ...Object.fromEntries(b.sources.map((s) => [s.id, s.leaning])),
  ...Object.fromEntries((b.positionSources ?? []).map((s) => [s.id, s.stance * 50])),
};
const positions = b.blocks.flatMap((bl) =>
  bl.type === 'position' ? [{ label: bl.label, leaning: leaningById[bl.sourceId] ?? 0 }] : [],
);
const shared = b.blocks.find((bl) => bl.type === 'shared');
const firstProse = b.blocks.find((bl) => bl.type === 'prose');
// Explainers have no audit verdict — lead with the opening line instead. For
// briefings the dek falls back landscape→shared; label it honestly for what it
// is (a shared premise is NOT an audit finding — it's the thing neither side
// questioned).
const usingShared = !isExplainer && !!(shared && 'text' in shared);
const dek = isExplainer
  ? (firstProse && 'text' in firstProse ? firstProse.text : landscapeText(b))
  : (usingShared ? (shared as any).text : landscapeText(b));
const dekLabel = usingShared ? 'Both sides assume' : 'The landscape';

// Source count for the meta line. v2 briefings carry positionSources +
// evidenceSources; legacy carries `sources`. Counting the v1 field alone
// rendered "0 sources" on every card (all 8 briefings are v2).
const sourceCount = b.sources.length
  + (b.positionSources?.length ?? 0)
  + (b.evidenceSources?.length ?? 0);

// Audit signature — the differentiator, visible at feed level (D1-B, 2026-07-07).
const sig = auditSignature(b);
const chipFallacies = sig.fallacies.slice(0, 2);
// Groundedness mix labels follow the site-wide chip vocabulary.
const KIND_LABEL: Record<string, string> = { structural: 'Logic', interpretive: 'Judgment call', empirical: 'Factual' };
const kindMix = (Object.entries(sig.kinds) as [string, number][])
  .filter(([, n]) => n > 0)
  .map(([k, n]) => `${KIND_LABEL[k]}${n > 1 ? ` ×${n}` : ''}`);
const showLead = size === 'featured' && !!sig.lead;

// The Instrument (2026-07-08): category colour-banners abolished — a real
// curated image still shows, but the saturated bg-*-600 placeholder is gone.
// Images sit on the SIDE (left), not as a top banner: a side image fills the
// card's existing height (set by the text) instead of adding a band, so it
// never inflates the row (see Card_Image_Treatments_v1.md). Recommendation:
// only wide/featured cells carry images — a side image on a narrow card is a
// cramped thumbnail. Explainers stay text-only.
//
// A `/placeholder-*` cover is a DEBUG asset (it literally renders the word
// PLACEHOLDER); treat it as absent so the text-first branch takes over rather
// than shipping a broken-image glyph on the front door. Real covers get wired
// per-briefing later; until then no card carries a placeholder. Also honour the
// component's own long-standing recommendation: side images only on the wide
// hero cells, never a cramped thumb on a narrow standard card.
const hasRealImage = !!b.image && !b.image.includes('/placeholder-');
const sideImage = !isExplainer && hasRealImage && (size === 'featured' || size === 'wide');
// Mobile feed compaction (2026-07-10, Daniel: "slightly cluttered... less
// vertical height"). The editorial-app norm (Apple News / NYT / Ground News)
// is one hero + compact list rows: headline, small right thumbnail, ONE meta
// line, no dek. Non-featured briefing cards follow that below sm: dek +
// spectrum become desktop-only, the fallacy-chip row stays as the meta line
// (the differentiator), and an image renders as a ~88px right thumb instead
// of a banner. Featured keeps the hero treatment; explainers were compact.
const compact      = !isExplainer && size !== 'featured';
const compactThumb = sideImage && compact;
// Top rule: image cards keep the graphite instrument bar (the image carries the
// colour); text cards get a 3px muted category-colour tick (Daniel signed off
// 2026-07-09). Redline stays reserved for findings.
const topBorder = sideImage ? '2px solid var(--color-ink-strong)' : `3px solid ${categoryColour(b.category)}`;
const eyebrowCls = isExplainer ? 'text-accent-support' : 'text-muted';
const headingCls = size === 'featured'
  ? 'text-xl sm:text-2xl'
  : size === 'wide' ? 'text-lg sm:text-xl' : 'text-base sm:text-lg';
---
<a
  href={`/briefing/${b.slug}`}
  data-briefing-card
  data-category={b.category ?? ''}
  style={`${style ?? ''}; border-top: ${topBorder};`}
  class={`group flex h-full bg-surface border border-hairline hover:border-ink-strong/30 hover:shadow-sm transition-all ${sideImage ? (compactThumb ? 'flex-row' : 'flex-col sm:flex-row') : 'flex-col'} ${extraClass}`}
>
  {/* Featured + image: full-width banner on mobile (the hero), side image at
     sm+. Non-featured + image: a small right thumb on mobile (order-2), the
     side treatment at sm+ (order back to DOM = left).
     The img is absolutely positioned inside a stretching wrapper at sm+ so the
     TEXT column sets the card height and the image crops to fill (the
     height-neutral side-image mechanic from Card_Image_Treatments_v1). A bare
     img with an intrinsic aspect ratio would drive the row height instead —
     a portrait cover inflated the whole card. */}
  {sideImage && (
    <div
      class={compactThumb
        ? 'order-2 sm:order-none w-[88px] h-[88px] shrink-0 self-center mr-4 rounded-[2px] overflow-hidden sm:w-2/5 sm:h-auto sm:self-stretch sm:mr-0 sm:rounded-none sm:relative'
        : 'w-full h-36 overflow-hidden sm:w-2/5 sm:shrink-0 sm:h-auto sm:self-stretch sm:relative'}
    >
      <img
        src={b.image}
        alt=""
        loading="lazy"
        class="w-full h-full object-cover sm:absolute sm:inset-0"
      />
    </div>
  )}
  <div class={`flex flex-col flex-1 min-w-0 ${compact ? 'p-4 sm:p-6' : 'p-5 sm:p-6'}`}>
    <div class="flex items-center gap-2 mb-2.5 flex-wrap font-mono text-[11px] uppercase tracking-[0.08em]">
      <span class={eyebrowCls}>{isExplainer ? 'Explainer' : 'Briefing'}</span>
      {b.category && <span class="text-muted">· {b.category}</span>}
      {!isExplainer && (
        <span class={`text-muted ${compact ? 'hidden sm:inline' : ''}`}>· {positions.length} positions · {sourceCount} sources</span>
      )}
    </div>
    <h3 class={`font-serif ${headingCls} text-ink-strong group-hover:text-accent transition-colors leading-snug ${isExplainer ? '' : 'mb-2'}`}>
      {b.question}
    </h3>
    {!isExplainer && (
      <div class={compact ? 'hidden sm:block' : ''}>
        <p class="text-sm text-ink leading-relaxed line-clamp-2 mb-3">
          <span class="font-medium text-muted">{dekLabel}</span>: {dek}
        </p>
      </div>
    )}
    {showLead && sig.lead && (
      <p class="text-sm italic text-muted border-l-2 border-accent pl-3 leading-relaxed mb-3">
        &ldquo;{sig.lead.quote}&rdquo; <span class="not-italic text-xs">flagged <span class="font-semibold text-accent">{sig.lead.fallacy}</span></span>
      </p>
    )}
    {!isExplainer && chipFallacies.length > 0 && (
      <div class="flex items-center gap-1.5 flex-wrap mb-3">
        {chipFallacies.map((f) => (
          <span class="font-mono text-[10px] font-medium uppercase tracking-wide text-ink border border-hairline px-1.5 py-0.5">{f}</span>
        ))}
        {kindMix.length > 0 && (
          <span class="font-mono text-[10px] font-medium uppercase tracking-wide bg-logic-bg text-logic border border-logic/30 px-1.5 py-0.5">{kindMix.join(' · ')}</span>
        )}
        <span class="font-mono text-[10px] uppercase tracking-wide text-muted">
          <span class="text-accent font-semibold">{sig.auditedPositions}</span> audited{sig.auditedTakes > 0 ? ` · ${sig.auditedTakes} take${sig.auditedTakes === 1 ? '' : 's'}` : ''}
        </span>
      </div>
    )}
    {positions.length > 0 && (
      <div class={`mt-auto pt-1 ${compact ? 'hidden sm:block' : ''}`}>
        <PositionSpectrum positions={positions} axis={b.spectrumAxis} compact />
        <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-1.5">
          {positions.map((p, i) => (
            <span class="inline-flex items-center gap-1 text-xs text-muted">
              <span class="inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-ink-strong text-white text-[8px] font-semibold">{i + 1}</span>
              {p.label}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>
</a>
