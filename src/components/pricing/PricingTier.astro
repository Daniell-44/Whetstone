---
interface Props {
  label:        string;
  labelColour:  string;
  price:        string;
  priceUnit?:   string;
  subtext:      string;
  features:     string[];
  featureColour: string;
  highlighted?: boolean;
  accentBar?:   string;
  badge?:       string;   // e.g. "Most popular for solo writers"
  reassurance?: string;   // risk-reversal line under the CTA
}

const { label, labelColour, price, priceUnit, subtext, features, featureColour, highlighted, accentBar, badge, reassurance } = Astro.props;
---
<div class={`relative p-6 sm:p-8 ${highlighted ? 'bg-accent-support/5' : ''}`}>
  {accentBar && <div class={`absolute top-0 left-0 right-0 h-1 ${accentBar}`} />}

  {badge && (
    <span class="inline-block mb-3 font-mono text-[10px] font-semibold uppercase tracking-wide bg-accent-support/10 text-accent-support px-2 py-0.5 rounded">{badge}</span>
  )}
  <p class={`text-xs font-bold uppercase tracking-wider font-mono ${labelColour} mb-2`}>{label}</p>
  <div class="flex items-baseline gap-1 mb-1">
    <span class="font-serif text-4xl text-ink-strong">{price}</span>
    {priceUnit && <span class="text-muted text-sm">{priceUnit}</span>}
  </div>
  <p class="text-sm text-muted mb-4 sm:mb-6">{subtext}</p>

  <!-- Mobile: native <details> disclosure. The old display:none checkbox was
       outside the tab order and the a11y tree, so keyboard/screen-reader
       users could not expand any tier's features below 640px (WCAG 2.1.1).
       Native semantics come free; py-3 lifts the row to ~44px. -->
  <details class="group sm:hidden mb-4">
    <summary class="w-full flex items-center justify-between py-3 text-xs font-semibold font-mono text-muted uppercase tracking-wider cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <span>{features.length} features</span>
      <svg
        class="w-4 h-4 transition-transform group-open:rotate-180"
        fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"
      ><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
    </summary>
    <ul class="space-y-2.5 text-sm pt-1">
      {features.map((feature) => (
        <li class="flex gap-2 text-ink">
          <span class={`shrink-0 ${featureColour}`}>✓</span>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </details>

  <!-- sm+: the list is always visible (no disclosure). -->
  <ul class="hidden sm:block space-y-2.5 text-sm sm:mb-8">
    {features.map((feature) => (
      <li class="flex gap-2 text-ink">
        <span class={`shrink-0 ${featureColour}`}>✓</span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <div>
    <slot name="cta" />
    {reassurance && (
      <p class="mt-2.5 text-center text-xs text-muted">{reassurance}</p>
    )}
  </div>
</div>
