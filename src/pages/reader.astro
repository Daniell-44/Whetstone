---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import AuditForm from '../components/audit/AuditForm';
import { listScorecards } from '../../functions/_lib/scorecard/storage';

const scorecards = await listScorecards(env.SCORECARDS);

// Category tag colours — like The Verge / Vox section labels
const TAG_COLOURS = [
  { bg: 'bg-indigo-600', text: 'text-white' },
  { bg: 'bg-rose-600',   text: 'text-white' },
  { bg: 'bg-emerald-600', text: 'text-white' },
  { bg: 'bg-amber-500',  text: 'text-white' },
  { bg: 'bg-violet-600', text: 'text-white' },
  { bg: 'bg-sky-600',    text: 'text-white' },
];

// Estimate reading time from dek length (rough proxy for scorecard depth)
function readTime(dek: string): string {
  const words = dek.split(/\s+/).length;
  const mins = Math.max(3, Math.ceil(words / 40) + 2); // scorecards take ~3-8 min
  return `${mins} min read`;
}

// Category tag colours
const CATEGORY_STYLES: Record<string, { bg: string; text: string }> = {
  politics:    { bg: 'bg-red-600',    text: 'text-white' },
  economics:   { bg: 'bg-emerald-600', text: 'text-white' },
  science:     { bg: 'bg-blue-600',   text: 'text-white' },
  technology:  { bg: 'bg-violet-600', text: 'text-white' },
  health:      { bg: 'bg-pink-600',   text: 'text-white' },
  culture:     { bg: 'bg-amber-600',  text: 'text-white' },
  philosophy:  { bg: 'bg-indigo-600', text: 'text-white' },
  law:         { bg: 'bg-gray-700',   text: 'text-white' },
  environment: { bg: 'bg-green-600',  text: 'text-white' },
  education:   { bg: 'bg-sky-600',    text: 'text-white' },
};
---
<Base
  title="Reader — The Whetstone"
  description="Audit any argument. Browse published logic scorecards. Think more carefully."
  canonicalPath="/reader"
>
  <main class="max-w-6xl mx-auto px-6 pt-16 pb-24">

    <!-- Hero — editorial magazine style -->
    <header class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px flex-1 bg-gray-200" />
        <p class="text-xs font-semibold tracking-[0.3em] text-indigo-500 uppercase shrink-0">The Whetstone · Reader</p>
        <div class="h-px flex-1 bg-gray-200" />
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 leading-tight text-center mb-4">
        Think more carefully<br class="hidden sm:block" /> about arguments.
      </h1>
      <p class="text-lg text-gray-500 leading-relaxed text-center max-w-2xl mx-auto">
        Paste any text, drop a URL, or browse published logic scorecards below.
      </p>
    </header>

    <!-- URL / Text input — full width so split panel can expand -->
    <section class="mb-16">
      <AuditForm client:load />
    </section>

    <!-- Magazine panels: scorecards as editorial cards -->
    <section>
      <div class="flex items-center gap-4 mb-8">
        <h2 class="font-serif text-2xl text-gray-900 shrink-0">Logic Scorecards</h2>
        <div class="h-px flex-1 bg-gray-200" />
        <a href="/scorecards" class="text-xs text-indigo-600 hover:text-indigo-800 transition-colors font-medium shrink-0">
          View all →
        </a>
      </div>

      {scorecards.length === 0 ? (
        <div class="py-20 border-t border-gray-200">
          <p class="font-serif text-2xl text-gray-300 text-center">No scorecards published yet.</p>
          <p class="text-sm text-gray-300 mt-2 text-center">Published logic audits of notable arguments will appear here.</p>
        </div>
      ) : (
        <div>

          {/* Lead story — editorial hero, white background, strong typography */}
          {scorecards.length > 0 && (
            <a
              href={`/scorecard/${scorecards[0].slug}`}
              class="group block border-t border-b border-gray-200 py-10 sm:py-14"
            >
              <div class="max-w-4xl">
                <div class="flex items-center gap-3 mb-4">
                  {scorecards[0].category && CATEGORY_STYLES[scorecards[0].category] ? (
                    <span class={`inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider ${CATEGORY_STYLES[scorecards[0].category!].bg} ${CATEGORY_STYLES[scorecards[0].category!].text}`}>
                      {scorecards[0].category}
                    </span>
                  ) : (
                    <span class={`inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider ${TAG_COLOURS[0].bg} ${TAG_COLOURS[0].text}`}>
                      Logic Scorecard
                    </span>
                  )}
                  <span class="text-xs text-gray-400">{readTime(scorecards[0].dek)}</span>
                </div>
                <h3 class="font-serif text-3xl sm:text-4xl text-gray-900 group-hover:text-indigo-600 transition-colors leading-tight mb-4">
                  {scorecards[0].question}
                </h3>
                <p class="text-lg text-gray-500 leading-relaxed max-w-3xl mb-5">
                  {scorecards[0].dek}
                </p>
                <p class="text-xs text-gray-400 tabular-nums">
                  {new Date(scorecards[0].publishedDate + 'T00:00:00').toLocaleDateString('en-GB', {
                    day: 'numeric', month: 'long', year: 'numeric',
                  })}
                </p>
              </div>
            </a>
          )}

          {/* Grid — media-style cards with category pills and reading time */}
          {scorecards.length > 1 && (
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-0">
              {scorecards.slice(1).map((sc, i) => {
                const tagIdx = (i + 1) % TAG_COLOURS.length;
                const isLastInRow = (i + 1) % 3 === 0;
                return (
                  <a
                    href={`/scorecard/${sc.slug}`}
                    class={`group block py-8 px-6 border-b border-gray-200 ${!isLastInRow ? 'lg:border-r' : ''} hover:bg-gray-50 transition-colors`}
                  >
                    <div class="flex items-center gap-2.5 mb-3">
                      {sc.category && CATEGORY_STYLES[sc.category] ? (
                        <span class={`inline-block px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${CATEGORY_STYLES[sc.category!].bg} ${CATEGORY_STYLES[sc.category!].text}`}>
                          {sc.category}
                        </span>
                      ) : (
                        <span class={`inline-block px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${TAG_COLOURS[tagIdx].bg} ${TAG_COLOURS[tagIdx].text}`}>
                          Scorecard
                        </span>
                      )}
                      <span class="text-[10px] text-gray-400">{readTime(sc.dek)}</span>
                    </div>
                    <h3 class="font-serif text-lg text-gray-900 group-hover:text-indigo-600 transition-colors leading-snug mb-2">
                      {sc.question}
                    </h3>
                    <p class="text-sm text-gray-500 leading-relaxed line-clamp-3 mb-4">{sc.dek}</p>
                    <p class="text-[10px] text-gray-400 tabular-nums">
                      {new Date(sc.publishedDate + 'T00:00:00').toLocaleDateString('en-GB', {
                        day: 'numeric', month: 'short', year: 'numeric',
                      })}
                    </p>
                  </a>
                );
              })}
            </div>
          )}
        </div>
      )}
    </section>

    <!-- Info strip — editorial footer columns, separated by rules -->
    <div class="grid md:grid-cols-3 gap-0 mt-16 border-t border-gray-900 pt-8">

      <div class="py-4 px-6 md:border-r md:border-gray-200">
        <h3 class="text-xs font-bold uppercase text-gray-900 mb-2">Chrome Extension</h3>
        <p class="text-sm text-gray-500 leading-relaxed mb-3">
          Audit any argument while you read. Highlight text on any webpage and see its logical structure in the side panel.
        </p>
        <span class="text-xs font-semibold text-gray-400">Coming soon</span>
      </div>

      <div class="py-4 px-6 md:border-r md:border-gray-200">
        <h3 class="text-xs font-bold uppercase text-gray-900 mb-2">Creator Studio</h3>
        <p class="text-sm text-gray-500 leading-relaxed mb-3">
          Point the engine at your own writing. Full audit suite, counterargument generation, citation checking, and revision tracking.
        </p>
        <a href="/creator" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
          Learn more →
        </a>
      </div>

      <div class="py-4 px-6">
        <h3 class="text-xs font-bold uppercase text-gray-900 mb-2">Open Source</h3>
        <p class="text-sm text-gray-500 leading-relaxed mb-3">
          Every prompt and schema is auditable. A tool that shapes how people read arguments should be transparent about how it works.
        </p>
        <a href="https://github.com/Daniell-44/The_Whetstone_Project" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors" target="_blank" rel="noopener">
          View on GitHub →
        </a>
      </div>

    </div>

  </main>
</Base>
