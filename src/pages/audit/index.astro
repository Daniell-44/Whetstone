---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import AuditForm from '../../components/audit/AuditForm';
---

<Base
  title="Audit an Argument | The Whetstone"
  description="Paste any piece of argumentative text and get a structural breakdown: central claim, evidence, hidden assumptions, named fallacies, and loaded language."
  canonicalPath="/audit"
>
  <main class="max-w-2xl mx-auto px-6 pt-16 pb-24">

    <header class="mb-10">
      <h1 class="font-serif text-3xl text-gray-900 mb-3">Audit an Argument</h1>
      <p class="text-gray-500 text-base leading-relaxed max-w-xl">
        Paste any piece of text — an article, a speech, a debate claim — and the engine maps its
        structure: the central claim, what evidence is offered, what's assumed without saying,
        and any named fallacies or loaded language.
      </p>
    </header>

    <AuditForm client:load />

  </main>
</Base>
