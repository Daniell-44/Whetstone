---
export const prerender = false;
// The Audit — the free engine's own page (D1 Option B, 2026-07-07). Previously
// this route 301'd to / (when the tool WAS the homepage); the homepage is now
// the publication and the tool lives here. Shareable audits stay at /audit/[id].
//
// As of 2026-08-16 this is the ONE door to the whole tool (owner decision:
// "go on the studio and reader combination"). Read mode audits someone else's
// writing; Create mode is the editor that used to live at /creator/studio,
// which now redirects here. Saving is the only thing that asks for sign-in.
//
// Ask mode joined them on 2026-08-17 (owner decision: "a question box belongs
// where people already arrive, alongside paste-a-draft and paste-a-URL, as a
// third way in"). It was prototyped on the cross-document page, which keeps
// its worked example but no longer carries a live box, because two live
// entrances would split the single door again.

import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import AuditForm from '../../components/audit/AuditForm';
import ToolNav from '../../components/tool/ToolNav.astro';
import StudioEditor from '../../components/studio/StudioEditor';
import QuestionBriefing from '../../components/premise/QuestionBriefing';
import OnboardingTour from '../../components/onboarding/OnboardingTour';
import { getAllBriefings } from '../../lib/briefings';
import type { BriefingArticle } from '../../../functions/_lib/briefing/types';

import { makeAuthDb } from '../../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../../functions/_lib/auth/sessions';
import { makeBillingDb } from '../../../functions/_lib/billing/subscription';
import { makeDocumentDb } from '../../../functions/_lib/documents/db';
import { makeFindingActionDb } from '../../../functions/_lib/documents/finding-actions';
import { makeWorkspaceDb } from '../../../functions/_lib/workspaces/db';
import { userHasActiveSubscriptionViaWorkspace } from '../../../functions/_lib/workspaces/permissions';
import type { AuditResult } from '../../lib/audit';
import type { CounterargumentResult } from '../../lib/counterargument';
import type { ArgumentExtractionResult } from '../../lib/extraction';
import type { PhilosophicalCommitmentsResult } from '../../../functions/_lib/philosophical-commitments/types';
import type { CitationAuditResult } from '../../../functions/_lib/citation-audit/types';
import type { DocumentVersion } from '../../../functions/_lib/documents/types';

// The reserved URL contract (merge adjudication 2026-07-13). These params are
// honoured at the tool's canonical address, so the remaining satellite rooms
// can cut over later with a redirect flip, not a link-breaking migration.
// Deliberately 302 (temporary): the destinations change at cutover and must
// not be cached.
const typeParam = Astro.url.searchParams.get('type');
if (typeParam === 'transcript') return Astro.redirect('/creator/studio/transcript', 302);
if (Astro.url.searchParams.get('compare') === '1') return Astro.redirect('/creator/studio/cross-document', 302);

// Server-side mode switch ("Workbench + satellites" adjudication, 2026-07-13):
// ?mode=create renders the Create island (StudioEditor) in place of the Reader,
// and ?mode=question renders the question box. No client toggle, no double
// hydration; the segmented control is plain links, so only the island for the
// mode being viewed is ever shipped to the browser.
// A ?doc= param implies Create mode: saved documents only open in the editor.
// (Until the 2026-08-16 cutover ?doc= bounced to /creator/studio; that page now
// redirects HERE, so the document loads on this page and a redirect loop is
// impossible.)
const docParam = Astro.url.searchParams.get('doc');
const modeParam = Astro.url.searchParams.get('mode');
const mode: 'read' | 'create' | 'question' =
  modeParam === 'create' || docParam ? 'create'
  : modeParam === 'question' ? 'question'
  : 'read';

// "Audit the full article" deep-link: /audit?audit=<slug> pre-loads the field
// with the briefing's argumentative prose. (Moved from index.astro; / shims
// legacy /?audit=&url= links here.)
function briefingPlainText(b: BriefingArticle): string {
  const parts: string[] = [];
  for (const bl of b.blocks) {
    if (bl.type === 'position') parts.push(bl.paragraph);
    else if (bl.type === 'landscape' || bl.type === 'prose' || bl.type === 'shared' || bl.type === 'editorView') parts.push(bl.text);
  }
  return parts.join('\n\n').slice(0, 10_000);
}
// A `pos=<sourceId>` narrows the prefill to ONE position's argument text — the
// exact text the briefing's audit card assessed. This is what a per-position
// "Audit this argument" link carries, so the tool opens on the same words the
// reader just saw audited (no re-fetching the remote source, which often fails
// to extract). Falls back to the whole-briefing prose if the position is absent.
function positionText(b: BriefingArticle, sourceId: string): string {
  for (const bl of b.blocks) {
    if (bl.type === 'position' && bl.sourceId === sourceId) return bl.paragraph;
  }
  return '';
}
const auditSlug    = Astro.url.searchParams.get('audit');
const auditPosId   = Astro.url.searchParams.get('pos');
const auditTarget  = auditSlug ? getAllBriefings().find((b) => b.slug === auditSlug) : undefined;
const auditPrefill = auditTarget
  ? ((auditPosId && positionText(auditTarget, auditPosId)) || briefingPlainText(auditTarget))
  : '';
// /audit?url=<source> deep-link: audit the source article a briefing position quotes.
// ALSO the Web Share Target landing (manifest.webmanifest share_target): many
// Android apps put the shared link in the `text` field rather than `url`, so
// fall back to extracting an http(s) URL from `text`; non-URL shared text is
// treated as pasted argument text.
const auditUrlParam  = Astro.url.searchParams.get('url') ?? '';
const auditTextParam = Astro.url.searchParams.get('text') ?? '';
const urlFromText    = auditTextParam.match(/https?:\/\/\S+/)?.[0] ?? '';
const auditUrl       = auditUrlParam.startsWith('http') ? auditUrlParam : urlFromText;
// Shared plain text (no URL in it) lands as the pasted argument.
const sharedText     = !auditUrl && auditTextParam.length >= 50 ? auditTextParam.slice(0, 10_000) : '';
// /audit?sample=<id> deep-link (home-feed launcher chips): auto-load a
// pre-cached sample so the reader sees a worked result instantly, no API call.
const auditSampleId = Astro.url.searchParams.get('sample') ?? '';

// Deeper lenses show a subscription-aware teaser in the Reader, so detect it.
const authDb  = makeAuthDb(env.DB);
const session = await getSessionFromRequest(Astro.request, authDb);
const isPro = session
  ? await userHasActiveSubscriptionViaWorkspace(makeBillingDb(env.DB), makeWorkspaceDb(env.DB), session.user_id)
  : false;
// Create mode labels findings to the signed-in user's terminology preference.
// A signed-out visitor has no stored preference and gets the default ('plain',
// matching what a fresh account starts with).
const terminology = mode === 'create'
  ? (session ? await authDb.getTerminologyPreference(session.user_id) : 'plain')
  : undefined;

// Every engine is on the free tier (owner decision 2026-08-14: "all features
// should be in free tier, no sign in needed for now but force sign in if one
// session has >3 uses"). The >3-uses rule is enforced server-side by the
// anonymous session gate on the analysis endpoints, so the subscription flag
// is forced on rather than computed from billing.
const hasActiveSubscription = true;

// Defensive: a corrupt stored JSON column shouldn't 500 the whole page.
function safeJsonParse<T>(s: string | null | undefined): T | null {
  if (!s) return null;
  try { return JSON.parse(s) as T; } catch { return null; }
}

// Load a saved document from ?doc= (moved here from /creator/studio at the
// 2026-08-16 cutover). Loading only makes sense for the signed-in owner; a
// signed-out visitor with a shared ?doc= link lands on an empty untitled draft.
let initialDocId:            string | null = null;
let initialTitle:            string        = 'Untitled draft';
let initialContent:          string        = '';
let initialVersionId:        string | null = null;
let initialAuditResult:      AuditResult | null = null;
let initialCounterargResult: CounterargumentResult | null = null;
let initialExtractionResult:  ArgumentExtractionResult | null = null;
let initialCommitmentsResult: PhilosophicalCommitmentsResult | null = null;
let initialCitationResult:    CitationAuditResult | null = null;
let initialAnalyzedAt:        number | null = null;
let initialActions:          Record<string, { id: string; action: string; reason?: string | null; updatedAt: number }> = {};

if (docParam && session) {
  const docDb    = makeDocumentDb(env.DB);
  const actionDb = makeFindingActionDb(env.DB);
  const doc      = await docDb.getDocumentById(docParam);
  if (doc && doc.user_id === session.user_id && doc.status === 'active') {
    const latest: DocumentVersion | null = await docDb.getLatestVersion(docParam);
    initialDocId    = doc.id;
    initialTitle    = doc.title;
    initialContent  = latest?.content ?? '';
    initialVersionId = latest?.id ?? null;
    initialAuditResult      = safeJsonParse<AuditResult>(latest?.audit_result);
    initialCounterargResult = safeJsonParse<CounterargumentResult>(latest?.counterarg_result);
    initialExtractionResult  = safeJsonParse<ArgumentExtractionResult>(latest?.extraction_json);
    initialCommitmentsResult = safeJsonParse<PhilosophicalCommitmentsResult>(latest?.commitments_json);
    initialCitationResult    = safeJsonParse<CitationAuditResult>(latest?.citation_audit_json);
    // Only stamp "last analysed" when the loaded version actually has an audit.
    initialAnalyzedAt        = initialAuditResult ? (latest?.created_at ?? null) : null;

    const rows = await actionDb.listActionsForDocument(doc.id, session.user_id);
    for (const r of rows) {
      initialActions[`${r.lens}:${r.match_key}`] = {
        id:        r.id,
        action:    r.action,
        reason:    r.reason,
        updatedAt: r.updated_at,
      };
    }
  }
}
---
<Base
  title="The Audit - The Whetstone"
  description="Paste any text, drop a URL, or ask a contested question. See the structure behind the argument: claims, evidence, where the logic breaks down, and the strongest opposing case. Free to try."
  canonicalPath="/audit"
  ogImage="/og/page-audit.png"
  isLoggedIn={!!session}
>
  {/* One width for both modes: switching Read/Create must not shift the shared
     strip + toggle sideways (the one-surface reading is the point of the merge).
     Inner sections apply their own narrower constraints. */}
  <main class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-16 sm:pb-24">
    <ToolNav current="audit" />

    {/* Read / Create / Ask mode control: a segmented PILL, deliberately a
       different shape from the ToolNav underline-tabs above it, because two
       stacked rows of the same tab grammar read as two competing navigation
       systems. Plain anchors, server-rendered active state.
       Each tab names its INPUT in plain words underneath, which is how a
       visitor who arrived with a question rather than a document finds the
       third way in without the first screen having to explain itself twice.
       Horizontal scroll below sm so a third tab cannot push the pill off a
       narrow phone. */}
    <nav class="mb-8 overflow-x-auto" aria-label="Audit mode">
      <div class="inline-flex items-stretch rounded-lg border border-hairline bg-paper p-1 gap-1">
        <a
          href="/audit"
          aria-current={mode === 'read' ? 'page' : undefined}
          class={`flex flex-col justify-center min-h-[44px] rounded-md px-3 sm:px-4 py-1.5 transition-colors ${
            mode === 'read' ? 'bg-surface text-ink-strong shadow-sm' : 'text-muted hover:text-ink'
          }`}
        >
          <span class="text-sm font-semibold leading-tight">Read</span>
          <span class="sm:hidden font-mono text-[11px] uppercase tracking-[0.04em] text-muted leading-tight">their writing</span>
          <span class="hidden sm:block font-mono text-[11px] uppercase tracking-[0.04em] text-muted leading-tight">someone else's writing</span>
        </a>
        <a
          href="/audit?mode=create"
          aria-current={mode === 'create' ? 'page' : undefined}
          class={`flex flex-col justify-center min-h-[44px] rounded-md px-3 sm:px-4 py-1.5 transition-colors ${
            mode === 'create' ? 'bg-surface text-ink-strong shadow-sm' : 'text-muted hover:text-ink'
          }`}
        >
          <span class="text-sm font-semibold leading-tight">Create</span>
          <span class="sm:hidden font-mono text-[11px] uppercase tracking-[0.04em] text-muted leading-tight">your writing</span>
          <span class="hidden sm:block font-mono text-[11px] uppercase tracking-[0.04em] text-muted leading-tight">your own writing</span>
        </a>
        <a
          href="/audit?mode=question"
          aria-current={mode === 'question' ? 'page' : undefined}
          class={`flex flex-col justify-center min-h-[44px] rounded-md px-3 sm:px-4 py-1.5 transition-colors ${
            mode === 'question' ? 'bg-surface text-ink-strong shadow-sm' : 'text-muted hover:text-ink'
          }`}
        >
          <span class="text-sm font-semibold leading-tight">Ask</span>
          <span class="sm:hidden font-mono text-[11px] uppercase tracking-[0.04em] text-muted leading-tight">a question</span>
          <span class="hidden sm:block font-mono text-[11px] uppercase tracking-[0.04em] text-muted leading-tight">a contested question</span>
        </a>
      </div>
    </nav>

    {/* Three exclusive branches rather than nested ternaries: with a third mode
       a ternary chain stops being readable, and each mode's header belongs
       beside the island it introduces. */}
    {mode === 'read' && (
      <>
        <header class="mb-8 max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-widest font-mono text-muted mb-2">The Audit</p>
          <h1 class="font-serif text-2xl sm:text-3xl text-ink-strong leading-snug">See where an argument's reasoning breaks down.</h1>
          <p class="mt-2 text-sm text-muted leading-relaxed">
            Paste an argument or drop a link. The engine returns the structure: the claim, its warrants, and the named reasoning patterns inside it. Not a verdict on who's right.
          </p>
        </header>

        {/* 1200px: room for the empty-state specimen rail beside the input,
           and a less-cramped two-panel results view (was max-w-4xl / 896px). */}
        <section class="max-w-[1200px]">
          <AuditForm isPro={isPro} initialText={auditPrefill || sharedText} initialUrl={auditUrl} initialSampleId={auditSampleId} client:load />
        </section>
      </>
    )}

    {mode === 'question' && (
      <>
        <header class="mb-8 max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-widest font-mono text-muted mb-2">The Audit · Ask</p>
          <h1 class="font-serif text-2xl sm:text-3xl text-ink-strong leading-snug">Start from a question, not a document.</h1>
          {/* About a minute, not the 40 seconds the research itself takes: the
             second request re-reads the question server-side rather than
             trusting a client-supplied outline, so the reader waits for both
             halves. Name the wait they actually get. */}
          <p class="mt-2 text-sm text-muted leading-relaxed">
            Type a contested question and the engine names the claims an answer would rest on,
            researches the first two, and quotes only what it can check word-for-word at the
            source. It runs live and takes about a minute.
          </p>
        </header>

        {/* Narrower than the Reader's 1200px: this mode has no specimen rail
           beside the field, and the result is continuous prose, which wants a
           readable measure rather than the full width. */}
        <section class="max-w-3xl">
          <QuestionBriefing client:load />
        </section>
      </>
    )}

    {mode === 'create' && (
      <>
        <header class="mb-6 max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-widest font-mono text-muted mb-2">The Audit · Create</p>
          <h1 class="font-serif text-2xl sm:text-3xl text-ink-strong leading-snug">Strengthen your draft before it ships.</h1>
          <p class="mt-2 text-sm text-muted leading-relaxed">
            The same engine, turned on your own writing: claims, warrants, and the named reasoning patterns, before a reader finds them.
          </p>
        </header>

        {/* The editor renders signed-out too (owner decision 2026-08-14): the
           analysis is free, and only saving asks for an account. The island
           handles the split — anonymous runs go to the text endpoints and
           nothing persists; signed-in runs keep the document/version flow. */}
        <StudioEditor
          client:load
          hasActiveSubscription={hasActiveSubscription}
          isSignedIn={!!session}
          initialDocId={initialDocId}
          initialTitle={initialTitle}
          initialContent={initialContent}
          initialVersionId={initialVersionId}
          initialAuditResult={initialAuditResult}
          initialCounterargResult={initialCounterargResult}
          initialExtractionResult={initialExtractionResult}
          initialCommitmentsResult={initialCommitmentsResult}
          initialCitationAuditResult={initialCitationResult}
          initialAnalyzedAt={initialAnalyzedAt}
          initialActions={initialActions}
          terminologyPreference={terminology}
          consumeHandoff={true}
        />

        <OnboardingTour client:load />
      </>
    )}
  </main>
</Base>
