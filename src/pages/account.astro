---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import { makeAuthDb } from '../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../functions/_lib/auth/sessions';
import TerminologyPicker from '../components/account/TerminologyPicker';
import ApiKeysManager from '../components/account/ApiKeysManager';
import AnalyticsConsentPicker from '../components/account/AnalyticsConsentPicker';

const authDb    = makeAuthDb(env.DB);
const session   = await getSessionFromRequest(Astro.request, authDb);

if (!session) {
  return Astro.redirect('/login');
}

const user        = await authDb.findUserById(session.user_id);
const terminology = await authDb.getTerminologyPreference(session.user_id);

const loginDate = new Date(session.created_at).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});

---
<Base title="Account - The Whetstone" canonicalPath="/account" isLoggedIn={true}>
  <main class="max-w-md mx-auto px-6 py-16">
    <h1 class="text-2xl font-semibold text-ink-strong mb-8">Your account</h1>

    <!-- Account details -->
    <div class="rounded-lg border border-hairline bg-surface divide-y divide-hairline">
      <div class="px-5 py-4">
        <p class="text-xs text-muted uppercase tracking-wide mb-1">Email</p>
        <p class="text-sm text-ink-strong">{user?.email ?? '-'}</p>
      </div>
      <div class="px-5 py-4">
        <p class="text-xs text-muted uppercase tracking-wide mb-1">Session started</p>
        <p class="text-sm text-ink-strong">{loginDate}</p>
      </div>
    </div>

    <!-- Plan -->
    <div class="mt-8">
      <h2 class="text-sm font-semibold text-ink mb-3">Plan</h2>
      <div class="rounded-lg border border-hairline bg-surface px-5 py-4">
        <p class="text-sm text-muted leading-relaxed">
          Nothing to pay. Every engine is free and the usage allowance is the same for
          everyone — three audits per rolling 24 hours. Your account is what keeps your
          drafts and version history between visits.
        </p>
      </div>
    </div>

    <!-- Display preferences -->
    <div class="mt-8">
      <h2 class="text-sm font-semibold text-ink mb-1">Display preferences</h2>
      <p class="text-xs text-muted mb-3">Choose how analytical concepts are labelled throughout the interface.</p>
      <TerminologyPicker initialPreference={terminology} client:load />
    </div>

    <!-- Analytics consent (opt-in only) -->
    <div class="mt-8">
      <h2 class="text-sm font-semibold text-ink mb-1">Analytics</h2>
      <p class="text-xs text-muted mb-3">Off by default. Opt in to send anonymous product events.</p>
      <AnalyticsConsentPicker client:load />
    </div>

    <!-- API keys -->
    <div class="mt-8">
      <h2 class="text-sm font-semibold text-ink mb-1">API access</h2>
      <p class="text-xs text-muted mb-3">
        Run the engine programmatically - integrate The Whetstone into your CMS or editorial
        pipeline. Keys draw on the same allowance as the web tool.{' '}
        <a href="/developer" class="underline hover:text-ink">View API docs →</a>
      </p>
      <ApiKeysManager client:load />
    </div>

    <!-- Feedback acknowledgement -->
    <div class="mt-8 rounded-lg border border-hairline bg-paper px-5 py-4">
      <p class="text-xs text-muted leading-relaxed">
        Your feedback shapes The Whetstone - thumbs-up and thumbs-down on findings help tune the engine over time. Thank you.
      </p>
    </div>

    <form action="/api/auth/logout" method="post" class="mt-8">
      <button
        type="submit"
        class="rounded-md border border-hairline px-4 py-2 text-sm text-ink hover:bg-paper transition-colors"
      >
        Sign out
      </button>
    </form>
  </main>
</Base>
