---
export const prerender = false;

// On-my-end workaround for feedback→gmail (email forwarding is shelved — it needs
// a Cloudflare dashboard action). This is a gated viewer that reads the
// site_feedback D1 table directly, so Daniel just checks this page. Zero external
// setup. Gated to the admin email.
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { makeAuthDb } from '../../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../../functions/_lib/auth/sessions';

const ADMIN_EMAIL = 'daniel.livingstone44@gmail.com';

const authDb  = makeAuthDb(env.DB);
const session = await getSessionFromRequest(Astro.request, authDb);
if (!session) return Astro.redirect('/login?returnTo=/admin/feedback');
const user = await authDb.findUserById(session.user_id);
if (!user || user.email !== ADMIN_EMAIL) {
  return new Response('Not found', { status: 404 });
}

interface Row {
  id: string; message: string; email: string | null;
  source_path: string | null; user_id: string | null; created_at: number;
}
const { results } = await env.DB
  .prepare('SELECT id, message, email, source_path, user_id, created_at FROM site_feedback ORDER BY created_at DESC LIMIT 200')
  .all<Row>();
const rows = results ?? [];

function fmt(ms: number): string {
  return new Date(ms).toLocaleString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
  });
}
---
<Base title="Site feedback - The Whetstone" canonicalPath="/admin/feedback" isLoggedIn={true} noAds={true}>
  <main class="max-w-2xl mx-auto px-6 pt-16 pb-24">
    <header class="mb-8">
      <p class="text-xs font-semibold tracking-widest text-accent uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl text-ink-strong mb-2">Site feedback</h1>
      <p class="text-sm text-muted">{rows.length} {rows.length === 1 ? 'entry' : 'entries'} · newest first{rows.length === 200 ? ' (showing latest 200)' : ''}</p>
    </header>

    {rows.length === 0 ? (
      <div class="rounded-xl border border-hairline bg-paper p-10 text-center">
        <p class="text-sm text-muted">No feedback yet.</p>
      </div>
    ) : (
      <ul class="space-y-4">
        {rows.map((r) => (
          <li class="rounded-lg border border-hairline bg-surface p-4">
            <p class="text-sm text-ink leading-relaxed whitespace-pre-wrap">{r.message}</p>
            <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
              <span>{fmt(r.created_at)}</span>
              {r.email && (
                <>
                  <span class="text-hairline">·</span>
                  <a href={`mailto:${r.email}`} class="text-accent hover:underline">{r.email}</a>
                </>
              )}
              {r.source_path && (
                <>
                  <span class="text-hairline">·</span>
                  <span class="font-mono text-[0.6875rem]">{r.source_path}</span>
                </>
              )}
              {r.user_id && (
                <>
                  <span class="text-hairline">·</span>
                  <span>signed in</span>
                </>
              )}
            </div>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>
