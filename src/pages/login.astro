---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import LoginForm from '../components/auth/LoginForm';
import { makeAuthDb } from '../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../functions/_lib/auth/sessions';

const db      = makeAuthDb(env.DB);
const session = await getSessionFromRequest(Astro.request, db);

const fromExtension = Astro.url.searchParams.get('from') === 'extension';

if (session && !fromExtension) {
  return Astro.redirect('/account');
}

const error = Astro.url.searchParams.get('error');

// Say why we're asking. Nothing on this site requires an account to USE it, so
// a bare "Sign in" reads as a gate that shouldn't be there. The destination the
// visitor was heading for is the reason, and it is the only honest one we have.
const returnTo = Astro.url.searchParams.get('returnTo') ?? '';
const reason =
  returnTo.startsWith('/creator/documents')            ? 'Your drafts live in your account. Sign in to see them.'
  : returnTo.includes('/audit')                        ? 'Every tool works signed out — an account is only needed to keep a draft and its revision history.'
  : '';
---
<Base title="Sign in - The Whetstone" canonicalPath="/login">
  <main class="max-w-md mx-auto px-6 py-16">

    {session && fromExtension ? (
      <div class="text-center space-y-4">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-100">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h1 class="text-2xl font-semibold text-ink-strong">Extension connected</h1>
        <p class="text-sm text-muted leading-relaxed">
          Your Whetstone account is now linked to the Chrome extension. You can close this tab and return to the extension's side panel.
        </p>
        <p class="text-xs text-muted">
          Signed in as {(await db.findUserById(session.user_id))?.email ?? 'your account'}.
        </p>
        <button
          id="close-tab-btn"
          type="button"
          class="text-xs text-accent hover:text-accent-support underline"
        >
          Close this tab
        </button>
      </div>
    ) : (
      <>
        <h1 class="text-2xl font-semibold text-ink-strong mb-2">
          {fromExtension ? 'Connect the extension' : 'Sign in'}
        </h1>
        <div class="mb-8 space-y-1.5">
          <p class="text-sm text-muted">
            {fromExtension
              ? 'Sign in to your Whetstone account to connect it to the extension. The link comes by email.'
              : reason || 'Enter your email and we\'ll send you a one-time sign-in link.'}
          </p>
          {!fromExtension && reason && (
            <p class="text-xs text-muted">Enter your email and we'll send you a one-time sign-in link.</p>
          )}
        </div>

        {error === 'invalid' && (
          <div class="mb-6 rounded-md bg-red-50 border border-red-100 px-4 py-3 text-sm text-red-700">
            That link has expired or has already been used. Please request a new one.
          </div>
        )}

        <LoginForm client:load />
      </>
    )}

  </main>
</Base>

{session && fromExtension && (
  <script>
    document.getElementById('close-tab-btn')?.addEventListener('click', () => {
      window.close();
    });
  </script>
)}
