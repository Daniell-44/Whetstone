---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { listTopics } from '../../../functions/_lib/topic/storage';
import type { StoredTopic } from '../../../functions/_lib/topic/types';

const topics = await listTopics(env.SCORECARDS, { publishedOnly: true });

// Compute spectrum counts in the frontmatter — Astro's template compiler
// misreads `<`/`<=` inside inline JSX expressions as tag openings.
function counts(t: StoredTopic) {
  let left = 0, center = 0, right = 0;
  for (const s of t.sources) {
    if (s.leaning <= -15) left++;
    else if (s.leaning >= 15) right++;
    else center++;
  }
  return { left, center, right };
}
const rows = topics.map(t => ({ topic: t, ...counts(t) }));
---
<Base
  title="Briefings — The Whetstone"
  description="Debatable questions, argued across the spectrum. Curated sources, structural audits, and the assumptions every side shares."
  canonicalPath="/topics"
>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16 sm:pb-24">
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <p class="text-xs font-semibold tracking-[0.3em] text-indigo-500 uppercase shrink-0">The Whetstone · Briefings</p>
        <div class="h-px flex-1 bg-gray-200" />
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl text-gray-900 mb-3 leading-tight">Briefings, argued across the spectrum</h1>
      <p class="text-base text-gray-500 leading-relaxed">
        Each topic gathers a few balanced sources, audits how each one argues, and surfaces what every side
        quietly assumes. Left to right, with the structure made visible.
      </p>
    </header>

    {rows.length === 0 ? (
      <div class="py-20 border-t border-gray-200 text-center">
        <p class="font-serif text-2xl text-gray-300">No briefings published yet.</p>
      </div>
    ) : (
      <ul class="divide-y divide-gray-100">
        {rows.map(({ topic: t, left, center, right }) => (
          <li>
            <a href={`/topic/${t.slug}`} class="group block py-5 sm:py-6">
              <div class="flex items-center gap-2 mb-1.5 text-[11px] text-gray-400">
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-500" />{left}</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-gray-500" />{center}</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-blue-500" />{right}</span>
                <span class="text-gray-300 mx-1">·</span>
                <span>{t.sources.length} sources</span>
              </div>
              <h2 class="font-serif text-lg sm:text-xl text-gray-900 group-hover:text-indigo-600 transition-colors leading-snug mb-1">
                {t.question}
              </h2>
              <p class="text-sm text-gray-500 leading-relaxed line-clamp-2">{t.framing}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>
