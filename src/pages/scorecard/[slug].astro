---
export const prerender = false;

import { env } from "cloudflare:workers";
import Base from '../../layouts/Base.astro';
import ScorecardView from '../../components/scorecard/Scorecard.astro';
import PositionSpectrum from '../../components/scorecard/PositionSpectrum';
import TopicTakes from '../../components/topic/TopicTakes';
import { getScorecard, listScorecards } from '../../../functions/_lib/scorecard/storage';
import { makeAuthDb } from '../../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../../functions/_lib/auth/sessions';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const scorecard = await getScorecard(env.SCORECARDS, slug);

if (!scorecard) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const session = await getSessionFromRequest(Astro.request, makeAuthDb(env.DB));
const signedIn = !!session;

// Related scorecards: same category preferred, else next 4 by date
const all = await listScorecards(env.SCORECARDS);
const related = all
  .filter(s => s.slug !== scorecard.slug)
  .sort((a, b) => {
    const sameCatA = a.category === scorecard.category ? 0 : 1;
    const sameCatB = b.category === scorecard.category ? 0 : 1;
    return sameCatA - sameCatB;
  })
  .slice(0, 4);

const baseUrl = 'https://thewhetstone.net';
const shareUrl = `${baseUrl}/scorecard/${scorecard.slug}`;
---

<Base
  title={`${scorecard.question} - Briefing | The Whetstone`}
  description={scorecard.dek}
  canonicalPath={`/scorecard/${scorecard.slug}`}
>
  <main class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-12 pb-16">

    <!-- Top nav -->
    <nav class="mb-8 flex items-center justify-between">
      <a href="/scorecards" class="text-xs text-gray-400 hover:text-gray-600 transition-colors">← All Briefings</a>
      <!-- Mobile share buttons (visible only on small screens) -->
      <div class="flex items-center gap-2 lg:hidden">
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(scorecard.question)}&url=${encodeURIComponent(shareUrl)}`}
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100"
          title="Share on X/Twitter" aria-label="Share on X/Twitter"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100"
          title="Share on LinkedIn" aria-label="Share on LinkedIn"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </nav>

    <!-- 3-column layout: ToC | content | share+related -->
    <div class="grid lg:grid-cols-12 gap-8 xl:gap-12 items-start">

      <!-- LEFT: Table of contents -->
      <aside class="hidden lg:block lg:col-span-2 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
        <p class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 mb-3">On this page</p>
        <nav class="space-y-1.5 text-xs">
          <a href="#overview" class="block text-gray-500 hover:text-gray-900 transition-colors">Overview</a>
          <a href="#positions" class="block text-gray-500 hover:text-gray-900 transition-colors">The positions</a>
          <a href="#bridge" class="block text-gray-500 hover:text-gray-900 transition-colors">Bridging warrant</a>
          <a href="#discussion" class="block text-gray-500 hover:text-gray-900 transition-colors">Discussion</a>
        </nav>
        <a href="/scorecards" class="mt-6 block text-[11px] text-gray-400 hover:text-gray-600 transition-colors">
          ← All Briefings
        </a>
      </aside>

      <!-- CENTER: bounded reading column -->
      <article class="lg:col-span-7 max-w-3xl">
        <div id="overview">
          <PositionSpectrum positions={scorecard.positions} client:load />
          <ScorecardView scorecard={scorecard} />
        </div>
        <div id="discussion">
          <TopicTakes slug={scorecard.slug} signedIn={signedIn} returnTo={`/scorecard/${scorecard.slug}`} client:load />
        </div>
      </article>

      <!-- RIGHT: share + related (sticky) -->
      <aside class="lg:col-span-3 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto space-y-6">

        <!-- Share -->
        <div class="rounded-xl border border-gray-200 bg-white p-4">
          <p class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 mb-3">Share</p>
          <div class="flex gap-2">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(scorecard.question)}&url=${encodeURIComponent(shareUrl)}`}
              target="_blank" rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center py-2 rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50 transition-colors"
              title="X/Twitter"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
              target="_blank" rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center py-2 rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50 transition-colors"
              title="LinkedIn"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <button
              onclick="navigator.clipboard.writeText(window.location.href).then(()=>{this.textContent='✓';setTimeout(()=>{this.textContent='Link'},1500)})"
              class="flex-1 py-2 rounded-md text-xs text-gray-500 hover:text-gray-900 hover:bg-gray-50 transition-colors"
              title="Copy link"
            >
              Link
            </button>
          </div>
        </div>

        <!-- Audit a similar argument -->
        <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4">
          <p class="text-xs font-semibold text-indigo-700 mb-1.5">Audit a similar argument</p>
          <p class="text-[11px] text-indigo-600 leading-relaxed mb-3">
            Paste your own text and the engine returns the same structural analysis you see here.
          </p>
          <a href="/reader" class="block w-full text-center px-3 py-2 rounded-md bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition-colors">
            Open the Reader →
          </a>
        </div>

        <!-- Cite this scorecard -->
        <div class="rounded-xl border border-gray-200 bg-white p-4">
          <p class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 mb-3">Cite this Briefing</p>
          <div class="flex flex-col gap-1.5">
            <a
              href={`/scorecard/${scorecard.slug}/citations.bib`}
              class="text-xs text-gray-500 hover:text-gray-900 transition-colors flex items-center justify-between"
              download
            >
              <span class="font-mono">.bib</span>
              <span class="text-[10px] text-gray-400">BibTeX</span>
            </a>
            <a
              href={`/scorecard/${scorecard.slug}/citations.ris`}
              class="text-xs text-gray-500 hover:text-gray-900 transition-colors flex items-center justify-between"
              download
            >
              <span class="font-mono">.ris</span>
              <span class="text-[10px] text-gray-400">EndNote, Mendeley</span>
            </a>
          </div>
        </div>

        <!-- Related scorecards -->
        {related.length > 0 && (
          <div class="rounded-xl border border-gray-200 bg-white p-4">
            <p class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 mb-3">Related</p>
            <ul class="space-y-3">
              {related.map(rel => (
                <li>
                  <a href={`/scorecard/${rel.slug}`} class="group block">
                    {rel.category && (
                      <p class="text-[9px] font-bold uppercase tracking-wider text-gray-400 mb-1">{rel.category}</p>
                    )}
                    <p class="text-xs font-medium text-gray-700 group-hover:text-indigo-700 leading-snug transition-colors">
                      {rel.question}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

      </aside>

    </div>
  </main>
</Base>
