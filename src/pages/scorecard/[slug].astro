---
export const prerender = false;

import { env } from "cloudflare:workers";
import Base from '../../layouts/Base.astro';
import ScorecardView from '../../components/scorecard/Scorecard.astro';
import { getScorecard } from '../../../functions/_lib/scorecard/storage';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const scorecard = await getScorecard(env.SCORECARDS, slug);

if (!scorecard) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<Base
  title={`${scorecard.question} — Logic Scorecard | The Whetstone`}
  description={scorecard.dek}
  canonicalPath={`/scorecard/${scorecard.slug}`}
>
  <main class="max-w-5xl mx-auto px-6 pt-16 pb-16">

    <nav class="mb-10 flex items-center justify-between">
      <a href="/scorecards" class="text-xs text-gray-400 hover:text-gray-600 transition-colors">← All Scorecards</a>
      <!-- Share buttons -->
      <div class="flex items-center gap-2">
        <span class="text-[10px] text-gray-400 uppercase tracking-wider mr-1">Share</span>
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(scorecard.question)}&url=${encodeURIComponent(`https://devils-advocate-site.daniellivingstone2005.workers.dev/scorecard/${scorecard.slug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors"
          title="Share on X/Twitter"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://devils-advocate-site.daniellivingstone2005.workers.dev/scorecard/${scorecard.slug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors"
          title="Share on LinkedIn"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <button
          onclick="navigator.clipboard.writeText(window.location.href).then(()=>{this.textContent='Copied!';setTimeout(()=>{this.textContent='Link'},1500)})"
          class="px-2 py-1 rounded-md text-[10px] font-medium text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors"
        >
          Link
        </button>
      </div>
    </nav>

    <ScorecardView scorecard={scorecard} />

  </main>
</Base>
