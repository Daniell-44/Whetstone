import QuietPage from '../../components/labs/QuietPage.astro';
---
<QuietPage
  variant="deep"
  number="3"
  name="Deep margin"
  blurb="The same margin, drawn much wider. Now the crux rows, the quoted voices and the shared premise go in with the machinery, and the flush column carries only the headline, the deck, the connecting prose, the position claims and the pull quotes. About two thirds of the page is indented."
  look="This is the calmest reading column of the three by a distance. Read the flush text alone, top to bottom, and see whether it still tells the whole story."
  risk="Both reviewers flagged the same thing independently: the crux rows are the briefing's actual thesis, and here they sit in the plane the layout has just trained you to skim past. Read 'Where they diverge' cold and ask whether you would have skipped it."
/>
