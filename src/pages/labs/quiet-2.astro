---
export const prerender = false;
import QuietPage from '../../components/labs/QuietPage.astro';
---
<QuietPage
  variant="apparatus"
  number="2"
  name="One margin"
  blurb="Everything from iteration 1, plus one thin indented margin. The argument stays flush at reading size; only the machinery that proves it steps in behind a single grey line: bylines, stakes, engine findings, the map, the poll figures, the sources. About a third of the page is indented."
  look="Scroll fast and watch the left edge. It should be mostly straight, with the margin appearing in short bursts. That shape is the claim: this is the argument, that is the apparatus."
  risk="The whole signal rests on one grey line being visible to you. Look at it on your dim laptop screen and on your phone in daylight. If you have to hunt for the line, iteration 1 is the honest answer, not a darker line."
/>
