<style is:global>
 .fl{
    --paper:#F3F4F1; --surface:#FBFBF9; --ink:#24272B; --ink-strong:#121417;
    --muted:#5C6167; --hairline:#D7D9D3;
    --serif: Georgia, 'Times New Roman', serif;
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  } .fl *{box-sizing:border-box} .fl{margin:0;background:var(--paper);color:var(--ink);font-family:var(--serif);
       padding:40px 20px 80px;line-height:1.6} .fl .wrap{max-width:60rem;margin:0 auto} .fl h1{font-size:30px;color:var(--ink-strong);font-weight:400;margin:0 0 6px} .fl .kicker{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 4px} .fl .lede{font-size:17px;color:var(--ink);max-width:44rem;margin:0 0 8px} .fl .note{font-size:14px;color:var(--muted);max-width:44rem} .fl hr.rule{border:0;border-top:1px solid var(--ink-strong);margin:44px 0 22px} .fl h2{font-family:var(--serif);font-size:22px;color:var(--ink-strong);font-weight:400;margin:0 0 4px} .fl .verdictline{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 14px} .fl /* ---------- the card shells ---------- */
  .card{background:var(--surface);border:1px solid var(--hairline);padding:20px 22px;margin:18px 0} .fl .card.site{max-width:42rem} .fl .card.panel{max-width:26rem} .fl .card.narrow{max-width:22rem} .fl .sizetag{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:22px 0 0} .fl .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 8px} .fl .q{font-family:var(--serif);font-size:18px;font-weight:600;color:var(--ink-strong);line-height:1.3;margin:0 0 18px} .fl .card.panel .q{font-size:17px} .fl /* ---------- A: beam + struts ---------- */
