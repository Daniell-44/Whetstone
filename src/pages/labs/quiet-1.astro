---
export const prerender = false;
import QuietPage from '../../components/labs/QuietPage.astro';
---
<QuietPage
  variant="none"
  number="1"
  name="Quiet"
  blurb="Every four-sided box, fill, tint, chip border and duplicate rule is gone. One face for everything read, one label style for everything else, no coloured text, one disclosure grammar. Nothing is indented and there is not a single vertical line on the page. 34 separator systems become 3."
  look="Read from the top at your normal pace and notice how often you stop. Nothing has been removed, so if it still feels heavy the problem is not the boxes."
  risk="With no margin, a stake line and an engine finding sit in the same plane as the argument. Ask yourself whether you can still tell what the briefing is claiming from what the machine noticed."
/>
