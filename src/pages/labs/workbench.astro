---
// The Read/Create workbench — graduating from prototype to production
// (Stage 3 port: "Workbench + satellites"). Never linked, never indexed;
// must be dropped or gated before any production deploy.
//
// The page now reads the REAL session (port slice 2) so Create can persist
// documents/versions for signed-in users. The dev tier switcher inside the
// island initialises from the real tier and stays as a display override for
// feeling the gates.
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Workbench from '../../components/labs/Workbench';
import { makeAuthDb } from '../../../functions/_lib/auth/db';
import { makeBillingDb } from '../../../functions/_lib/billing/subscription';
import { makeWorkspaceDb } from '../../../functions/_lib/workspaces/db';
import { userHasActiveSubscriptionViaWorkspace } from '../../../functions/_lib/workspaces/permissions';
import { getSessionFromRequest } from '../../../functions/_lib/auth/sessions';

const authDb  = makeAuthDb(env.DB);
const session = await getSessionFromRequest(Astro.request, authDb);
const realSignedIn = session !== null;
const realPro = session
  ? await userHasActiveSubscriptionViaWorkspace(makeBillingDb(env.DB), makeWorkspaceDb(env.DB), session.user_id)
  : false;
---
<Base
  title="Workbench (labs) - The Whetstone"
  description="Internal prototype."
  canonicalPath="/labs/workbench"
  noAds={true}
>
  {/* Must never be indexed even though it's reachable in production. */}
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10 pb-12">
    {/* Freeze banner: the merge shipped to /audit (2026-07-19); this page is
       kept as a design artifact only. Apparatus style, no redline. */}
    <div class="mb-6 border border-hairline bg-paper p-4">
      <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-1">Design artifact · Frozen 2026-07-19</p>
      <p class="text-sm text-ink leading-relaxed">
        The merged Read/Create surface now lives at <a href="/audit" class="text-accent-support underline hover:text-accent-support/80">/audit</a>. This prototype is no longer maintained.
      </p>
    </div>
    <header class="mb-6">
      <p class="text-xs font-mono font-semibold uppercase tracking-widest text-muted mb-2">Labs · the merge workbench · not linked anywhere</p>
      <h1 class="font-serif text-2xl sm:text-3xl text-ink-strong leading-tight">The Audit, with a Read / Create toggle</h1>
      <p class="mt-2 text-sm text-muted leading-relaxed max-w-2xl">
        One surface, two postures: Read audits someone else's argument, Create audits your own draft.
        Both postures now run the real engines; signed-in Create saves documents and versions.
        The dev tier switcher (top right) still overrides the display gates.
      </p>
    </header>
    <Workbench client:load realSignedIn={realSignedIn} realPro={realPro} />
  </main>
</Base>
