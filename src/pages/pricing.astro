---
export const prerender = false;
// Paid tiers retired 2026-09: every engine is free and the allowance is the
// same for everyone, so there is nothing left to price. /pricing 301s to the
// About page, which now carries the "what it costs" line. Kept as a redirect
// so saved links and search results still resolve.
//
// The billing code (webhook, portal, subscription schema) is left dormant
// rather than deleted, so reintroducing a paid tier does not mean rebuilding
// it. /api/billing/checkout refuses new sessions — see that route.
return Astro.redirect('/about', 301);
---
