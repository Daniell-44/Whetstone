---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import CheckoutButton from '../components/billing/CheckoutButton';
import PricingTier from '../components/pricing/PricingTier.astro';
import { makeAuthDb } from '../../functions/_lib/auth/db';
import { makeBillingDb } from '../../functions/_lib/billing/subscription';
import { getSessionFromRequest } from '../../functions/_lib/auth/sessions';
import { makeWorkspaceDb } from '../../functions/_lib/workspaces/db';
import { userHasActiveSubscriptionViaWorkspace } from '../../functions/_lib/workspaces/permissions';

const authDb      = makeAuthDb(env.DB);
const billingDb   = makeBillingDb(env.DB);
const workspaceDb = makeWorkspaceDb(env.DB);
const session     = await getSessionFromRequest(Astro.request, authDb);
const isLoggedIn = !!session;
const hasSubscription = session
  ? await userHasActiveSubscriptionViaWorkspace(billingDb, workspaceDb, session.user_id)
  : false;

const checkoutCanceled = Astro.url.searchParams.get('checkout') === 'canceled';
---
<Base
  title="Pricing - The Whetstone"
  description="Free structural audit for readers. Solo plan for writers at A$33/month. Studio for teams from A$95/month."
  canonicalPath="/pricing"
  isLoggedIn={isLoggedIn}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 sm:pt-20 pb-16 sm:pb-24">

    <header class="mb-12 text-center">
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 leading-tight mb-4">
        Pricing
      </h1>
      <p class="text-lg text-gray-500 max-w-xl mx-auto">
        The audit engine is free for readers. Creators pay for the tools that make arguments stronger.
      </p>
    </header>

    {checkoutCanceled && (
      <div class="mb-8 rounded-lg bg-amber-50 border border-amber-200 px-5 py-4 max-w-md mx-auto">
        <p class="text-sm text-amber-800">Checkout was cancelled - no charge was made.</p>
      </div>
    )}

    <!-- Three-tier grid - collapsible feature lists on mobile -->
    <div class="grid md:grid-cols-3 gap-0 border border-gray-200 rounded-xl overflow-hidden bg-white divide-y md:divide-y-0 md:divide-x divide-gray-200">

      <PricingTier
        label="Free"
        labelColour="text-gray-400"
        price="$0"
        subtext="Sign-up required for Studio"
        features={[
          'Toulmin decomposition + 26 fallacy patterns',
          'Loaded language + unstated warrants',
          'Argument extraction + structure diagram',
          'Presupposition, rhetorical mode, epistemic humility',
          'Disagreement quality, structural incentive',
          '5 audits per day (3 without an account)',
        ]}
        featureColour="text-gray-300"
      >
        <a slot="cta" href="/reader" class="block w-full py-2.5 px-6 rounded-lg text-sm font-semibold text-center text-gray-700 border border-gray-200 hover:bg-gray-50 transition-colors">
          Use the Reader
        </a>
      </PricingTier>

      <PricingTier
        label="Solo"
        labelColour="text-amber-600"
        price="A$33"
        priceUnit="/mo"
        subtext="Cancel anytime"
        highlighted={true}
        accentBar="bg-amber-500"
        features={[
          'Everything in Free',
          'Counterargument generation (steelman)',
          'Philosophical commitments',
          'Citation audit (URL fetching)',
          'Evidence-weighted likelihood (Semantic Scholar)',
          'Transcript audit (YouTube + speeches)',
          'Cross-document audit (self-contradiction detection)',
          'Document persistence & versions',
          'Inline highlights (Grammarly-style)',
          '100 audits per month (add blocks for more)',
          'API access',
        ]}
        featureColour="text-amber-500"
      >
        <Fragment slot="cta">
          {!isLoggedIn ? (
            <a href="/login?returnTo=/pricing" class="block w-full py-2.5 px-6 rounded-lg text-sm font-semibold text-center bg-amber-500 text-white hover:bg-amber-600 transition-colors">
              Sign in to subscribe
            </a>
          ) : hasSubscription ? (
            <div class="space-y-2">
              <div class="rounded-lg bg-green-50 border border-green-200 px-4 py-2.5 text-center">
                <p class="text-sm font-medium text-green-800">Subscribed</p>
              </div>
              <button id="pricing-portal-btn" type="button" class="w-full py-2 px-6 rounded-lg text-sm text-gray-600 border border-gray-200 hover:bg-gray-50 transition-colors">
                Manage →
              </button>
            </div>
          ) : (
            <CheckoutButton client:load />
          )}
        </Fragment>
      </PricingTier>

      <PricingTier
        label="Studio"
        labelColour="text-violet-600"
        price="A$95"
        priceUnit="/mo"
        subtext="Up to 5 seats"
        features={[
          'Everything in Solo',
          'Multi-seat workspace (up to 5)',
          'Shared document library',
          'Priority API access',
          'Higher monthly audit limit',
        ]}
        featureColour="text-violet-500"
      >
        <a slot="cta" href="mailto:daniel.livingstone44@gmail.com?subject=Whetstone Studio tier" class="block w-full py-2.5 px-6 rounded-lg text-sm font-semibold text-center text-violet-700 border border-violet-200 hover:bg-violet-50 transition-colors">
          Contact us
        </a>
      </PricingTier>

    </div>

    <!-- Newsroom callout -->
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-400">
        Need 10+ seats, admin dashboard, or CMS integration?{' '}
        <a href="mailto:daniel.livingstone44@gmail.com?subject=Whetstone Newsroom tier" class="text-indigo-600 hover:text-indigo-800 font-medium">
          Talk to us about Newsroom pricing →
        </a>
      </p>
    </div>

  </main>
</Base>

{isLoggedIn && hasSubscription && (
  <script>
    document.getElementById('pricing-portal-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('pricing-portal-btn') as HTMLButtonElement | null;
      if (btn) btn.textContent = 'Opening…';
      try {
        const res  = await fetch('/api/billing/portal', { method: 'POST' });
        const data = await res.json() as { ok: boolean; url?: string };
        if (data.ok && data.url) window.location.assign(data.url);
      } catch {
        if (btn) btn.textContent = 'Manage →';
      }
    });
  </script>
)}
