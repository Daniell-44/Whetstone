---
import Base from '../../layouts/Base.astro';
import BriefingArticle from '../../components/briefing/BriefingArticle.astro';
import EmailCapture from '../../components/capture/EmailCapture';
import { getAllBriefings } from '../../lib/briefings';

export function getStaticPaths() {
  return getAllBriefings().map((b) => ({ params: { slug: b.slug }, props: { briefing: b } }));
}

const { briefing } = Astro.props;

// Related: same category preferred, then newest.
const related = getAllBriefings()
  .filter((b) => b.slug !== briefing.slug)
  .sort((a, b) => {
    const sameA = a.category === briefing.category ? 0 : 1;
    const sameB = b.category === briefing.category ? 0 : 1;
    return sameA - sameB || b.publishedDate.localeCompare(a.publishedDate);
  })
  .slice(0, 4);

const hasPositions = briefing.blocks.some((bl) => bl.type === 'position');
const hasShared    = briefing.blocks.some((bl) => bl.type === 'shared');
const hasEditor    = briefing.blocks.some((bl) => bl.type === 'editorView' || bl.type === 'takes');

// Explainers get a pared chassis: essay + one related-briefing link. No ToC,
// no share/cite rail, no audit CTAs — the full apparatus belongs to briefings.
const isExplainer = briefing.kind === 'explainer';

const shareUrl = `https://thewhetstone.review/briefing/${briefing.slug}`;
const X_PATH  = 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z';
const LI_PATH = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

// SEO: a real meta description from the first substantive text block beats
// "A briefing on: <question>". Cut on a WORD boundary (the old hard slice(152)
// truncated mid-word, e.g. "...unstated assumpti…", which reads as broken in
// the SERP snippet and the social-share body), and drop a trailing dangling
// article/preposition so it never ends on "the"/"of".
function trimToWord(t: string, max = 155): string {
  if (t.length <= max) return t;
  let cut = t.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  if (lastSpace > 0) cut = cut.slice(0, lastSpace);
  cut = cut.replace(/[\s,;:]+$/, '').replace(/\s+\b(a|an|the|of|to|in|on|and|or|for|with|that|which|how)$/i, '');
  return cut + '…';
}
function metaDescription(): string {
  for (const bl of briefing.blocks) {
    if (bl.type === 'landscape' || bl.type === 'prose') {
      const t = bl.text.replace(/\s+/g, ' ').trim();
      if (t.length > 40) return trimToWord(t);
    }
  }
  return `${briefing.question} The strongest positions, each with a structural audit of its reasoning.`;
}
const desc     = metaDescription();
// Share image: a curated real cover wins; otherwise the per-briefing card that
// scripts/generate-og.ts renders at build time (chained into `pnpm build`, so
// /og/<slug>.png exists for every briefing — safe to reference unconditionally).
// A `/placeholder-*` cover is a debug asset and never ships as the share image.
const hasRealImage = briefing.image && !briefing.image.includes('/placeholder-');
const ogImagePath  = hasRealImage ? briefing.image! : `/og/${briefing.slug}.png`;
const ogImage      = `https://thewhetstone.review${ogImagePath}`;

// Article structured data (schema.org/Article) — helps the briefing rank as a
// citable analytical piece rather than a generic page. Rendered as JSON-LD in
// the head via the Base "head" slot.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type':    'Article',
  headline:    briefing.question,
  description: desc,
  datePublished: briefing.publishedDate,
  dateModified:  briefing.publishedDate,
  author:    { '@type': 'Organization', name: 'The Whetstone', url: 'https://thewhetstone.review' },
  publisher: { '@type': 'Organization', name: 'The Whetstone', logo: { '@type': 'ImageObject', url: 'https://thewhetstone.review/icon-512.png' } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': shareUrl },
  image: ogImage,
  ...(briefing.category ? { articleSection: briefing.category } : {}),
};
---
<Base
  title={`${briefing.question} — The Whetstone`}
  description={desc}
  ogType="article"
  ogImage={ogImagePath}
  canonicalPath={`/briefing/${briefing.slug}`}
  hideFooterCapture={true}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <main class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-12 pb-16">

    <!-- Top nav -->
    <nav class="mb-8 flex items-center justify-between">
      <a href="/" class="text-xs text-muted hover:text-accent transition-colors">← Briefings</a>
      {!isExplainer && <div class="flex items-center gap-2 lg:hidden">
        {/* Native share sheet first (where briefing links actually travel:
           WhatsApp/Messages), clipboard fallback. X/LinkedIn stay as
           direct targets. */}
        <button
          onclick="if(navigator.share){navigator.share({title:document.title,url:window.location.href}).catch(()=>{})}else{navigator.clipboard.writeText(window.location.href).then(()=>{const s=this.querySelector('span');if(s){s.textContent='✓';setTimeout(()=>{s.textContent='Share'},1500)}})}"
          class="inline-flex items-center justify-center gap-1.5 min-h-[44px] px-3 rounded-md text-xs font-medium text-muted hover:text-accent hover:bg-paper"
          title="Share" aria-label="Share this briefing"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12v7a1 1 0 001 1h14a1 1 0 001-1v-7M16 6l-4-4-4 4M12 2v13"/></svg>
          <span>Share</span>
        </button>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(briefing.question)}&url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-md text-muted hover:text-accent hover:bg-paper" title="Share on X/Twitter" aria-label="Share on X/Twitter">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={X_PATH}/></svg>
        </a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-md text-muted hover:text-accent hover:bg-paper" title="Share on LinkedIn" aria-label="Share on LinkedIn">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={LI_PATH}/></svg>
        </a>
      </div>}
    </nav>

    {/* Explainer chassis: the essay plus one related-briefing link. No ToC,
       no share/cite rail, no audit CTAs. Briefings keep the full 3-column
       layout (ToC | content | share+related). */}
    {isExplainer ? (
      <div class="max-w-[36rem] mx-auto">
        <BriefingArticle briefing={briefing} />
        <div class="mt-12 pt-8 border-t border-hairline">
          <EmailCapture
            client:visible
            source="briefing"
            heading="New briefings by email"
            sub="When one publishes. Nothing else."
          />
        </div>
        {related[0] && (
          <div class="mt-12 pt-8 border-t border-hairline">
            <span class="block font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-2">Related briefing</span>
            <a href={`/briefing/${related[0].slug}`} class="font-serif text-base text-ink-strong hover:text-accent-support transition-colors leading-snug">{related[0].question}</a>
          </div>
        )}
      </div>
    ) : (
    <div class="grid lg:grid-cols-12 gap-8 xl:gap-12 items-start">

      {/* LEFT: Table of contents */}
      <aside class="hidden lg:block lg:col-span-2 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">On this page</p>
        <nav class="space-y-1.5 text-xs">
          <a href="#overview" class="block text-muted hover:text-accent transition-colors">Overview</a>
          {hasPositions && <a href="#positions" class="block text-muted hover:text-accent transition-colors">The positions</a>}
          {hasShared && <a href="#shared" class="block text-muted hover:text-accent transition-colors">Shared assumption</a>}
          {hasEditor && <a href="#discussion" class="block text-muted hover:text-accent transition-colors">Editor's view</a>}
        </nav>
        <a href="/" class="mt-6 block text-xs text-muted hover:text-accent transition-colors">← All Briefings</a>
      </aside>

      {/* CENTER */}
      <div class="lg:col-span-7">
        <BriefingArticle briefing={briefing} />

        {/* End-of-article email capture: the list lives in our own D1 and
           nothing is sent until a sending address exists. */}
        <div class="mt-12 pt-8 border-t border-hairline">
          <EmailCapture
            client:visible
            source="briefing"
            heading="New briefings by email"
            sub="When one publishes. Nothing else."
          />
        </div>

        {/* End-of-briefing next step (D1-B): no dead ends. One next-briefing
           link plus the page's single footer CTA; the per-audit chips above
           are the only other route into the tool. */}
        <div class="mt-12 pt-8 border-t border-hairline">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-4">Next</p>
          <div class="grid sm:grid-cols-2 gap-4">
            {related[0] && (
              <a href={`/briefing/${related[0].slug}`} class="group block rounded-md border border-hairline bg-surface p-4 hover:border-accent-support/40 transition-all">
                <p class="text-xs font-semibold uppercase tracking-widest text-accent-support mb-1.5">Another briefing</p>
                <p class="font-serif text-base text-ink-strong group-hover:text-accent-support transition-colors leading-snug">{related[0].question}</p>
              </a>
            )}
            <div class="rounded-md border border-hairline bg-surface p-4 flex flex-col justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-1.5">Run the engine yourself</p>
                <p class="text-sm text-ink leading-relaxed">The same audit that produced the cards above is free on any text.</p>
              </div>
              <a href="/audit" class="text-sm font-semibold text-accent-support hover:underline">Open the Audit →</a>
            </div>
          </div>
        </div>
      </div>

      {/* RIGHT: share + related (sticky) */}
      <aside class="lg:col-span-3 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto space-y-6">

        {/* Share */}
        <div class="rounded-md border border-hairline bg-surface p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Share</p>
          <div class="flex gap-2">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(briefing.question)}&url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center py-2 rounded-md text-muted hover:text-accent hover:bg-paper transition-colors" title="X/Twitter" aria-label="Share on X/Twitter">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={X_PATH}/></svg>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center py-2 rounded-md text-muted hover:text-accent hover:bg-paper transition-colors" title="LinkedIn" aria-label="Share on LinkedIn">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={LI_PATH}/></svg>
            </a>
            <button onclick="navigator.clipboard.writeText(window.location.href).then(()=>{this.textContent='✓';setTimeout(()=>{this.textContent='Link'},1500)})" class="flex-1 py-2 rounded-md text-xs text-muted hover:text-accent hover:bg-paper transition-colors" title="Copy link">Link</button>
          </div>
        </div>

        {/* Cite this briefing */}
        <div class="rounded-md border border-hairline bg-surface p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Cite this Briefing</p>
          <div class="flex flex-col gap-1.5">
            <a href={`/briefing/${briefing.slug}/citations.bib`} class="text-xs text-muted hover:text-accent transition-colors flex items-center justify-between" download>
              <span class="font-mono">.bib</span>
              <span class="text-xs text-muted">BibTeX</span>
            </a>
            <a href={`/briefing/${briefing.slug}/citations.ris`} class="text-xs text-muted hover:text-accent transition-colors flex items-center justify-between" download>
              <span class="font-mono">.ris</span>
              <span class="text-xs text-muted">EndNote, Mendeley</span>
            </a>
          </div>
        </div>

        {/* Related briefings. Desktop-only: the Next block already offers the
           top related briefing on mobile. */}
        {related.length > 0 && (
          <div class="hidden lg:block rounded-md border border-hairline bg-surface p-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Related</p>
            <ul class="space-y-3">
              {related.map((rel) => (
                <li>
                  <a href={`/briefing/${rel.slug}`} class="group block">
                    {rel.category && (
                      <p class="text-[9px] font-bold uppercase tracking-wider text-muted mb-1">{rel.category}</p>
                    )}
                    <p class="text-xs font-medium text-ink group-hover:text-accent leading-snug transition-colors">{rel.question}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

      </aside>

    </div>
    )}
  </main>
</Base>
