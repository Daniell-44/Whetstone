---
import Base from '../layouts/Base.astro';
---
<Base
  title="The Whetstone — sharpen your thinking against every argument"
  description="A tool for thinking more carefully about arguments. Devil's Advocate for readers; Creator Studio for writers."
  canonicalPath="/"
>
  <main class="max-w-3xl mx-auto px-6 pt-24 pb-16">

    <!-- Wordmark + tagline -->
    <header class="mb-16">
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 leading-tight mb-3">
        The Whetstone.
      </h1>
      <p class="text-xl text-gray-500 leading-relaxed max-w-xl">
        A tool for thinking more carefully about arguments.
      </p>
    </header>

    <!-- Two-card section -->
    <section class="grid sm:grid-cols-2 gap-5 mb-20">

      <!-- Reader card -->
      <a
        href="/reader"
        class="group block p-6 rounded-xl border border-indigo-100 bg-white hover:border-indigo-300 hover:shadow-sm transition-all"
      >
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-semibold tracking-widest text-indigo-500 uppercase">Reader</span>
          <span class="text-xs text-indigo-300">→</span>
        </div>
        <h2 class="font-serif text-xl text-gray-900 mb-2 group-hover:text-indigo-900 transition-colors">
          Devil's Advocate
        </h2>
        <p class="text-sm text-gray-500 leading-relaxed">
          Analyse arguments you read. Highlight text on any page and see its structure, its assumptions, and the strongest case against it.
        </p>
        <div class="mt-4 text-xs text-indigo-400 group-hover:text-indigo-600 transition-colors font-medium">
          Chrome extension — coming to the Web Store
        </div>
      </a>

      <!-- Creator card -->
      <a
        href="/creator"
        class="group block p-6 rounded-xl border border-amber-100 bg-white hover:border-amber-300 hover:shadow-sm transition-all"
      >
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-semibold tracking-widest text-amber-600 uppercase">Creator</span>
          <span class="text-xs text-amber-300">→</span>
        </div>
        <h2 class="font-serif text-xl text-gray-900 mb-2 group-hover:text-amber-900 transition-colors">
          Creator Studio
        </h2>
        <p class="text-sm text-gray-500 leading-relaxed">
          Stress-test arguments you write. Toulmin breakdown, reasoning-pattern flags, and the strongest objections your draft doesn't engage with.
        </p>
        <div class="mt-4 text-xs text-amber-500 group-hover:text-amber-700 transition-colors font-medium">
          In development — design partners onboarding now
        </div>
      </a>

    </section>

    <!-- Abstract whetstone mark -->
    <div class="flex justify-center opacity-15" aria-hidden="true">
      <svg width="80" height="36" viewBox="0 0 80 36" fill="none">
        <path d="M2 32 L78 22 L78 14 L2 4 Z" fill="#4F46E5" />
      </svg>
    </div>

  </main>
</Base>
