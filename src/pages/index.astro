---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import AuditForm from '../components/audit/AuditForm';
import HeroHeadline from '../components/reader/HeroHeadline';
import PositionSpectrum from '../components/scorecard/PositionSpectrum.astro';
import { listScorecards } from '../../functions/_lib/scorecard/storage';
import type { Scorecard } from '../../functions/_lib/scorecard/types';
import { briefings } from '../data/briefings';
import type { BriefingArticle } from '../../functions/_lib/briefing/types';

function briefingDek(b: BriefingArticle): string {
  const l = b.blocks.find((bl) => bl.type === 'landscape');
  return l && 'text' in l ? l.text : '';
}

function briefingCard(b: BriefingArticle) {
  const leaningById: Record<string, number> = Object.fromEntries(b.sources.map((s) => [s.id, s.leaning]));
  const positions = b.blocks.flatMap((bl) =>
    bl.type === 'position' ? [{ label: bl.label, leaning: leaningById[bl.sourceId] ?? 0 }] : [],
  );
  const shared = b.blocks.find((bl) => bl.type === 'shared');
  const auditFound = shared && 'text' in shared ? shared.text : briefingDek(b);
  return { positions, auditFound, axis: b.spectrumAxis };
}
import { makeAuthDb } from '../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../functions/_lib/auth/sessions';
import { makeBillingDb } from '../../functions/_lib/billing/subscription';
import { makeWorkspaceDb } from '../../functions/_lib/workspaces/db';
import { userHasActiveSubscriptionViaWorkspace } from '../../functions/_lib/workspaces/permissions';

// Scorecards superseded by an article-format briefing — hidden from the feed so
// they don't double-appear. (Remove the scorecard data entirely once migrated.)
const SUPERSEDED_SCORECARDS = new Set(['minimum-wage-employment', 'ai-creative-jobs']);
const scorecards = (await listScorecards(env.SCORECARDS)).filter((sc) => !SUPERSEDED_SCORECARDS.has(sc.slug));

// Deeper lenses on the Reader are Pro-gated; detect subscription for the teaser.
const session = await getSessionFromRequest(Astro.request, makeAuthDb(env.DB));
const isPro = session
  ? await userHasActiveSubscriptionViaWorkspace(makeBillingDb(env.DB), makeWorkspaceDb(env.DB), session.user_id)
  : false;

// Category tag colours
const CATEGORY_STYLES: Record<string, { bg: string; text: string; chip: string }> = {
  politics:    { bg: 'bg-red-600',     text: 'text-white', chip: 'bg-red-100 text-red-700' },
  economics:   { bg: 'bg-emerald-600', text: 'text-white', chip: 'bg-emerald-100 text-emerald-700' },
  science:     { bg: 'bg-blue-600',    text: 'text-white', chip: 'bg-blue-100 text-blue-700' },
  technology:  { bg: 'bg-violet-600',  text: 'text-white', chip: 'bg-violet-100 text-violet-700' },
  health:      { bg: 'bg-pink-600',    text: 'text-white', chip: 'bg-pink-100 text-pink-700' },
  culture:     { bg: 'bg-amber-600',   text: 'text-white', chip: 'bg-amber-100 text-amber-700' },
  philosophy:  { bg: 'bg-indigo-600',  text: 'text-white', chip: 'bg-indigo-100 text-indigo-700' },
  law:         { bg: 'bg-gray-700',    text: 'text-white', chip: 'bg-gray-200 text-gray-700' },
  environment: { bg: 'bg-green-600',   text: 'text-white', chip: 'bg-green-100 text-green-700' },
  education:   { bg: 'bg-sky-600',     text: 'text-white', chip: 'bg-sky-100 text-sky-700' },
};

const TAG_COLOURS = [
  { bg: 'bg-indigo-600',  text: 'text-white' },
  { bg: 'bg-rose-600',    text: 'text-white' },
  { bg: 'bg-emerald-600', text: 'text-white' },
];

// Per-card audit metadata, derived from the scorecard itself (no new fields).
const POSITION_CHIP = [
  'bg-sky-50 text-sky-700',
  'bg-rose-50 text-rose-700',
  'bg-amber-50 text-amber-700',
  'bg-emerald-50 text-emerald-700',
];

// Solid dot palette for the position spectrum — must match PositionSpectrum.astro.
const SPECTRUM_DOT = ['bg-sky-600', 'bg-rose-600', 'bg-amber-600', 'bg-emerald-600', 'bg-violet-600'];

function cardMeta(sc: Scorecard) {
  const positionCount = sc.positions?.length ?? 0;
  const sourceCount   = (sc.positions ?? []).reduce((n, p) => n + (p.sources?.length ?? 0), 0);
  // The cross-cutting finding makes the best "Audit found —" line; dek is the fallback.
  const auditFound    = (sc.metaAnalysis?.bridgingWarrant ?? sc.dek ?? '').trim();
  return { positionCount, sourceCount, auditFound };
}

const categoryCounts: Record<string, number> = {};
for (const sc of scorecards) {
  if (sc.category) categoryCounts[sc.category] = (categoryCounts[sc.category] ?? 0) + 1;
}
const presentCategories = Object.keys(categoryCounts).sort();
---
<Base
  title="The Whetstone - audit any argument"
  description="Paste any text or drop a URL. See the structure behind the argument: claims, evidence, where the logic breaks down, and the strongest opposing case. Free to try."
  canonicalPath="/"
>
  <main class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10 pb-12 sm:pb-24">

    <!-- Hero -->
    <header class="mb-10 sm:mb-12 pt-2">
      <HeroHeadline client:load />
    </header>

    <!-- Audit form -->
    <section class="mb-12 sm:mb-16 max-w-4xl mx-auto">
      <AuditForm isPro={isPro} client:load />
    </section>

    <!-- Scorecards section with left rail -->
    <section>
      <div class="flex items-center gap-4 mb-6 sm:mb-8">
        <h2 class="font-serif text-xl sm:text-2xl text-gray-900 shrink-0">Briefings</h2>
        <div class="h-px flex-1 bg-gray-200" />
        <a href="/scorecards" class="text-xs text-indigo-600 hover:text-indigo-800 transition-colors font-medium shrink-0">
          View all →
        </a>
      </div>

      {scorecards.length === 0 ? (
        <div class="py-20 border-t border-gray-200 text-center">
          <p class="font-serif text-2xl text-gray-300">No scorecards published yet.</p>
        </div>
      ) : (
        <div class="flex flex-col lg:flex-row gap-8">

          <!-- Left filter rail (desktop only) -->
          <aside class="hidden lg:block w-56 shrink-0 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
            <p class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 mb-3">Browse</p>
            <nav class="space-y-1">
              <a href="#all" class="flex items-center justify-between px-3 py-2 rounded-md text-sm font-medium bg-gray-100 text-gray-900">
                <span>All</span>
                <span class="text-[10px] text-gray-500">{scorecards.length}</span>
              </a>
              {presentCategories.map(cat => (
                <a
                  href={`#${cat}`}
                  class="block px-3 py-2 rounded-md text-sm text-gray-500 hover:bg-gray-50 hover:text-gray-800 transition-colors capitalize"
                >
                  {cat}
                </a>
              ))}
            </nav>

            <div class="mt-6 pt-6 border-t border-gray-200">
              <p class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 mb-3">About</p>
              <p class="text-xs text-gray-500 leading-relaxed">
                Each scorecard is an audited argument - claim, evidence, reasoning, and where it breaks down.
              </p>
              <a href="/how-it-works" class="block mt-3 text-xs text-indigo-600 hover:text-indigo-800 font-medium">
                How scorecards work →
              </a>
            </div>
          </aside>

          <!-- Mobile category strip -->
          <div class="lg:hidden flex gap-1.5 overflow-x-auto -mx-4 px-4 pb-2 scrollbar-thin">
            <a href="#all" class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium bg-gray-100 text-gray-900">
              All ({scorecards.length})
            </a>
            {presentCategories.map(cat => (
              <a href={`#${cat}`} class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium bg-gray-50 text-gray-500 capitalize">
                {cat} ({categoryCounts[cat]})
              </a>
            ))}
          </div>

          <!-- Main feed — width-capped and centred in the remaining space so the
               page doesn't read as half-empty on wide screens. -->
          <div class="min-w-0 w-full max-w-3xl mx-auto">

            <!-- Article-format briefings (new) — lead the feed -->
            {briefings.length > 0 && (
              <div class="grid sm:grid-cols-2 gap-4 mb-8">
                {briefings.map((b, idx) => {
                  const card = briefingCard(b);
                  return (
                    <a
                      href={`/briefing/${b.slug}`}
                      class={`group block bg-white border border-gray-200 rounded-lg p-5 sm:p-6 hover:border-gray-300 hover:shadow-sm transition-all ${idx === 0 ? 'sm:col-span-2' : ''}`}
                    >
                      {b.image && (
                        <img src={b.image} alt="" loading="lazy" class={`w-full ${idx === 0 ? 'h-44' : 'h-28'} object-cover rounded-md mb-4`} />
                      )}
                      <div class="flex items-center gap-2 mb-2.5 flex-wrap">
                        {b.category && CATEGORY_STYLES[b.category] ? (
                          <span class={`inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${CATEGORY_STYLES[b.category!].bg} ${CATEGORY_STYLES[b.category!].text}`}>
                            {b.category}
                          </span>
                        ) : (
                          <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-indigo-600 text-white">Briefing</span>
                        )}
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-medium">{card.positions.length} positions</span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-medium">{b.sources.length} sources</span>
                      </div>
                      <h3 class="font-serif text-lg sm:text-xl text-gray-900 group-hover:text-indigo-600 transition-colors leading-snug mb-2">
                        {b.question}
                      </h3>
                      <p class="text-sm text-gray-500 leading-relaxed line-clamp-2 mb-3">
                        <span class="font-medium text-gray-400">Audit found</span> — {card.auditFound}
                      </p>
                      {card.positions.length > 0 && (
                        <div>
                          <PositionSpectrum positions={card.positions} axis={card.axis} compact />
                          <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-1.5">
                            {card.positions.map((p, i) => (
                              <span class="inline-flex items-center gap-1 text-[11px] text-gray-500">
                                <span class={`inline-flex items-center justify-center w-3.5 h-3.5 rounded-full text-white text-[8px] font-semibold ${SPECTRUM_DOT[i % SPECTRUM_DOT.length]}`}>{i + 1}</span>
                                {p.label}
                              </span>
                            ))}
                          </div>
                        </div>
                      )}
                    </a>
                  );
                })}
              </div>
            )}

            <!-- Lead story -->
            {scorecards.length > 0 && (
              <a
                href={`/scorecard/${scorecards[0].slug}`}
                class="group block border-b border-gray-200 py-6 sm:py-10 mb-8"
              >
                <div class="max-w-4xl">
                  <div class="flex items-center gap-3 mb-4">
                    {scorecards[0].category && CATEGORY_STYLES[scorecards[0].category] ? (
                      <span class={`inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider ${CATEGORY_STYLES[scorecards[0].category!].bg} ${CATEGORY_STYLES[scorecards[0].category!].text}`}>
                        {scorecards[0].category}
                      </span>
                    ) : (
                      <span class={`inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider ${TAG_COLOURS[0].bg} ${TAG_COLOURS[0].text}`}>
                        Featured
                      </span>
                    )}
                    <div class="flex items-center gap-1.5">
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-medium">{scorecards[0].positions?.length ?? 0} positions</span>
                      {cardMeta(scorecards[0]).sourceCount > 0 && (
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-medium">{cardMeta(scorecards[0]).sourceCount} sources</span>
                      )}
                    </div>
                  </div>
                  <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-gray-900 group-hover:text-indigo-600 transition-colors leading-tight mb-4">
                    {scorecards[0].question}
                  </h3>
                  <p class="text-base sm:text-lg text-gray-500 leading-relaxed mb-4">
                    <span class="font-medium text-gray-400">Audit found</span> — {cardMeta(scorecards[0]).auditFound}
                  </p>
                  {scorecards[0].positions && scorecards[0].positions.length > 0 && (
                    scorecards[0].spectrumAxis ? (
                      <div class="mb-4 max-w-2xl">
                        <PositionSpectrum positions={scorecards[0].positions} axis={scorecards[0].spectrumAxis} />
                        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2">
                          {scorecards[0].positions.map((p, i) => (
                            <span class="inline-flex items-center gap-1.5 text-xs text-gray-500">
                              <span class={`inline-flex items-center justify-center w-4 h-4 rounded-full text-white text-[9px] font-semibold ${SPECTRUM_DOT[i % SPECTRUM_DOT.length]}`}>{i + 1}</span>
                              {p.label}
                            </span>
                          ))}
                        </div>
                      </div>
                    ) : (
                      <div class="flex flex-col gap-1.5 mb-4 max-w-2xl">
                        {scorecards[0].positions.map((p, i) => (
                          <div class="flex items-start gap-2">
                            <span class={`inline-flex items-center justify-center shrink-0 w-5 h-5 rounded text-[10px] font-bold ${POSITION_CHIP[i % POSITION_CHIP.length]}`}>{i + 1}</span>
                            <span class="text-sm text-gray-600 leading-snug">{p.label}</span>
                          </div>
                        ))}
                      </div>
                    )
                  )}
                  <p class="text-xs text-gray-400 tabular-nums">
                    {new Date(scorecards[0].publishedDate + 'T00:00:00').toLocaleDateString('en-GB', {
                      day: 'numeric', month: 'long', year: 'numeric',
                    })}
                  </p>
                </div>
              </a>
            )}

            <!--
              Single-column feed of white cards — one briefing at a time, each in
              its own bordered card for clear separation, capped at max-w-3xl so
              lines stay readable. Spacing (gap) does the separating, not dividers.
            -->
            {scorecards.length > 1 && (
              <div class="flex flex-col gap-4">
                {scorecards.slice(1).map((sc) => (
                  <a
                    href={`/scorecard/${sc.slug}`}
                    class="group block max-w-3xl bg-white border border-gray-200 rounded-lg p-5 sm:p-6 hover:border-gray-300 hover:shadow-sm transition-all"
                  >
                    <div class="flex items-center gap-2 mb-2.5 flex-wrap">
                      {sc.category && CATEGORY_STYLES[sc.category] ? (
                        <span class={`inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${CATEGORY_STYLES[sc.category!].bg} ${CATEGORY_STYLES[sc.category!].text}`}>
                          {sc.category}
                        </span>
                      ) : (
                        <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-gray-700 text-white">
                          Scorecard
                        </span>
                      )}
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-medium">{sc.positions?.length ?? 0} positions</span>
                      {cardMeta(sc).sourceCount > 0 && (
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] font-medium">{cardMeta(sc).sourceCount} sources</span>
                      )}
                    </div>
                    <h3 class="font-serif text-lg sm:text-xl text-gray-900 group-hover:text-indigo-600 transition-colors leading-snug mb-2.5">
                      {sc.question}
                    </h3>
                    <p class="text-sm text-gray-500 leading-relaxed line-clamp-2 mb-3">
                      <span class="font-medium text-gray-400">Audit found</span> — {cardMeta(sc).auditFound}
                    </p>
                    {sc.positions && sc.positions.length > 0 && (
                      sc.spectrumAxis ? (
                        <div class="mb-3">
                          <PositionSpectrum positions={sc.positions} axis={sc.spectrumAxis} compact />
                          <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-1.5">
                            {sc.positions.map((p, i) => (
                              <span class="inline-flex items-center gap-1 text-[11px] text-gray-500">
                                <span class={`inline-flex items-center justify-center w-3.5 h-3.5 rounded-full text-white text-[8px] font-semibold ${SPECTRUM_DOT[i % SPECTRUM_DOT.length]}`}>{i + 1}</span>
                                {p.label}
                              </span>
                            ))}
                          </div>
                        </div>
                      ) : (
                        <div class="flex flex-col gap-1.5 mb-3">
                          {sc.positions.map((p, i) => (
                            <div class="flex items-start gap-2">
                              <span class={`inline-flex items-center justify-center shrink-0 w-5 h-5 rounded text-[10px] font-bold ${POSITION_CHIP[i % POSITION_CHIP.length]}`}>{i + 1}</span>
                              <span class="text-sm text-gray-600 leading-snug">{p.label}</span>
                            </div>
                          ))}
                        </div>
                      )
                    )}
                    <p class="text-[11px] text-gray-400 tabular-nums">
                      {new Date(sc.publishedDate + 'T00:00:00').toLocaleDateString('en-GB', {
                        day: 'numeric', month: 'short', year: 'numeric',
                      })}
                    </p>
                  </a>
                ))}
              </div>
            )}
          </div>

        </div>
      )}
    </section>

    <!-- Footer info strip -->
    <div class="grid sm:grid-cols-3 gap-0 mt-16 border-t border-gray-900 pt-6">
      <div class="py-4 px-4 sm:px-6 sm:border-r sm:border-gray-200">
        <h3 class="text-xs font-bold uppercase text-gray-900 mb-2">Chrome Extension</h3>
        <p class="text-sm text-gray-500 leading-relaxed mb-2">Audit any argument while you read - runs in the side panel against the page in view.</p>
        <a href="/extension" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">Learn more →</a>
      </div>
      <div class="py-4 px-4 sm:px-6 sm:border-r sm:border-gray-200">
        <h3 class="text-xs font-bold uppercase text-gray-900 mb-2">Creator Studio</h3>
        <p class="text-sm text-gray-500 leading-relaxed mb-2">Point the engine at your own writing.</p>
        <a href="/creator" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">Learn more →</a>
      </div>
      <div class="py-4 px-4 sm:px-6">
        <h3 class="text-xs font-bold uppercase text-gray-900 mb-2">Strongest Opposing Case</h3>
        <p class="text-sm text-gray-500 leading-relaxed mb-2">Paste any argument, get its steelmanned opposition.</p>
        <a href="/strongest-opposing-case" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">Try it →</a>
      </div>
    </div>

  </main>
</Base>
