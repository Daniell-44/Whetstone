---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import AuditForm from '../components/audit/AuditForm';
import HeroHeadline from '../components/reader/HeroHeadline';
import PositionSpectrum from '../components/scorecard/PositionSpectrum.astro';
import { getAllBriefings } from '../lib/briefings';
import type { BriefingArticle } from '../../functions/_lib/briefing/types';

const briefings = getAllBriefings();

// "Audit the full article" deep-link: /?audit=<slug> pre-loads the reader with
// the briefing's argumentative prose so a reader can run the engine on it.
function briefingPlainText(b: BriefingArticle): string {
  const parts: string[] = [];
  for (const bl of b.blocks) {
    if (bl.type === 'position') parts.push(bl.paragraph);
    else if (bl.type === 'landscape' || bl.type === 'prose' || bl.type === 'shared' || bl.type === 'editorView') parts.push(bl.text);
  }
  return parts.join('\n\n').slice(0, 10_000);
}
const auditSlug    = Astro.url.searchParams.get('audit');
const auditTarget  = auditSlug ? briefings.find((b) => b.slug === auditSlug) : undefined;
const auditPrefill = auditTarget ? briefingPlainText(auditTarget) : '';
// /?url=<source> deep-link: audit the source article a briefing position quotes.
const auditUrlParam = Astro.url.searchParams.get('url') ?? '';
const auditUrl      = auditUrlParam.startsWith('http') ? auditUrlParam : '';

function briefingDek(b: BriefingArticle): string {
  const l = b.blocks.find((bl) => bl.type === 'landscape');
  return l && 'text' in l ? l.text : '';
}

function briefingCard(b: BriefingArticle) {
  const isExplainer = b.kind === 'explainer';
  const leaningById: Record<string, number> = Object.fromEntries(b.sources.map((s) => [s.id, s.leaning]));
  const positions = b.blocks.flatMap((bl) =>
    bl.type === 'position' ? [{ label: bl.label, leaning: leaningById[bl.sourceId] ?? 0 }] : [],
  );
  const shared = b.blocks.find((bl) => bl.type === 'shared');
  const firstProse = b.blocks.find((bl) => bl.type === 'prose');
  // Explainers have no audit verdict — lead with the opening line instead.
  const dek = isExplainer
    ? (firstProse && 'text' in firstProse ? firstProse.text : briefingDek(b))
    : (shared && 'text' in shared ? shared.text : briefingDek(b));
  return { isExplainer, positions, dek, axis: b.spectrumAxis };
}
import { makeAuthDb } from '../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../functions/_lib/auth/sessions';
import { makeBillingDb } from '../../functions/_lib/billing/subscription';
import { makeWorkspaceDb } from '../../functions/_lib/workspaces/db';
import { userHasActiveSubscriptionViaWorkspace } from '../../functions/_lib/workspaces/permissions';

// Deeper lenses on the Reader are Pro-gated; detect subscription for the teaser.
const session = await getSessionFromRequest(Astro.request, makeAuthDb(env.DB));
const isPro = session
  ? await userHasActiveSubscriptionViaWorkspace(makeBillingDb(env.DB), makeWorkspaceDb(env.DB), session.user_id)
  : false;

// Category tag colours
const CATEGORY_STYLES: Record<string, { bg: string; text: string; chip: string }> = {
  politics:    { bg: 'bg-red-600',     text: 'text-white', chip: 'bg-red-100 text-red-700' },
  economics:   { bg: 'bg-emerald-600', text: 'text-white', chip: 'bg-emerald-100 text-emerald-700' },
  science:     { bg: 'bg-blue-600',    text: 'text-white', chip: 'bg-blue-100 text-blue-700' },
  technology:  { bg: 'bg-violet-600',  text: 'text-white', chip: 'bg-violet-100 text-violet-700' },
  health:      { bg: 'bg-pink-600',    text: 'text-white', chip: 'bg-pink-100 text-pink-700' },
  culture:     { bg: 'bg-amber-600',   text: 'text-white', chip: 'bg-amber-100 text-amber-700' },
  philosophy:  { bg: 'bg-indigo-600',  text: 'text-white', chip: 'bg-indigo-100 text-indigo-700' },
  law:         { bg: 'bg-gray-700',    text: 'text-white', chip: 'bg-gray-200 text-gray-700' },
  environment: { bg: 'bg-green-600',   text: 'text-white', chip: 'bg-green-100 text-green-700' },
  education:   { bg: 'bg-sky-600',     text: 'text-white', chip: 'bg-sky-100 text-sky-700' },
};

// Solid dot palette for the position spectrum — must match PositionSpectrum.astro.
const SPECTRUM_DOT = ['bg-sky-600', 'bg-rose-600', 'bg-amber-600', 'bg-emerald-600', 'bg-violet-600'];

const categoryCounts: Record<string, number> = {};
for (const b of briefings) {
  if (b.category) categoryCounts[b.category] = (categoryCounts[b.category] ?? 0) + 1;
}
const presentCategories = Object.keys(categoryCounts).sort();
---
<Base
  title="The Whetstone - audit any argument"
  description="Paste any text or drop a URL. See the structure behind the argument: claims, evidence, where the logic breaks down, and the strongest opposing case. Free to try."
  canonicalPath="/"
>
  <main class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10 pb-12 sm:pb-24">

    <!-- Hero -->
    <header class="mb-10 sm:mb-12 pt-2">
      <HeroHeadline client:load />
    </header>

    <!-- Audit form -->
    <section class="mb-12 sm:mb-16 max-w-4xl mx-auto">
      <AuditForm isPro={isPro} initialText={auditPrefill} initialUrl={auditUrl} client:load />
    </section>

    <!-- Briefings feed with left rail -->
    <section>
      <div class="flex items-center gap-4 mb-6 sm:mb-8">
        <h2 class="font-serif text-xl sm:text-2xl text-ink-strong shrink-0">Briefings</h2>
        <div class="h-px flex-1 bg-hairline" />
      </div>

      {briefings.length === 0 ? (
        <div class="py-20 border-t border-hairline text-center">
          <p class="font-serif text-2xl text-hairline">No briefings published yet.</p>
        </div>
      ) : (
        <div class="flex flex-col lg:flex-row gap-8">

          <!-- Left filter rail (desktop only) -->
          <aside class="hidden lg:block w-56 shrink-0 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
            <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Browse</p>
            <nav class="space-y-1">
              <button type="button" data-filter="all" aria-pressed="true" class="feed-filter w-full flex items-center justify-between px-3 py-2 rounded-md text-sm text-left transition-colors">
                <span>All</span>
                <span class="feed-filter-count text-xs">{briefings.length}</span>
              </button>
              {presentCategories.map(cat => (
                <button
                  type="button"
                  data-filter={cat}
                  aria-pressed="false"
                  class="feed-filter w-full flex items-center justify-between px-3 py-2 rounded-md text-sm text-left capitalize transition-colors"
                >
                  <span>{cat}</span>
                  <span class="feed-filter-count text-xs">{categoryCounts[cat]}</span>
                </button>
              ))}
            </nav>

            <div class="mt-6 pt-6 border-t border-hairline">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">About</p>
              <p class="text-xs text-muted leading-relaxed">
                Each briefing takes one contested question and audits every position — claim, evidence, and where the reasoning breaks down.
              </p>
              <a href="/how-it-works" class="block mt-3 text-xs text-accent hover:text-accent-support font-medium">
                How briefings work →
              </a>
            </div>
          </aside>

          <!-- Mobile category strip -->
          <div class="lg:hidden flex gap-1.5 overflow-x-auto -mx-4 px-4 pb-2 scrollbar-thin">
            <button type="button" data-filter="all" aria-pressed="true" class="feed-chip shrink-0 px-3 py-1.5 rounded-full text-xs font-medium capitalize transition-colors">
              All ({briefings.length})
            </button>
            {presentCategories.map(cat => (
              <button type="button" data-filter={cat} aria-pressed="false" class="feed-chip shrink-0 px-3 py-1.5 rounded-full text-xs font-medium capitalize transition-colors">
                {cat} ({categoryCounts[cat]})
              </button>
            ))}
          </div>

          <!-- Main feed — fills the remaining column beside the rail (no centred
               width-cap), so the grid spans to the section header on wide screens. -->
          <div class="min-w-0 w-full">

            <!-- Article-format briefings (new) — lead the feed -->
            {briefings.length > 0 && (
              <div class="grid sm:grid-cols-2 gap-4 mb-8 items-start">
                {briefings.map((b, idx) => {
                  const card = briefingCard(b);
                  // Restrained card: hairline surface + a thin top-rule in the
                  // type colour (accent=briefing, teal=explainer) for contrast
                  // without a heavy banner. Image shows only when a real one exists.
                  const ruleCls = card.isExplainer ? 'border-t-accent-support' : 'border-t-accent';
                  const eyebrowCls = card.isExplainer ? 'text-accent-support' : 'text-accent';
                  return (
                    <a
                      href={`/briefing/${b.slug}`}
                      data-briefing-card
                      data-category={b.category ?? ''}
                      class={`group block bg-surface border border-hairline border-t-2 ${ruleCls} rounded-md p-5 sm:p-6 hover:border-accent/40 hover:shadow-sm transition-all ${idx === 0 ? 'sm:col-span-2' : ''}`}
                    >
                      {/* Briefings get a banner (real image, else a category-colour
                         placeholder until real art lands); explainers stay text-first. */}
                      {!card.isExplainer && (
                        b.image ? (
                          <img src={b.image} alt="" loading="lazy" class={`w-full ${idx === 0 ? 'h-44' : 'h-28'} object-cover rounded-md mb-4`} />
                        ) : (
                          <div class={`w-full ${idx === 0 ? 'h-44' : 'h-28'} rounded-md mb-4 flex items-center justify-center ${b.category && CATEGORY_STYLES[b.category] ? CATEGORY_STYLES[b.category].bg : 'bg-ink'}`}>
                            <span class="font-serif text-paper/70 text-base sm:text-lg capitalize">{b.category ?? 'Briefing'}</span>
                          </div>
                        )
                      )}
                      <div class="flex items-center gap-2 mb-2.5 flex-wrap">
                        <span class={`text-xs font-semibold uppercase tracking-widest ${eyebrowCls}`}>
                          {card.isExplainer ? 'Explainer' : 'Briefing'}
                        </span>
                        {b.category && (
                          <span class="text-xs font-medium uppercase tracking-wider text-muted">· {b.category}</span>
                        )}
                        {!card.isExplainer && (
                          <span class="text-xs text-muted">· {card.positions.length} positions · {b.sources.length} sources</span>
                        )}
                      </div>
                      <h3 class={`font-serif text-lg sm:text-xl text-ink-strong group-hover:text-accent transition-colors leading-snug ${card.isExplainer ? '' : 'mb-2'}`}>
                        {b.question}
                      </h3>
                      {/* Explainers are compact — headline only, no dek — so two
                         stack in a briefing's footprint. Briefings keep the audit dek. */}
                      {!card.isExplainer && (
                        <p class="text-sm text-ink leading-relaxed line-clamp-2 mb-3">
                          <span class="font-medium text-muted">Audit found</span>: {card.dek}
                        </p>
                      )}
                      {card.positions.length > 0 && (
                        <div>
                          <PositionSpectrum positions={card.positions} axis={card.axis} compact />
                          <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-1.5">
                            {card.positions.map((p, i) => (
                              <span class="inline-flex items-center gap-1 text-xs text-muted">
                                <span class={`inline-flex items-center justify-center w-3.5 h-3.5 rounded-full text-white text-[8px] font-semibold ${SPECTRUM_DOT[i % SPECTRUM_DOT.length]}`}>{i + 1}</span>
                                {p.label}
                              </span>
                            ))}
                          </div>
                        </div>
                      )}
                    </a>
                  );
                })}
              </div>
            )}

          </div>

        </div>
      )}
    </section>

    <style>
      /* Category-filter controls (rail + mobile strip). Active state is driven by
         aria-pressed so the styling stays in sync with the a11y state the script sets. */
      .feed-filter { color: var(--color-muted); border: 1px solid transparent; }
      .feed-filter:hover { background: var(--color-surface); color: var(--color-ink); }
      .feed-filter[aria-pressed="true"] { background: var(--color-surface); border-color: var(--color-hairline); color: var(--color-ink-strong); font-weight: 500; }
      .feed-filter-count { color: var(--color-muted); }
      .feed-chip { color: var(--color-muted); background: var(--color-surface); border: 1px solid var(--color-hairline); }
      .feed-chip[aria-pressed="true"] { color: var(--color-ink-strong); border-color: var(--color-accent); }
    </style>

    <script>
      // Client-side category filter for the briefings feed. Rail buttons and mobile
      // chips share [data-filter]; cards carry [data-category]. No reload — cards are
      // shown/hidden in place, and aria-pressed is kept in sync across both controls.
      const filters = Array.from(document.querySelectorAll<HTMLElement>('[data-filter]'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-briefing-card]'));
      function applyFeedFilter(cat: string) {
        for (const card of cards) {
          const match = cat === 'all' || card.getAttribute('data-category') === cat;
          // Inline display beats the card's `block` utility with no !important and
          // no reliance on Astro style-scoping cooperating with a JS-added class.
          card.style.display = match ? '' : 'none';
        }
        for (const f of filters) {
          f.setAttribute('aria-pressed', f.getAttribute('data-filter') === cat ? 'true' : 'false');
        }
      }
      for (const f of filters) {
        f.addEventListener('click', () => applyFeedFilter(f.getAttribute('data-filter') || 'all'));
      }
    </script>

    <!-- Footer info strip -->
    <div class="grid sm:grid-cols-3 gap-0 mt-16 border-t border-ink pt-6">
      <div class="py-4 px-4 sm:px-6 sm:border-r sm:border-hairline">
        <h3 class="text-xs font-bold uppercase text-ink-strong mb-2">Chrome Extension</h3>
        <p class="text-sm text-muted leading-relaxed mb-2">Audit any argument while you read - runs in the side panel against the page in view.</p>
        <a href="/extension" class="text-xs font-semibold text-accent hover:text-accent-support">Learn more →</a>
      </div>
      <div class="py-4 px-4 sm:px-6 sm:border-r sm:border-hairline">
        <h3 class="text-xs font-bold uppercase text-ink-strong mb-2">Creator Studio</h3>
        <p class="text-sm text-muted leading-relaxed mb-2">Point the engine at your own writing.</p>
        <a href="/creator" class="text-xs font-semibold text-accent hover:text-accent-support">Learn more →</a>
      </div>
      <div class="py-4 px-4 sm:px-6">
        <h3 class="text-xs font-bold uppercase text-ink-strong mb-2">Strongest Opposing Case</h3>
        <p class="text-sm text-muted leading-relaxed mb-2">Paste any argument, get its steelmanned opposition.</p>
        <a href="/strongest-opposing-case" class="text-xs font-semibold text-accent hover:text-accent-support">Try it →</a>
      </div>
    </div>

  </main>
</Base>
