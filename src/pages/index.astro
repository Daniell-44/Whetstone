---
import Base from '../layouts/Base.astro';
---
<Base title="Devil's Advocate — the whetstone">
  <main class="max-w-3xl mx-auto px-6 pt-24 pb-16">

    <!-- Wordmark + tagline -->
    <header class="mb-12">
      <p class="text-xs font-semibold tracking-widest text-indigo-500 uppercase mb-3">
        Devil's Advocate
      </p>
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 leading-tight mb-4">
        The whetstone.
      </h1>
      <p class="text-xl text-gray-500 leading-relaxed max-w-xl">
        Sharpen your thinking against the strongest version of every argument you read.
      </p>
    </header>

    <!-- What it does -->
    <section class="mb-12">
      <p class="text-base text-gray-700 leading-relaxed max-w-xl">
        Highlight any passage on any article. Devil's Advocate reads the argument structure back to
        you — the main claim, the evidence offered, the assumption holding it together — flags up
        to three reasoning patterns worth examining, and writes the strongest case for the opposing
        position.
      </p>
    </section>

    <!-- CTAs -->
    <section class="flex flex-wrap items-center gap-4 mb-16">
      <span class="inline-flex items-center gap-2 px-5 py-3 bg-indigo-600 text-white text-sm font-medium rounded-lg cursor-default select-none opacity-90">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10" stroke-width="2"/>
          <polyline points="12 6 12 12 16 14" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Coming to the Chrome Web Store
      </span>
      <a href="/how-it-works" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors underline underline-offset-2">
        How it works →
      </a>
    </section>

    <!-- Try-it-now stub (real inline analysis lands at Step 7d) -->
    <section class="border border-gray-200 rounded-2xl p-6 bg-white">
      <p class="text-xs font-semibold tracking-widest text-gray-400 uppercase mb-3">
        Try it now
      </p>
      <textarea
        disabled
        rows="4"
        placeholder="Paste an argument here…"
        class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-400 bg-gray-50 resize-none mb-3 cursor-not-allowed"
      ></textarea>
      <div class="flex items-center justify-between flex-wrap gap-3">
        <p class="text-sm text-gray-500">
          Full analysis requires the extension.
        </p>
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-400 text-sm font-medium rounded-lg cursor-not-allowed select-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Install to try
        </span>
      </div>
    </section>

    <!-- Abstract whetstone mark -->
    <div class="mt-20 flex justify-center opacity-20" aria-hidden="true">
      <svg width="80" height="36" viewBox="0 0 80 36" fill="none">
        <path d="M2 32 L78 22 L78 14 L2 4 Z" fill="#4F46E5" />
      </svg>
    </div>

  </main>
</Base>
