---
export const prerender = false;

import Base from '../layouts/Base.astro';
import BriefingCard from '../components/briefing/BriefingCard.astro';
import { getLiveBriefings, getAllBriefings } from '../lib/briefings';
import EmailCapture from '../components/capture/EmailCapture';
import { featured } from '../data/featured';
import { SAMPLES } from '../data/samples';
import { CATEGORY_COLOUR_FALLBACK } from '../lib/category-colour';
import { qualifyingFeedGroups } from '../lib/feed-groups';
import type { BriefingArticle } from '../../functions/_lib/briefing/types';

// Deep-link shim (D1 Option B, 2026-07-07): the audit tool moved to /audit.
// Legacy /?audit=<slug> and /?url=<src> links (briefing cards, extension,
// shared links) redirect there with params intact.
const sp = Astro.url.searchParams;
if (sp.has('audit') || sp.has('url')) {
  return Astro.redirect(`/audit?${sp.toString()}`, 301);
}

// Live (non-archived) work only: the 2026-07-21 clean-slate archived the
// ported corpus, so the feed shows hand-authored pieces as they publish.
const briefings = getLiveBriefings();
// The essay shelf: the editor's own pieces. Drafts surface here (their page
// carries the draft banner) while staying out of the briefings feed above.
const essays = getAllBriefings().filter((b) => b.kind === 'opinion' && !b.archived);

// Featured band vs mosaic split. `featured` (src/data/featured.ts) is the curated
// front page, in order; everything else flows into the asymmetric mosaic below,
// newest first (getAllBriefings already sorts by date desc).
const bySlug = new Map(briefings.map((b) => [b.slug, b]));
const featuredBriefings = featured
  .map((slug) => bySlug.get(slug))
  .filter((b): b is BriefingArticle => b != null);
const featuredSet = new Set(featuredBriefings.map((b) => b.slug));
const restBriefings = briefings.filter((b) => !featuredSet.has(b.slug));

// Content-aware mosaic packing on a 6-column grid. Each row is one of:
//   [wide 4 + narrow 2] · [trio 2·2·2] · [pair 3·3] · [lone 6]
// so rows never leave blank columns. Explainers are compact (headline only), so
// they never take the wide span-4 slot — they sit in narrow/standard cells;
// wide rows and trio rows alternate. Returns each card with its column span.
interface PlacedCard { b: BriefingArticle; span: number }
function packMosaic(items: BriefingArticle[]): PlacedCard[] {
  const out: PlacedCard[] = [];
  let i = 0;
  let wideNext = true;
  while (i < items.length) {
    const left = items.length - i;
    if (left === 1) {
      out.push({ b: items[i], span: 6 });
      i += 1;
    } else if (wideNext && items[i].kind !== 'explainer') {
      out.push({ b: items[i], span: 4 }, { b: items[i + 1], span: 2 });
      i += 2;
      wideNext = false;
    } else if (left >= 3) {
      out.push({ b: items[i], span: 2 }, { b: items[i + 1], span: 2 }, { b: items[i + 2], span: 2 });
      i += 3;
      wideNext = true;
    } else {
      out.push({ b: items[i], span: 3 }, { b: items[i + 1], span: 3 });
      i += 2;
      wideNext = true;
    }
  }
  return out;
}
const mosaicCards = packMosaic(restBriefings);

// Filter consolidation (2026-07-17): the authored categories are too granular
// for the current corpus (most filters yielded a one-card feed), so the filter
// advertises at most 3 broad groups (src/lib/feed-groups.ts), each shown only
// when it matches at least 2 briefings. Card kickers keep the authored category.
const feedGroups = qualifyingFeedGroups(briefings.map((b) => b.category));
// A filter with fewer than 2 qualifying groups can't split the feed, so the
// whole filter UI (rail nav + mobile chip strip) is hidden.
const showFeedFilter = feedGroups.length >= 2;

// The reader-questions query that used to live here (listPublishedQuestions,
// plus the `env` and QuestionCard imports it needed) came out with the shelf
// below. See the note under the Essays section for why. Nothing else on this
// page ever touched the database, so the page is back to reading only the
// markdown corpus.
---
<Base
  title="The Whetstone: arguments, examined"
  description="Briefings that map the strongest positions on contested questions, with a structural audit of every position's reasoning: named fallacies, unstated assumptions, and the shared premises both sides stand on."
  canonicalPath="/"
  hideFooterCapture={briefings.length === 0}
>
  <main class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10 pb-12 sm:pb-24">

    <!-- Hero removed (Daniel, 2026-08-04): the publication doesn't explain
         itself above its own content. Positioning now lives in (a) the masthead
         tagline, (b) this one-line standfirst, and (c) the launcher's "what
         does this do?" dropdown below, which carries the three-way contrast +
         the audit anatomy that used to fill the hero. -->
    <p class="pt-2 mb-5 text-sm sm:text-base text-muted leading-relaxed max-w-3xl">
      Not a verdict on who's right — <span class="text-ink-strong font-medium">a structural audit of how each argument works</span>.
    </p>

    {/* Audit launcher as a full-width band (W1, Daniel 2026-08-06): the input
       stretches to the container edge, the page's second masthead. Hands its
       value to /audit via sessionStorage; example chips deep-link to cached
       samples (no API call). */}
    <div class="mb-10">
      <div id="audit-launcher" class="bg-surface border border-hairline rounded-md p-4 sm:p-5">
        <div class="flex items-baseline gap-2 mb-2 flex-wrap">
          <span class="text-xs font-semibold uppercase tracking-widest font-mono text-muted">Audit your own text</span>
          <span class="text-xs text-muted">Paste an argument, get its structure.</span>
          <span class="text-[10px] font-mono uppercase tracking-wider text-muted/80 ml-auto shrink-0">Free · no sign-in</span>
        </div>
        <div class="relative">
          {/* text-base on mobile: sub-16px inputs trigger iOS Safari's
             zoom-on-focus at the funnel's very first interaction. The
             go button is 44px (Apple HIG minimum). */}
          <input
            id="audit-launcher-input"
            type="text"
            placeholder="Paste an argument, or drop a link…"
            class="w-full bg-paper border border-hairline rounded-lg pl-3.5 pr-16 py-3 text-base sm:text-sm text-ink placeholder:text-muted/70 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-colors"
          />
          <button
            id="audit-launcher-go"
            type="button"
            aria-label="Run the audit"
            class="absolute right-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-accent-support text-paper flex items-center justify-center hover:bg-accent-support/90 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12"/></svg>
          </button>
        </div>
        <div class="flex items-center gap-2 mt-3 flex-wrap">
          <span class="text-[11px] font-mono uppercase tracking-wider text-muted/80 shrink-0">Try</span>
          {SAMPLES.map((s) => (
            <a
              href={`/audit?sample=${s.id}`}
              class="text-xs border border-hairline rounded px-2.5 py-1 text-accent-support hover:border-accent-support/50 hover:text-accent transition-colors"
            >{s.shortLabel}</a>
          ))}
          <a href="/audit" class="text-xs text-muted hover:text-accent transition-colors ml-auto shrink-0">Full tool →</a>
        </div>
        <!-- L2 explainer (Daniel, 2026-08-05): one worked example teaches more
             than three bullets. The sample is fictional and self-contained, so
             it never goes stale and needs no source URL. The three-way
             contrast (bias tools / fact-checkers / us) moved to /about, where
             positioning copy belongs. Native details, zero JS. -->
        <details class="mt-3 border-t border-hairline pt-1 -mb-1">
          <summary class="flex items-center gap-2 py-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-muted">What comes back?</span>
            <svg class="w-3.5 h-3.5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pt-2 pb-2 max-w-xl">
            <p class="text-[11px] text-muted mb-0.5">You paste:</p>
            <p class="font-serif italic text-[13.5px] text-ink-strong leading-snug mb-2">"Everyone knows cities with more police have less crime, so hiring more police will cut crime."</p>
            <p class="text-[11px] text-muted mb-1">The audit returns:</p>
            <div class="border border-hairline bg-paper px-3 py-2.5">
              <p class="text-[13px] leading-snug">
                <span class="font-serif font-semibold text-ink-strong">Correlation as cause.</span>
                <span class="ml-1.5 font-mono text-[9px] font-semibold uppercase tracking-wide px-1.5 py-0.5 border bg-logic-bg text-logic border-logic/30">Logic</span>
              </p>
              <p class="text-[13px] text-ink leading-snug mt-1.5">The premise is a pattern; the conclusion claims a cause. The step needs: that police numbers drive the crime rate, and not the other way round. "Everyone knows" is doing the work evidence should.</p>
            </div>
            <p class="text-[11px] text-muted mt-2">Every finding is labelled by how you'd check it:
              <span class="ml-1 font-mono text-[9px] font-semibold uppercase tracking-wide px-1.5 py-0.5 border bg-logic-bg text-logic border-logic/30">Logic</span>
              <span class="font-mono text-[9px] font-semibold uppercase tracking-wide px-1.5 py-0.5 border bg-judgment-bg text-judgment border-judgment/30">Judgment call</span>
              <span class="font-mono text-[9px] font-semibold uppercase tracking-wide px-1.5 py-0.5 border bg-factual-bg text-factual border-factual/30">Factual</span>
            </p>
          </div>
        </details>
      </div>
    </div>

    <!-- Briefings feed with left rail -->
    <section id="briefings" class="scroll-mt-20">
      <div class="flex items-center gap-4 mb-6 sm:mb-8">
        <h2 class="font-serif text-xl sm:text-2xl text-ink-strong shrink-0">Briefings</h2>
        <div class="h-px flex-1 bg-hairline" />
      </div>

      {briefings.length === 0 ? (
        <!-- The clean-slate state (2026-07-21): the ported corpus is archived;
             this is the front door until the first hand-authored piece lands.
             Deliberately a launch surface, not an apology: what is coming, the
             standard it is held to, the capture, and the archive door. -->
        <div class="py-12 sm:py-16 border-t border-hairline">
          <div class="max-w-xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-3">A clean slate</p>
            <h3 class="font-serif text-2xl sm:text-3xl text-ink-strong leading-snug mb-3">New briefings are being written.</h3>
            <p class="text-sm text-muted leading-relaxed mb-6">
              The corpus is being rebuilt by hand: one contested question at a time, every position
              mapped, every quote verified verbatim against its source, every argument audited. The
              earlier machine-assisted corpus is kept in
              <a href="/archive" class="text-accent-support hover:underline">the archive</a>.
            </p>
            <EmailCapture client:visible source="briefing" heading="Get the first briefing by email" sub="When it publishes. Nothing else." />
          </div>
        </div>
      ) : (
        <div class="flex flex-col lg:flex-row gap-8">

          <!-- Left filter rail (desktop only) -->
          <aside class="hidden lg:block w-56 shrink-0 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
            {showFeedFilter && (
              <Fragment>
                <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Browse</p>
                <nav class="space-y-1">
                  <button type="button" data-filter="all" aria-pressed="true" class="feed-filter w-full flex items-center justify-between px-3 py-2 rounded-md text-sm text-left transition-colors">
                    <span class="flex items-center gap-2.5"><span class="w-2 h-2 rounded-full shrink-0" style={`background:${CATEGORY_COLOUR_FALLBACK}`} aria-hidden="true"></span>All</span>
                    <span class="feed-filter-count text-xs">{briefings.length}</span>
                  </button>
                  {feedGroups.map(g => (
                    <button
                      type="button"
                      data-filter={g.id}
                      aria-pressed="false"
                      class="feed-filter w-full flex items-center justify-between px-3 py-2 rounded-md text-sm text-left transition-colors"
                    >
                      <span class="flex items-center gap-2.5"><span class="w-2 h-2 rounded-full shrink-0" style={`background:${g.colour}`} aria-hidden="true"></span><span>{g.label}</span></span>
                      <span class="feed-filter-count text-xs">{g.count}</span>
                    </button>
                  ))}
                </nav>
              </Fragment>
            )}

            <div class={showFeedFilter ? 'mt-6 pt-6 border-t border-hairline' : ''}>
              <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">About</p>
              <p class="text-xs text-muted leading-relaxed">
                Each briefing takes one contested question and audits every position: its claim, its evidence, and where the reasoning breaks down.
              </p>
              <a href="/method#briefings" class="block mt-3 text-xs text-accent-support hover:text-accent font-medium">
                How briefings work →
              </a>
            </div>
          </aside>

          <!-- Mobile group strip — sticky under the 48px top bar so
               re-filtering a long feed doesn't mean scrolling back up. -->
          {showFeedFilter && (
            <div class="lg:hidden sticky top-12 z-20 bg-paper flex gap-1.5 overflow-x-auto -mx-4 px-4 pt-2 pb-2 border-b border-hairline scrollbar-thin">
              <button type="button" data-filter="all" aria-pressed="true" class="feed-chip shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium transition-colors">
                <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${CATEGORY_COLOUR_FALLBACK}`} aria-hidden="true"></span>All ({briefings.length})
              </button>
              {feedGroups.map(g => (
                <button type="button" data-filter={g.id} aria-pressed="false" class="feed-chip shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium transition-colors">
                  <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${g.colour}`} aria-hidden="true"></span>{g.label} ({g.count})
                </button>
              ))}
            </div>
          )}

          <!-- Main feed — fills the remaining column beside the rail (no centred
               width-cap), so the grid spans to the section header on wide screens. -->
          <div class="min-w-0 w-full">

            {/* Curated featured band (src/data/featured.ts). The filter script
               hides it when a category filter leaves it with no matching cards. */}
            {featuredBriefings.length > 0 && (
              <div id="feed-featured" class="mb-10">
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-xs font-semibold uppercase tracking-widest text-muted shrink-0">Featured</span>
                  <div class="h-px flex-1 bg-hairline" />
                </div>
                <div class="grid md:grid-cols-2 gap-4 items-stretch">
                  {featuredBriefings.map((b) => <BriefingCard b={b} size="featured" />)}
                </div>
              </div>
            )}

            {restBriefings.length > 0 && (
              <Fragment>
                {featuredBriefings.length > 0 && (
                  <div class="flex items-center gap-3 mb-4">
                    <span class="text-xs font-semibold uppercase tracking-widest text-muted shrink-0">Latest</span>
                    <div class="h-px flex-1 bg-hairline" />
                  </div>
                )}
                {/* Asymmetric mosaic (option 1). Mobile: one column. md+: a 6-col
                   span cycle set inline as --span. A category filter adds
                   .is-filtering, collapsing it to a clean uniform grid. */}
                <div id="feed-mosaic" class="feed-mosaic">
                  {mosaicCards.map(({ b, span }) => (
                    <BriefingCard b={b} size={span >= 4 ? 'wide' : 'standard'} style={`--span: span ${span}`} />
                  ))}
                </div>
              </Fragment>
            )}

          </div>

        </div>
      )}
    </section>

    <!-- Essays: the editor's own arguments, held to the same audit standard as
         the briefings. Full-width shelf, three cards across at desktop (Daniel,
         2026-08-09; replaces the 1fr_2fr split whose "Forthcoming" intro column
         read as apology once real cards were up — card width is unchanged).
         Draft essays surface HERE deliberately (the shelf is the editor's own;
         their pages carry the draft banner) while staying out of the briefings
         feed. Swap the dummy content by writing the essays. -->
    <section id="essays" class="scroll-mt-20 mt-16">
      <div class="flex items-center gap-4 mb-6 sm:mb-8">
        <h2 class="font-serif text-xl sm:text-2xl text-ink-strong shrink-0">Essays</h2>
        <div class="h-px flex-1 bg-hairline" />
      </div>
      {essays.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {essays.map((e) => (
            <a href={`/briefing/${e.slug}`} class="group block border border-hairline bg-surface hover:border-accent-support/40 transition-colors">
              {e.image && (
                <div class="border-b border-hairline bg-paper">
                  <img src={e.image} alt="" width="640" height="360" class="w-full h-auto block" loading="lazy" />
                </div>
              )}
              <div class="px-4 py-3">
                <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-[#8C4A2F]">Essay{e.category ? ` · ${e.category}` : ''}{e.draft ? ' · draft' : ''}</span>
                <p class="font-serif text-[20px] font-semibold text-ink-strong leading-snug mt-1 group-hover:text-accent-support transition-colors">{e.question}</p>
                {e.hook && <p class="font-serif text-[15px] italic text-muted leading-snug mt-1">{e.hook}</p>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="border border-dashed border-hairline rounded-md min-h-[10rem] flex items-center justify-center" aria-hidden="true">
          <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-muted/60">First essay reserved</span>
        </div>
      )}
    </section>

    {/* REMOVED, AWAITING A PLACEMENT DECISION (2026-08-18). A "Reader
        questions" shelf sat here from 2026-08-17: a section heading, a
        standfirst, and three published machine-made question pages from
        /questions, rendered as QuestionCards below the essays.

        It is off the page because where this module sits is an editorial
        claim, not a layout preference, and the claim was never chosen. A shelf
        here says machine-made pages are a third section of the publication,
        standing at the same weight as briefings an editor wrote and essays an
        editor signed. That may turn out to be the right thing to say. It
        should be decided rather than inherited from whichever section the
        module happened to be appended after.

        Three placements are drawn at size, each with what it claims and what
        it costs, at /labs/question-shelf. Nothing else changed: /questions and
        the individual question pages are still live, still reachable, and
        still linked from the result of a question run, so the only thing a
        reader loses meanwhile is finding them from here. Restore the chosen
        placement from the labs page rather than from this comment.

        A JSX comment rather than an HTML one on purpose: HTML comments in this
        file are served to every visitor, and a note about an undecided design
        question is for whoever opens this file, not for readers. */}

    <style>
      /* Category-filter controls (rail + mobile strip). Active state is driven by
         aria-pressed so the styling stays in sync with the a11y state the script sets. */
      .feed-filter { color: var(--color-muted); border: 1px solid transparent; }
      .feed-filter:hover { background: var(--color-surface); color: var(--color-ink); }
      .feed-filter[aria-pressed="true"] { background: var(--color-surface); border-color: var(--color-hairline); color: var(--color-ink-strong); font-weight: 500; }
      .feed-filter-count { color: var(--color-muted); }
      .feed-chip { color: var(--color-muted); background: var(--color-surface); border: 1px solid var(--color-hairline); }
      .feed-chip[aria-pressed="true"] { color: var(--color-ink-strong); border-color: var(--color-accent-support); }
      /* Asymmetric mosaic (option 1). Mobile: single column. md+: 6-col grid with a
         per-card span (set inline as --span). When filtering, collapse to a uniform
         grid so hidden cards don't leave holes in the pattern. */
      /* :global() on the child is required — the cards are rendered by the
         BriefingCard component, so they carry its scope id, not this page's.
         Without :global() Astro would scope the child selector to this page and
         the span rule would never match the card. */
      .feed-mosaic { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: stretch; }
      .feed-mosaic > :global([data-briefing-card]) { grid-column: auto; }
      @media (min-width: 768px) {
        .feed-mosaic { grid-template-columns: repeat(6, minmax(0, 1fr)); }
        .feed-mosaic > :global([data-briefing-card]) { grid-column: var(--span, span 2); }
        /* Per-topic (filtered) view: fewer, larger cards. */
        .feed-mosaic.is-filtering { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .feed-mosaic.is-filtering > :global([data-briefing-card]) { grid-column: auto; }
      }
    </style>

    <script>
      // Client-side group filter for the briefings feed. Rail buttons and mobile
      // chips share [data-filter] (a broad group id); cards carry [data-category]
      // (the authored category, still shown on the kicker), so each card is mapped
      // into its group here before comparing. No reload — cards are shown/hidden in
      // place, and aria-pressed is kept in sync across both controls.
      import { feedGroupFor } from '../lib/feed-groups';
      const filters = Array.from(document.querySelectorAll<HTMLElement>('[data-filter]'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-briefing-card]'));
      const mosaic = document.getElementById('feed-mosaic');
      const featuredBand = document.getElementById('feed-featured');
      function applyFeedFilter(group: string) {
        for (const card of cards) {
          const match = group === 'all' || feedGroupFor(card.getAttribute('data-category')) === group;
          // Inline display beats the card's `block` utility with no !important and
          // no reliance on Astro style-scoping cooperating with a JS-added class.
          card.style.display = match ? '' : 'none';
        }
        // The mosaic's asymmetric spans assume the full set; when filtering, collapse
        // it to a uniform grid so hidden cards don't leave holes.
        mosaic?.classList.toggle('is-filtering', group !== 'all');
        // Hide the curated band entirely if the active filter leaves it with no cards.
        if (featuredBand) {
          const anyVisible = Array.from(featuredBand.querySelectorAll<HTMLElement>('[data-briefing-card]'))
            .some((c) => c.style.display !== 'none');
          featuredBand.style.display = anyVisible ? '' : 'none';
        }
        for (const f of filters) {
          f.setAttribute('aria-pressed', f.getAttribute('data-filter') === group ? 'true' : 'false');
        }
      }
      for (const f of filters) {
        f.addEventListener('click', () => applyFeedFilter(f.getAttribute('data-filter') || 'all'));
      }

      // Compact audit launcher → /audit. URLs travel as a query param; pasted
      // text (any length) hands off via sessionStorage, consumed by AuditForm.
      const launcherInput = document.getElementById('audit-launcher-input') as HTMLInputElement | null;
      const launcherGo    = document.getElementById('audit-launcher-go');
      function launchAudit() {
        const v = (launcherInput?.value ?? '').trim();
        if (!v) { window.location.href = '/audit'; return; }
        if (/^https?:\/\//.test(v) && v.length < 1800) {
          window.location.href = '/audit?url=' + encodeURIComponent(v);
          return;
        }
        try { sessionStorage.setItem('wst_handoff', v); } catch { /* storage unavailable */ }
        window.location.href = '/audit';
      }
      launcherGo?.addEventListener('click', launchAudit);
      launcherInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') launchAudit(); });
    </script>

    <!-- Footer info strip -->
    <div class="grid sm:grid-cols-3 gap-0 mt-16 border-t border-ink pt-6">
      <div class="py-4 px-4 sm:px-6 sm:border-r sm:border-hairline">
        <h3 class="text-xs font-bold uppercase text-ink-strong mb-2">Ask a question</h3>
        <p class="text-sm text-muted leading-relaxed mb-2">Start from a contested question instead of a document. The engine goes and finds the sources.</p>
