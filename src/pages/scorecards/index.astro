---
export const prerender = false;

import { env } from "cloudflare:workers";
import Base from '../../layouts/Base.astro';
import { listScorecards } from '../../../functions/_lib/scorecard/storage';

const scorecards = await listScorecards(env.SCORECARDS);

// Same category palette as /reader so the brand reads consistent
const CATEGORY_STYLES: Record<string, { bg: string; text: string }> = {
  politics:    { bg: 'bg-red-600',     text: 'text-white' },
  economics:   { bg: 'bg-emerald-600', text: 'text-white' },
  science:     { bg: 'bg-blue-600',    text: 'text-white' },
  technology:  { bg: 'bg-violet-600',  text: 'text-white' },
  health:      { bg: 'bg-pink-600',    text: 'text-white' },
  culture:     { bg: 'bg-amber-600',   text: 'text-white' },
  philosophy:  { bg: 'bg-indigo-600',  text: 'text-white' },
  law:         { bg: 'bg-gray-700',    text: 'text-white' },
  environment: { bg: 'bg-green-600',   text: 'text-white' },
  education:   { bg: 'bg-sky-600',     text: 'text-white' },
};

function readTime(dek: string): string {
  const words = dek.split(/\s+/).length;
  const mins  = Math.max(3, Math.ceil(words / 40) + 2);
  return `${mins} min read`;
}

const categoryCounts: Record<string, number> = {};
for (const sc of scorecards) {
  if (sc.category) categoryCounts[sc.category] = (categoryCounts[sc.category] ?? 0) + 1;
}
const presentCategories = Object.keys(categoryCounts).sort();
---

<Base
  title="Briefings | The Whetstone"
  description="Public debates across the spectrum - who's arguing what, the best case and fatal flaw for each side, and the assumption all sides refuse to examine."
  canonicalPath="/scorecards"
>
  <main class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-16 pb-20">

    <!-- Header -->
    <header class="mb-12 max-w-3xl">
      <div class="flex items-center gap-3 mb-6">
        <p class="text-xs font-semibold tracking-[0.3em] text-indigo-500 uppercase shrink-0">The Whetstone · Briefings</p>
        <div class="h-px flex-1 bg-gray-200" />
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl text-gray-900 mb-4 leading-tight">Briefings</h1>
      <p class="text-base sm:text-lg text-gray-500 leading-relaxed">
        Public debates across the spectrum. Each briefing gathers the media on a question, maps the best
        case and fatal flaw for every side, and names the shared assumption all sides refuse to examine.
      </p>
    </header>

    {scorecards.length === 0 ? (
      <div class="py-24 border-t border-gray-200 text-center">
        <p class="font-serif text-2xl text-gray-300">No scorecards published yet.</p>
      </div>
    ) : (
      <>
        <!-- Category filter pills (anchor links) -->
        {presentCategories.length > 0 && (
          <nav class="flex flex-wrap gap-1.5 mb-10 pb-6 border-b border-gray-200">
            <a href="#all" class="px-3 py-1.5 rounded-full text-xs font-medium bg-gray-900 text-white">
              All <span class="text-gray-400 ml-1">{scorecards.length}</span>
            </a>
            {presentCategories.map(cat => (
              <a href={`#${cat}`} class="px-3 py-1.5 rounded-full text-xs font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors capitalize">
                {cat} <span class="text-gray-400 ml-1">{categoryCounts[cat]}</span>
              </a>
            ))}
          </nav>
        )}

        <!-- Lead story -->
        <a href={`/scorecard/${scorecards[0].slug}`} id="all" class="group block border-t border-b border-gray-200 py-8 sm:py-10 mb-10">
          <div class="max-w-3xl">
            <div class="flex items-center gap-3 mb-4">
              {scorecards[0].category && CATEGORY_STYLES[scorecards[0].category] ? (
                <span class={`inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider ${CATEGORY_STYLES[scorecards[0].category!].bg} ${CATEGORY_STYLES[scorecards[0].category!].text}`}>
                  {scorecards[0].category}
                </span>
              ) : (
                <span class="inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider bg-indigo-600 text-white">Featured</span>
              )}
              <span class="text-xs text-gray-400">{readTime(scorecards[0].dek)}</span>
            </div>
            <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-gray-900 group-hover:text-indigo-600 transition-colors leading-tight mb-3">
              {scorecards[0].question}
            </h2>
            <p class="text-base sm:text-lg text-gray-500 leading-relaxed mb-3">{scorecards[0].dek}</p>
            <p class="text-xs text-gray-400 tabular-nums">
              {new Date(scorecards[0].publishedDate + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
          </div>
        </a>

        <!-- Remainder grouped by category -->
        {presentCategories.map(cat => {
          const slice = scorecards.slice(1).filter(s => s.category === cat);
          if (slice.length === 0) return null;
          const cls = CATEGORY_STYLES[cat];
          return (
            <section id={cat} class="mb-12">
              <div class="flex items-center gap-3 mb-5">
                {cls && (
                  <span class={`inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider ${cls.bg} ${cls.text}`}>{cat}</span>
                )}
                <div class="h-px flex-1 bg-gray-200" />
                <span class="text-[10px] text-gray-400 tabular-nums">{slice.length} scorecard{slice.length === 1 ? '' : 's'}</span>
              </div>
              <ul class="divide-y divide-gray-100">
                {slice.map(sc => (
                  <li>
                    <a href={`/scorecard/${sc.slug}`} class="group block py-5 sm:py-6">
                      <h3 class="font-serif text-lg sm:text-xl text-gray-900 group-hover:text-indigo-600 transition-colors leading-snug mb-1.5">
                        {sc.question}
                      </h3>
                      <p class="text-sm text-gray-500 leading-relaxed line-clamp-2 mb-1.5">{sc.dek}</p>
                      <p class="text-[11px] text-gray-400 tabular-nums">
                        {new Date(sc.publishedDate + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                        <span class="mx-1.5 text-gray-300">·</span>
                        {readTime(sc.dek)}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}

        <!-- Uncategorised tail, if any -->
        {scorecards.slice(1).filter(s => !s.category).length > 0 && (
          <section id="other" class="mb-12">
            <div class="flex items-center gap-3 mb-5">
              <span class="inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider bg-gray-700 text-white">Other</span>
              <div class="h-px flex-1 bg-gray-200" />
            </div>
            <ul class="divide-y divide-gray-100">
              {scorecards.slice(1).filter(s => !s.category).map(sc => (
                <li>
                  <a href={`/scorecard/${sc.slug}`} class="group block py-5 sm:py-6">
                    <h3 class="font-serif text-lg sm:text-xl text-gray-900 group-hover:text-indigo-600 transition-colors leading-snug mb-1.5">
                      {sc.question}
                    </h3>
                    <p class="text-sm text-gray-500 leading-relaxed line-clamp-2 mb-1.5">{sc.dek}</p>
                    <p class="text-[11px] text-gray-400 tabular-nums">
                      {new Date(sc.publishedDate + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                      <span class="mx-1.5 text-gray-300">·</span>
                      {readTime(sc.dek)}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    )}

    <!-- Bring-your-own CTA -->
    <div class="mt-16 pt-8 border-t border-gray-900">
      <div class="max-w-2xl">
        <h2 class="font-serif text-xl text-gray-900 mb-2">Have an argument you want audited?</h2>
        <p class="text-sm text-gray-500 leading-relaxed mb-4">
          Paste any text or drop a URL - the Reader lens runs the same engine you see in every scorecard above.
        </p>
        <a href="/reader" class="inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-800">
          Open the Reader →
        </a>
      </div>
    </div>

  </main>
</Base>
