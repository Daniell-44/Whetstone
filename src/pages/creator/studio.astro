---
export const prerender = false;
// The Studio editor and the Audit merged into one tool with one door (owner
// decision 2026-08-16: "go on the studio and reader combination"). The editor
// now renders at /audit?mode=create; this address forwards there so bookmarks,
// nav links, and saved-document links (?doc=) keep working. 301 because the
// move is permanent — the reserved-URL contract made this cutover a redirect
// flip rather than a link-breaking migration.
const doc = Astro.url.searchParams.get('doc');
return Astro.redirect(
  doc ? `/audit?mode=create&doc=${encodeURIComponent(doc)}` : '/audit?mode=create',
  301,
);
---
