---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Creator Studio — Whetstone | The Whetstone"
  description="Paste your draft. Get Toulmin decomposition, reasoning-pattern flags, a steelman, and the counterarguments your piece doesn't engage with."
  canonicalPath="/creator/studio"
>
  <main class="max-w-3xl mx-auto px-6 pt-20 pb-16">

    <nav class="mb-10">
      <a href="/creator" class="text-xs text-gray-400 hover:text-gray-600 transition-colors">← Whetstone Creator</a>
    </nav>

    <!-- Hero -->
    <header class="mb-10">
      <p class="text-xs font-semibold tracking-widest text-amber-600 uppercase mb-3">Creator Studio</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 leading-tight mb-4">
        For students.
      </h1>
      <p class="text-xl text-gray-500 leading-relaxed max-w-xl mb-6">
        Paste your argument-based draft. The tool maps the claim, the unstated assumption,
        the evidence on offer, any reasoning patterns worth examining, the strongest opposing
        case, and the objections your piece doesn't yet address.
      </p>
      <ul class="flex flex-col gap-1.5 text-xs text-gray-400">
        <li class="flex items-center gap-2">
          <span class="w-1 h-1 rounded-full bg-gray-300 shrink-0"></span>
          Not a plagiarism detector. Not a grammar checker. Not a grade predictor.
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1 h-1 rounded-full bg-gray-300 shrink-0"></span>
          The question is "is the argument sound?" — not "did you write this?"
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1 h-1 rounded-full bg-gray-300 shrink-0"></span>
          Free during early access. No account required.
        </li>
      </ul>
    </header>

    <!-- Studio surface -->
    <section class="cs-wrapper">

      <div class="cs-label-row">
        <span class="cs-section-label">Your draft</span>
        <span id="cs-word-count" class="cs-word-count">0 words</span>
      </div>

      <textarea
        id="cs-input"
        class="cs-textarea"
        placeholder="An argument-based essay works best — paste any section with a clear claim and reasoning. 200 words minimum."
        rows="12"
        spellcheck="false"
      ></textarea>

      <div class="cs-meta-row">
        <span id="cs-min-notice" class="cs-min-notice hidden">200 words minimum</span>
      </div>

      <button id="cs-submit" class="cs-submit" disabled>
        Analyse draft
      </button>

      <div id="cs-status" class="cs-status hidden" aria-live="polite"></div>
      <div id="cs-result" class="cs-result hidden" aria-live="polite"></div>

      <div id="cs-pdf-row" class="cs-pdf-row hidden">
        <button id="cs-pdf-btn" class="cs-pdf-btn">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download audit memo (PDF)
        </button>
      </div>

    </section>

  </main>
</Base>

<style is:global>
  /* Studio wrapper */
  .cs-wrapper {
    background: white;
    border: 1px solid #fde68a;
    border-radius: 0.75rem;
    padding: 1.75rem 1.5rem;
  }

  /* Label row */
  .cs-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .cs-section-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d97706;
  }
  .cs-word-count { font-size: 0.75rem; color: #9ca3af; }

  /* Textarea */
  .cs-textarea {
    width: 100%;
    padding: 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #111827;
    background: #fffbeb;
    resize: vertical;
    font-family: inherit;
    transition: border-color 0.15s, background 0.15s;
    box-sizing: border-box;
  }
  .cs-textarea:focus { outline: none; border-color: #f59e0b; background: white; }

  /* Meta row */
  .cs-meta-row {
    display: flex;
    align-items: center;
    min-height: 1.25rem;
    margin-top: 0.375rem;
    margin-bottom: 0.75rem;
  }
  .cs-min-notice { font-size: 0.75rem; color: #d97706; }
  .cs-min-notice.hidden { display: none; }

  /* Submit */
  .cs-submit {
    padding: 0.625rem 1.5rem;
    background: #f59e0b;
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s;
  }
  .cs-submit:disabled { opacity: 0.45; cursor: not-allowed; }
  .cs-submit:not(:disabled):hover { background: #d97706; }

  /* Status */
  .cs-status {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: #6b7280;
  }
  .cs-status.hidden { display: none; }

  /* Result container */
  .cs-result { margin-top: 1.5rem; }
  .cs-result.hidden { display: none; }
  .cs-result-inner { display: flex; flex-direction: column; gap: 0.75rem; }

  /* Shared card */
  .da-pill-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; }
  .da-strength-pill {
    display: inline-block;
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: capitalize;
  }
  .da-strength-label { font-size: 0.75rem; color: #9ca3af; }
  .pill-strong   { background: #d1fae5; color: #065f46; }
  .pill-moderate { background: #fef3c7; color: #92400e; }
  .pill-weak     { background: #fee2e2; color: #991b1b; }
  .pill-other    { background: #f3f4f6; color: #6b7280; }

  .da-card {
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #e5e7eb;
    background: #fafafa;
  }
  .da-card-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 0.375rem;
  }
  .da-card-text { font-size: 0.875rem; color: #374151; line-height: 1.6; }
  .da-card-items { display: flex; flex-direction: column; gap: 0.375rem; }
  .da-card-item {
    font-size: 0.875rem;
    color: #374151;
    line-height: 1.5;
    padding-left: 0.875rem;
    border-left: 2px solid #d1d5db;
  }

  /* Warrant */
  .da-warrant {
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #c7d2fe;
    background: #eef2ff;
  }
  .da-warrant .da-card-label { color: #6366f1; }
  .da-warrant .da-card-text  { color: #312e81; }
  .da-warrant-sub { font-size: 0.6875rem; color: #818cf8; margin-top: 0.125rem; }

  /* Fallacies */
  .da-fallacy {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border-left: 3px solid #fbbf24;
    background: #fffbeb;
  }
  .da-fallacy-type {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #d97706;
    margin-bottom: 0.25rem;
  }
  .da-fallacy-span { font-size: 0.75rem; color: #92400e; font-style: italic; margin-bottom: 0.25rem; }
  .da-fallacy-explanation { font-size: 0.8125rem; color: #374151; line-height: 1.5; }

  /* Steelman */
  .da-steelman {
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #d1d5db;
    background: white;
  }
  .da-steelman .da-card-label { color: #6b7280; }
  .da-steelman-text { font-size: 0.875rem; color: #374151; line-height: 1.65; font-style: italic; }

  /* Blind-spot counterarguments — amber-accented */
  .cs-blindspot-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cs-blindspot-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d97706;
    margin-bottom: 0.25rem;
  }
  .cs-blindspot-item {
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #fde68a;
    background: #fffbeb;
  }
  .cs-blindspot-objection {
    font-size: 0.875rem;
    font-weight: 500;
    color: #92400e;
    line-height: 1.5;
    margin-bottom: 0.375rem;
  }
  .cs-blindspot-why {
    font-size: 0.8125rem;
    color: #6b7280;
    line-height: 1.5;
  }

  /* Not-argument / error */
  .da-not-argument {
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.6;
  }
  .da-error {
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid #fecaca;
    background: #fef2f2;
    font-size: 0.875rem;
    color: #991b1b;
    line-height: 1.6;
  }

  /* PDF row */
  .cs-pdf-row { margin-top: 1rem; }
  .cs-pdf-row.hidden { display: none; }
  .cs-pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    color: #6b7280;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .cs-pdf-btn:hover { border-color: #9ca3af; color: #374151; }
</style>

<script>
  const textarea    = document.getElementById('cs-input')      as HTMLTextAreaElement;
  const wordCountEl = document.getElementById('cs-word-count') as HTMLElement;
  const minNotice   = document.getElementById('cs-min-notice') as HTMLElement;
  const submitBtn   = document.getElementById('cs-submit')     as HTMLButtonElement;
  const statusEl    = document.getElementById('cs-status')     as HTMLElement;
  const resultEl    = document.getElementById('cs-result')     as HTMLElement;
  const pdfRow      = document.getElementById('cs-pdf-row')    as HTMLElement;
  const pdfBtn      = document.getElementById('cs-pdf-btn')    as HTMLButtonElement;

  const MIN_WORDS = 200;

  type BlindSpot = { objection: string; why_it_matters: string };

  type AnalysisResult = {
    toulmin: {
      claim: { text: string };
      data: Array<{ text: string }>;
      warrant: { text: string } | null;
      backing: Array<{ text: string }>;
      qualifier: string | null;
      rebuttal: string | null;
      argumentStrength: string;
    };
    fallacies: Array<{ type: string; span: string; explanation: string }>;
    steelman: string;
    blindSpotCounterarguments?: BlindSpot[];
  };

  type ApiResponse =
    | { kind: 'not_an_argument'; reason?: string }
    | { kind: 'result'; result: AnalysisResult }
    | { kind: string };

  let lastResult: AnalysisResult | null = null;
  let lastWordCount = 0;

  function countWords(text: string): number {
    return text.trim().split(/\s+/).filter(Boolean).length;
  }

  function escHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function pillClass(strength: string): string {
    if (strength === 'strong')   return 'pill-strong';
    if (strength === 'moderate') return 'pill-moderate';
    if (strength === 'weak')     return 'pill-weak';
    return 'pill-other';
  }

  function renderResult(data: ApiResponse): string {
    if (data.kind === 'not_an_argument') {
      lastResult = null;
      return `<div class="da-not-argument">The tool did not find a substantive argument in this text. Argument-based essays — a clear claim, evidence, and reasoning — work best.</div>`;
    }

    if (data.kind !== 'result' || !('result' in data)) {
      lastResult = null;
      return `<div class="da-error">Unexpected response from the analysis engine.</div>`;
    }

    const { toulmin, fallacies, steelman, blindSpotCounterarguments } = data.result;
    lastResult = data.result;
    const strength = toulmin.argumentStrength;

    let html = `<div class="cs-result-inner">`;

    // Strength pill
    html += `
      <div class="da-pill-row">
        <span class="da-strength-pill ${pillClass(strength)}">${escHtml(strength.replace(/_/g, ' '))}</span>
        <span class="da-strength-label">argument structure</span>
      </div>`;

    // Claim
    html += `
      <div class="da-card">
        <div class="da-card-label">Claim</div>
        <div class="da-card-text">${escHtml(toulmin.claim.text)}</div>
      </div>`;

    // Warrant
    if (toulmin.warrant) {
      html += `
        <div class="da-warrant">
          <div class="da-card-label">Warrant</div>
          <div class="da-warrant-sub">the unstated assumption</div>
          <div class="da-card-text" style="margin-top:0.375rem">${escHtml(toulmin.warrant.text)}</div>
        </div>`;
    }

    // Grounds
    if (toulmin.data.length > 0) {
      const items = toulmin.data.map(d => `<div class="da-card-item">${escHtml(d.text)}</div>`).join('');
      html += `
        <div class="da-card">
          <div class="da-card-label">Grounds</div>
          <div class="da-card-items">${items}</div>
        </div>`;
    }

    // Backing
    if (toulmin.backing.length > 0) {
      const items = toulmin.backing.map(b => `<div class="da-card-item">${escHtml(b.text)}</div>`).join('');
      html += `
        <div class="da-card">
          <div class="da-card-label">Backing</div>
          <div class="da-card-items">${items}</div>
        </div>`;
    }

    // Fallacies
    const topFallacies = fallacies.slice(0, 3);
    if (topFallacies.length > 0) {
      const fallacyHtml = topFallacies.map(f => `
        <div class="da-fallacy">
          <div class="da-fallacy-type">${escHtml(f.type.replace(/_/g, ' '))}</div>
          <div class="da-fallacy-span">"${escHtml(f.span)}"</div>
          <div class="da-fallacy-explanation">${escHtml(f.explanation)}</div>
        </div>`).join('');
      html += fallacyHtml;
    }

    // Steelman
    if (steelman) {
      html += `
        <div class="da-steelman">
          <div class="da-card-label">Strongest opposing case</div>
          <div class="da-steelman-text">${escHtml(steelman)}</div>
        </div>`;
    }

    // Blind-spot counterarguments
    if (blindSpotCounterarguments && blindSpotCounterarguments.length > 0) {
      const items = blindSpotCounterarguments.map(b => `
        <div class="cs-blindspot-item">
          <div class="cs-blindspot-objection">${escHtml(b.objection)}</div>
          <div class="cs-blindspot-why">${escHtml(b.why_it_matters)}</div>
        </div>`).join('');
      html += `
        <div class="cs-blindspot-section">
          <div class="cs-blindspot-label">Objections your draft doesn't address</div>
          ${items}
        </div>`;
    }

    html += `</div>`;
    return html;
  }

  // Word count
  textarea.addEventListener('input', () => {
    const count = countWords(textarea.value);
    lastWordCount = count;
    wordCountEl.textContent = `${count} word${count === 1 ? '' : 's'}`;

    if (count > 0 && count < MIN_WORDS) {
      minNotice.classList.remove('hidden');
    } else {
      minNotice.classList.add('hidden');
    }

    submitBtn.disabled = count < MIN_WORDS;
  });

  // Submit
  submitBtn.addEventListener('click', async () => {
    const text = textarea.value.trim();
    if (countWords(text) < MIN_WORDS) return;

    submitBtn.disabled = true;
    statusEl.textContent = 'Analysing your draft…';
    statusEl.classList.remove('hidden');
    resultEl.classList.add('hidden');
    resultEl.innerHTML = '';
    pdfRow.classList.add('hidden');
    lastResult = null;

    try {
      const res = await fetch('/api/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, mode: 'creator' }),
      });

      if (res.status === 429) {
        const data = await res.json() as { retryAfterSeconds?: number };
        statusEl.classList.add('hidden');
        resultEl.innerHTML = `<div class="da-error">The Studio's busy right now. Free during early access means shared capacity — try again in ${data.retryAfterSeconds ?? 'a few minutes'}.</div>`;
        resultEl.classList.remove('hidden');
        submitBtn.disabled = false;
        return;
      }

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = await res.json() as ApiResponse;
      statusEl.classList.add('hidden');
      resultEl.innerHTML = renderResult(data);
      resultEl.classList.remove('hidden');

      if (lastResult) pdfRow.classList.remove('hidden');
    } catch {
      statusEl.classList.add('hidden');
      resultEl.innerHTML = `<div class="da-error">Something went wrong. Check your connection and try again.</div>`;
      resultEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = countWords(textarea.value) < MIN_WORDS;
    }
  });

  // PDF export
  pdfBtn.addEventListener('click', async () => {
    if (!lastResult) return;

    pdfBtn.textContent = 'Generating…';
    pdfBtn.setAttribute('disabled', 'true');

    try {
      const { jsPDF } = await import('jspdf');
      const doc = new jsPDF({ unit: 'mm', format: 'a4' });

      const pageW = 210;
      const margin = 18;
      const contentW = pageW - margin * 2;
      let y = margin;

      const today = new Date().toISOString().slice(0, 10);

      function addText(
        text: string,
        fontSize: number,
        color: [number, number, number],
        opts: { bold?: boolean; italic?: boolean; gap?: number } = {}
      ) {
        doc.setFontSize(fontSize);
        doc.setTextColor(...color);
        doc.setFont('helvetica', opts.bold ? 'bold' : opts.italic ? 'italic' : 'normal');
        const lines = doc.splitTextToSize(text, contentW) as string[];
        const lineH = fontSize * 0.4;
        lines.forEach((line: string) => {
          if (y + lineH > 280) { doc.addPage(); y = margin; }
          doc.text(line, margin, y);
          y += lineH;
        });
        y += (opts.gap ?? 2);
      }

      function addLabel(label: string) {
        y += 3;
        addText(label, 7, [180, 120, 30], { bold: true, gap: 1 });
      }

      // Title
      addText('Whetstone Draft Audit', 18, [20, 20, 20], { bold: true, gap: 1 });
      addText(today, 8, [150, 150, 150], { gap: 3 });
      addText(`${lastWordCount} words analysed`, 8, [150, 150, 150], { gap: 6 });

      // Claim
      addLabel('CLAIM');
      addText(lastResult.toulmin.claim.text, 9, [55, 65, 81], { gap: 3 });

      // Warrant
      if (lastResult.toulmin.warrant) {
        addLabel('WARRANT — the unstated assumption');
        addText(lastResult.toulmin.warrant.text, 9, [49, 46, 129], { gap: 3 });
      }

      // Grounds
      if (lastResult.toulmin.data.length > 0) {
        addLabel('GROUNDS');
        lastResult.toulmin.data.forEach(d => addText(`• ${d.text}`, 9, [55, 65, 81], { gap: 1 }));
        y += 2;
      }

      // Fallacies
      if (lastResult.fallacies.length > 0) {
        addLabel('REASONING PATTERNS');
        lastResult.fallacies.forEach(f => {
          addText(f.type.replace(/_/g, ' ').toUpperCase(), 8, [180, 120, 30], { bold: true, gap: 0.5 });
          addText(`"${f.span}"`, 8, [120, 60, 20], { italic: true, gap: 0.5 });
          addText(f.explanation, 9, [55, 65, 81], { gap: 2 });
        });
      }

      // Steelman
      if (lastResult.steelman) {
        addLabel('STRONGEST OPPOSING CASE');
        addText(lastResult.steelman, 9, [55, 65, 81], { italic: true, gap: 3 });
      }

      // Blind-spot counterarguments
      if (lastResult.blindSpotCounterarguments && lastResult.blindSpotCounterarguments.length > 0) {
        addLabel('OBJECTIONS YOUR DRAFT DOESN\'T ADDRESS');
        lastResult.blindSpotCounterarguments.forEach(b => {
          addText(b.objection, 9, [120, 60, 20], { bold: true, gap: 0.5 });
          addText(b.why_it_matters, 9, [100, 100, 100], { gap: 2 });
        });
      }

      // Footer
      y = 285;
      doc.setFontSize(7);
      doc.setTextColor(180, 180, 180);
      doc.setFont('helvetica', 'normal');
      doc.text('Generated by Whetstone — thewhetstone.com', margin, y);

      doc.save(`whetstone-audit-${today}.pdf`);
    } catch (err) {
      console.error('[studio] PDF generation failed:', err);
    } finally {
      pdfBtn.removeAttribute('disabled');
      pdfBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg> Download audit memo (PDF)`;
    }
  });
</script>
