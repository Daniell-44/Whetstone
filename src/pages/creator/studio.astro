---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import StudioEditor from '../../components/studio/StudioEditor';
import { makeAuthDb } from '../../../functions/_lib/auth/db';
import { makeBillingDb } from '../../../functions/_lib/billing/subscription';
import { getSessionFromRequest } from '../../../functions/_lib/auth/sessions';
import { userHasActiveSubscription } from '../../../functions/_lib/billing/subscription';

const authDb    = makeAuthDb(env.DB);
const billingDb = makeBillingDb(env.DB);
const session   = await getSessionFromRequest(Astro.request, authDb);

if (!session) {
  return Astro.redirect('/login?returnTo=/creator/studio');
}

const hasActiveSubscription = await userHasActiveSubscription(billingDb, session.user_id);
---
<Base
  title="Creator Studio — The Whetstone"
  description="Paste your draft. Run the structural audit and surface the strongest opposing positions you haven't engaged with."
  canonicalPath="/creator/studio"
  isLoggedIn={true}
>
  <main class="max-w-3xl mx-auto px-6 pt-20 pb-16">

    <nav class="mb-10">
      <a href="/creator" class="text-xs text-gray-400 hover:text-gray-600 transition-colors">← Creator</a>
    </nav>

    <header class="mb-10">
      <p class="text-xs font-semibold tracking-widest text-amber-600 uppercase mb-3">Creator Studio</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 leading-tight mb-4">
        Studio — audit your draft
      </h1>
      <p class="text-lg text-gray-500 leading-relaxed max-w-xl">
        Paste your draft. We'll run the structural audit{hasActiveSubscription ? ' and surface the strongest opposing positions you haven\'t engaged with.' : '.'}
        {!hasActiveSubscription && (
          <span> <a href="/pricing" class="text-amber-600 hover:text-amber-700 underline">Subscribe</a> to also generate counterarguments.</span>
        )}
      </p>
    </header>

    <StudioEditor client:load hasActiveSubscription={hasActiveSubscription} />

  </main>
</Base>
