---
export const prerender = false;
// The Studio merged into /audit (2026-09): one page, a READ/CREATE toggle, and
// the same engine behind both. This route 301s to the writing posture so old
// links, bookmarks and `?doc=` deep-links keep landing where they used to.
const target = new URL('/audit', Astro.url);
target.searchParams.set('mode', 'create');
const doc = Astro.url.searchParams.get('doc');
if (doc) target.searchParams.set('doc', doc);
return Astro.redirect(target.pathname + target.search, 301);
---
