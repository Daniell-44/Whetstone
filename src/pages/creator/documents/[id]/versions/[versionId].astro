---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../../../../layouts/Base.astro';
import AuditResults from '../../../../../components/audit/AuditResults';
import CounterargumentResultDisplay from '../../../../../components/studio/CounterargumentResultDisplay';
import RestoreButton from '../../../../../components/studio/RestoreButton';
import { makeAuthDb } from '../../../../../../functions/_lib/auth/db';
import { makeDocumentDb } from '../../../../../../functions/_lib/documents/db';
import { getSessionFromRequest } from '../../../../../../functions/_lib/auth/sessions';
import type { AuditResult } from '../../../../../lib/audit';
import type { CounterargumentResult } from '../../../../../lib/counterargument';

const authDb  = makeAuthDb(env.DB);
const session = await getSessionFromRequest(Astro.request, authDb);

if (!session) {
  return Astro.redirect(`/login?returnTo=${Astro.url.pathname}`);
}

const { id: docId, versionId } = Astro.params;
if (!docId || !versionId) return Astro.redirect('/creator/documents');

const docDb   = makeDocumentDb(env.DB);
const doc     = await docDb.getDocumentById(docId);

if (!doc || doc.user_id !== session.user_id) {
  return Astro.redirect('/creator/documents');
}

const version = await docDb.getVersion(versionId);

if (!version || version.document_id !== docId) {
  return Astro.redirect(`/creator/documents/${docId}/versions`);
}

const auditResult:      AuditResult | null = version.audit_result      ? JSON.parse(version.audit_result)      : null;
const counterargResult: CounterargumentResult | null = version.counterarg_result ? JSON.parse(version.counterarg_result) : null;

function formatDate(epochMs: number): string {
  return new Date(epochMs).toLocaleString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric',
    hour: '2-digit', minute: '2-digit',
  });
}
---
<Base
  title={`Version ${version.version_number} — ${doc.title} — The Whetstone`}
  description={`Read-only view of version ${version.version_number} of your draft.`}
  canonicalPath={`/creator/documents/${docId}/versions/${versionId}`}
  isLoggedIn={true}
>
  <main class="max-w-3xl mx-auto px-6 pt-20 pb-16">

    <nav class="mb-10 flex items-center gap-4">
      <a href="/creator/documents" class="text-xs text-gray-400 hover:text-gray-600 transition-colors">← My Documents</a>
      <span class="text-xs text-gray-300">/</span>
      <a href={`/creator/documents/${docId}/versions`} class="text-xs text-gray-400 hover:text-gray-600 transition-colors truncate max-w-xs">
        {doc.title}
      </a>
    </nav>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-xs font-semibold tracking-widest text-amber-600 uppercase mb-3">Version {version.version_number}</p>
        <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 leading-tight mb-2">{doc.title}</h1>
        <p class="text-sm text-gray-400">Saved {formatDate(version.created_at)}</p>
      </div>
      <div class="shrink-0 mt-4">
        <RestoreButton client:load docId={docId} versionId={versionId} />
      </div>
    </header>

    {/* Draft content */}
    <section class="rounded-xl border border-gray-200 bg-white p-6 mb-8">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">Draft content</h2>
      <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap">{version.content}</p>
    </section>

    {/* Audit results */}
    {auditResult && (
      <section class="rounded-xl border border-gray-200 bg-white p-6 mb-8">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Structural Audit</h2>
        <AuditResults result={auditResult} />
      </section>
    )}

    {/* Counterargument results */}
    {counterargResult && (
      <section class="rounded-xl border border-violet-200 bg-white p-6 mb-8">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Counterarguments</h2>
        <CounterargumentResultDisplay result={counterargResult} />
      </section>
    )}

    {!auditResult && !counterargResult && (
      <div class="rounded-xl border border-gray-100 bg-gray-50 p-6 text-center">
        <p class="text-sm text-gray-400">No analysis has been run on this version.</p>
        <a
          href={`/creator/studio?doc=${docId}`}
          class="inline-block mt-3 text-sm text-amber-600 hover:text-amber-700 underline"
        >
          Open in Studio to run analysis →
        </a>
      </div>
    )}

  </main>
</Base>
