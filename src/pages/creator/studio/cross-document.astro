---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import CrossDocumentForm from '../../../components/cross-document/CrossDocumentForm';
import StudioNav from '../../../components/studio/StudioNav.astro';
import { makeAuthDb } from '../../../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../../../functions/_lib/auth/sessions';

const authDb      = makeAuthDb(env.DB);
const session     = await getSessionFromRequest(Astro.request, authDb);
---
<Base
  title="Cross-Document Audit - Studio"
  description="Audit 2-5 documents together. Find self-contradictions, repeated unstated warrants, and position shifts across an author's work."
  canonicalPath="/creator/studio/cross-document"
  isLoggedIn={!!session}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-10 pb-16 sm:pb-24">

    <StudioNav current="cross-document" isSignedIn={!!session} />

    <header class="mb-8">
      <h1 class="font-serif text-3xl sm:text-4xl text-ink-strong leading-tight mb-3">
        Cross-document audit
      </h1>
      <p class="text-base sm:text-lg text-muted leading-relaxed max-w-3xl">
        Paste or link 2-5 documents - typically by the same author, or on the same topic.
        The engine audits each one, then compares across them: claims that get contradicted,
        warrants repeated without defence, positions that shift without acknowledgement, and
        certainty that escalates without new evidence.
      </p>
      <p class="text-xs text-muted mt-3">
        Each document is fully audited before the cross-document pass -
        analysis takes 60-120 seconds.
      </p>
    </header>

    <CrossDocumentForm client:load />

  </main>
</Base>
