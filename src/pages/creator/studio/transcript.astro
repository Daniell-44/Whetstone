---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import TranscriptStudio from '../../../components/transcript/TranscriptStudio';
import StudioNav from '../../../components/studio/StudioNav.astro';
import { makeAuthDb } from '../../../../functions/_lib/auth/db';
import { getSessionFromRequest } from '../../../../functions/_lib/auth/sessions';

const authDb  = makeAuthDb(env.DB);
const session = await getSessionFromRequest(Astro.request, authDb);

// Transcript runs persist as documents in the caller's library, so this room
// still requires sign-in: there is no account-less place to put the result.
// The subscription gate that used to sit behind that is gone - every engine is
// on the free tier (owner decision 2026-08-14).
if (!session) {
  return Astro.redirect('/login?returnTo=/creator/studio/transcript');
}
---
<Base
  title="Transcript Audit - The Whetstone"
  description="Audit a YouTube video, podcast, or speech transcript. Per-segment audits plus cross-segment synthesis."
  canonicalPath="/creator/studio/transcript"
  isLoggedIn={true}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-10 pb-16 sm:pb-24">

    <StudioNav current="transcript" />

    <header class="mb-8">
      <h1 class="font-serif text-3xl sm:text-4xl text-ink-strong leading-tight mb-3">
        Transcript audit
      </h1>
      <p class="text-base sm:text-lg text-muted leading-relaxed max-w-3xl">
        Drop a YouTube URL or paste a transcript. The engine identifies the argumentative segments,
        audits each one, and synthesises patterns across the whole transcript - claims that get walked back,
        warrants repeated without defence, objections raised but never engaged.
      </p>
      <p class="text-xs text-muted mt-3">
        60-minute podcasts typically yield 4-8 audited segments.
      </p>
    </header>

    <TranscriptStudio client:load />

  </main>
</Base>
