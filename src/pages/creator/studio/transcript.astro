---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import TranscriptStudio from '../../../components/transcript/TranscriptStudio';
import { makeAuthDb } from '../../../../functions/_lib/auth/db';
import { makeBillingDb } from '../../../../functions/_lib/billing/subscription';
import { makeWorkspaceDb } from '../../../../functions/_lib/workspaces/db';
import { userHasActiveSubscriptionViaWorkspace } from '../../../../functions/_lib/workspaces/permissions';
import { getSessionFromRequest } from '../../../../functions/_lib/auth/sessions';

const authDb      = makeAuthDb(env.DB);
const billingDb   = makeBillingDb(env.DB);
const workspaceDb = makeWorkspaceDb(env.DB);
const session     = await getSessionFromRequest(Astro.request, authDb);

if (!session) {
  return Astro.redirect('/login?returnTo=/creator/studio/transcript');
}

const hasActiveSubscription = await userHasActiveSubscriptionViaWorkspace(billingDb, workspaceDb, session.user_id);
---
<Base
  title="Transcript Audit - Studio"
  description="Audit a YouTube video, podcast, or speech transcript. Per-segment audits plus cross-segment synthesis."
  canonicalPath="/creator/studio/transcript"
  isLoggedIn={true}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-10 pb-16 sm:pb-24">

    <!-- Top nav -->
    <nav class="mb-6 flex items-center justify-between text-xs">
      <div class="flex items-center gap-3">
        <a href="/creator" class="text-muted hover:text-ink transition-colors">← Studio</a>
        <span class="text-hairline">|</span>
        <p class="font-semibold tracking-widest text-amber-600 uppercase">Studio · Transcript</p>
      </div>
      <a href="/creator/studio" class="text-muted hover:text-ink transition-colors">
        ← Back to Studio
      </a>
    </nav>

    <header class="mb-8">
      <h1 class="font-serif text-3xl sm:text-4xl text-ink-strong leading-tight mb-3">
        Transcript audit
      </h1>
      <p class="text-base sm:text-lg text-muted leading-relaxed max-w-3xl">
        Drop a YouTube URL or paste a transcript. The engine identifies the argumentative segments,
        audits each one, and synthesises patterns across the whole transcript - claims that get walked back,
        warrants repeated without defence, objections raised but never engaged.
      </p>
      <p class="text-xs text-muted mt-3">
        Studio-tier feature. 60-minute podcasts typically yield 4-8 audited segments.
      </p>
    </header>

    {!hasActiveSubscription ? (
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-6 text-center space-y-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-amber-600">Studio Pro feature</p>
        <p class="text-sm text-ink max-w-sm mx-auto leading-relaxed">
          Transcript audits run the full audit suite on each segment plus a cross-segment synthesis pass.
          Subscribe to unlock it.
        </p>
        <a href="/pricing" class="inline-block rounded-xl bg-amber-500 px-6 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 transition-colors">
          See plans →
        </a>
      </div>
    ) : (
      <TranscriptStudio client:load />
    )}

  </main>
</Base>
