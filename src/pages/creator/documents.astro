---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import WorkspaceSwitcher from '../../components/layout/WorkspaceSwitcher';
import { makeAuthDb } from '../../../functions/_lib/auth/db';
import { makeDocumentDb } from '../../../functions/_lib/documents/db';
import { makeWorkspaceDb } from '../../../functions/_lib/workspaces/db';
import { getSessionFromRequest } from '../../../functions/_lib/auth/sessions';
import type { Document } from '../../../functions/_lib/documents/types';

const authDb  = makeAuthDb(env.DB);
const session = await getSessionFromRequest(Astro.request, authDb);

if (!session) {
  return Astro.redirect('/login?returnTo=/creator/documents');
}

const workspaceDb       = makeWorkspaceDb(env.DB);
const docDb             = makeDocumentDb(env.DB);
const workspaceIdParam  = Astro.url.searchParams.get('workspace');

let documents: Document[];
let workspaceName: string | null = null;

if (workspaceIdParam) {
  const member = await workspaceDb.getMember(workspaceIdParam, session.user_id);
  if (member) {
    const ws = await workspaceDb.getWorkspaceById(workspaceIdParam);
    workspaceName = ws?.name ?? null;
    documents     = await docDb.listActiveDocumentsForWorkspace(workspaceIdParam);
  } else {
    documents = await docDb.listActiveDocumentsForUser(session.user_id);
  }
} else {
  documents = await docDb.listActiveDocumentsForUser(session.user_id);
}

const versionCounts: Record<string, number> = Object.fromEntries(
  await Promise.all(documents.map(async d => [d.id, await docDb.countVersionsForDocument(d.id)] as const))
);

function formatDate(epochMs: number): string {
  return new Date(epochMs).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---
<Base
  title="My Documents - The Whetstone"
  description="Your saved Studio drafts."
  canonicalPath="/creator/documents"
  isLoggedIn={true}
>
  <main class="max-w-3xl mx-auto px-6 pt-20 pb-16">

    <nav class="mb-10">
      <a href="/creator" class="text-xs text-muted hover:text-ink transition-colors">← Studio</a>
    </nav>

    <header class="mb-10 flex items-start justify-between">
      <div>
        <p class="text-xs font-semibold tracking-widest text-amber-600 uppercase mb-3">Studio</p>
        <h1 class="font-serif text-4xl sm:text-5xl text-ink-strong leading-tight">
          {workspaceName ? workspaceName : 'My Documents'}
        </h1>
      </div>
      <div class="mt-4 flex items-center gap-3">
        <WorkspaceSwitcher currentWorkspaceId={workspaceIdParam} client:load />
        <a
          href="/creator/studio"
          class="shrink-0 rounded-xl bg-amber-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 transition-colors"
        >
          New draft
        </a>
      </div>
    </header>

    {documents.length === 0 ? (
      <div class="rounded-xl border border-hairline bg-paper p-12 text-center">
        <p class="text-muted mb-4">No saved drafts yet.</p>
        <a href="/creator/studio" class="text-sm text-amber-600 hover:text-amber-700 underline">
          Start your first draft →
        </a>
      </div>
    ) : (
      <ul class="divide-y divide-hairline">
        {documents.map(doc => (
          <li class="py-4 flex items-center justify-between gap-4">
            <div class="min-w-0">
              <a
                href={`/creator/studio?doc=${doc.id}`}
                class="block text-sm font-medium text-ink-strong hover:text-amber-700 truncate transition-colors"
              >
                {doc.title}
              </a>
              <div class="flex items-center gap-3 mt-0.5">
                <p class="text-xs text-muted">Updated {formatDate(doc.updated_at)}</p>
                <a
                  href={`/creator/documents/${doc.id}/versions`}
                  class="text-xs text-muted hover:text-amber-600 transition-colors"
                >
                  {versionCounts[doc.id] ?? 0} version{(versionCounts[doc.id] ?? 0) === 1 ? '' : 's'}
                </a>
              </div>
            </div>
            <a
              href={`/creator/studio?doc=${doc.id}`}
              class="shrink-0 text-xs text-muted hover:text-amber-600 transition-colors"
            >
              Open →
            </a>
          </li>
        ))}
      </ul>
    )}

  </main>
</Base>
