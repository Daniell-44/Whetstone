---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import WorkspaceSwitcher from '../../components/layout/WorkspaceSwitcher';
import StudioNav from '../../components/studio/StudioNav.astro';
import { makeAuthDb } from '../../../functions/_lib/auth/db';
import { makeDocumentDb } from '../../../functions/_lib/documents/db';
import { makeWorkspaceDb } from '../../../functions/_lib/workspaces/db';
import { getSessionFromRequest } from '../../../functions/_lib/auth/sessions';
import ReAuditButton from '../../components/documents/ReAuditButton';
import type { Document, DocumentKind } from '../../../functions/_lib/documents/types';

const authDb  = makeAuthDb(env.DB);
const session = await getSessionFromRequest(Astro.request, authDb);

if (!session) {
  return Astro.redirect('/login?returnTo=/creator/documents');
}

const workspaceDb       = makeWorkspaceDb(env.DB);
const docDb             = makeDocumentDb(env.DB);
const workspaceIdParam  = Astro.url.searchParams.get('workspace');
// The subscription lookup that used to run here only fed StudioNav's Subscribe
// pill, which is gone (free-tier decision 2026-08-14), so the billing query
// went with it.

let documents: Document[];
let workspaceName: string | null = null;

if (workspaceIdParam) {
  const member = await workspaceDb.getMember(workspaceIdParam, session.user_id);
  if (member) {
    const ws = await workspaceDb.getWorkspaceById(workspaceIdParam);
    workspaceName = ws?.name ?? null;
    documents     = await docDb.listActiveDocumentsForWorkspace(workspaceIdParam);
  } else {
    documents = await docDb.listActiveDocumentsForUser(session.user_id);
  }
} else {
  documents = await docDb.listActiveDocumentsForUser(session.user_id);
}

// Kind filter: ?kind=draft | transcript | cross-doc (anything else = all).
const KIND_FILTERS = [
  { value: 'all',        label: 'All' },
  { value: 'draft',      label: 'Drafts' },
  { value: 'transcript', label: 'Transcripts' },
  { value: 'cross-doc',  label: 'Cross-document' },
] as const;
const kindParam  = Astro.url.searchParams.get('kind');
const activeKind = KIND_FILTERS.some(f => f.value === kindParam) && kindParam !== 'all' ? kindParam as DocumentKind : 'all';
if (activeKind !== 'all') {
  documents = documents.filter(d => (d.kind ?? 'draft') === activeKind);
}

function filterHref(value: string): string {
  const params = new URLSearchParams();
  if (workspaceIdParam) params.set('workspace', workspaceIdParam);
  if (value !== 'all')  params.set('kind', value);
  const qs = params.toString();
  return `/creator/documents${qs ? `?${qs}` : ''}`;
}

// Persisted engine runs reopen on their own surface, read-only; drafts open in
// the merged editor at /audit (the one door since the 2026-08-16 merge).
function openHref(doc: Document): string {
  if (doc.kind === 'transcript') return `/creator/studio/transcript?doc=${doc.id}`;
  if (doc.kind === 'cross-doc')  return `/creator/studio/cross-document?doc=${doc.id}`;
  return `/audit?mode=create&doc=${doc.id}`;
}

const KIND_BADGES: Record<string, string> = {
  transcript:  'Transcript',
  'cross-doc': 'Cross-doc',
};

const versionCounts: Record<string, number> = Object.fromEntries(
  await Promise.all(documents.map(async d => [d.id, await docDb.countVersionsForDocument(d.id)] as const))
);

function formatDate(epochMs: number): string {
  return new Date(epochMs).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---
<Base
  title="My Documents - The Whetstone"
  description="Your saved drafts and analysis runs."
  canonicalPath="/creator/documents"
  isLoggedIn={true}
>
  <main class="max-w-3xl mx-auto px-6 pt-20 pb-16">

    <StudioNav current="documents" />

    <header class="mb-10 flex items-start justify-between">
      <div>
        <h1 class="font-serif text-4xl sm:text-5xl text-ink-strong leading-tight">
          {workspaceName ? workspaceName : 'My Documents'}
        </h1>
        <a
          href="/creator/shares"
          class="mt-2 inline-block text-xs text-muted hover:text-accent-support transition-colors"
        >
          Share links →
        </a>
      </div>
      <div class="mt-4 flex items-center gap-3">
        <WorkspaceSwitcher currentWorkspaceId={workspaceIdParam} client:load />
        <a
          href="/audit?mode=create"
          class="shrink-0 rounded-xl bg-accent-support px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent transition-colors"
        >
          New draft
        </a>
      </div>
    </header>

    <nav class="mb-6 flex flex-wrap items-center gap-2" aria-label="Filter documents by kind">
      {KIND_FILTERS.map(f => {
        const isActive = (activeKind === 'all' && f.value === 'all') || activeKind === f.value;
        return (
          <a
            href={filterHref(f.value)}
            aria-current={isActive ? 'true' : undefined}
            class={`font-mono text-[11px] uppercase tracking-[0.08em] rounded border px-2 py-1 transition-colors ${
              isActive
                ? 'border-accent-support text-accent-support'
                : 'border-hairline text-muted hover:text-ink'
            }`}
          >
            {f.label}
          </a>
        );
      })}
    </nav>

    {documents.length === 0 ? (
      <div class="rounded-xl border border-hairline bg-paper p-12 text-center">
        {activeKind === 'all' || activeKind === 'draft' ? (
          <>
            <p class="text-muted mb-4">No saved {activeKind === 'draft' ? 'drafts' : 'documents'} yet.</p>
            <a href="/audit?mode=create" class="text-sm text-accent-support hover:text-accent underline">
              Start your first draft →
            </a>
          </>
        ) : activeKind === 'transcript' ? (
          <>
            <p class="text-muted mb-4">No saved transcript audits yet. Successful runs are saved here automatically.</p>
            <a href="/creator/studio/transcript" class="text-sm text-accent-support hover:opacity-80 underline">
              Run a transcript audit →
            </a>
          </>
        ) : (
          <>
            <p class="text-muted mb-4">No saved cross-document analyses yet. Successful runs are saved here automatically.</p>
            <a href="/creator/studio/cross-document" class="text-sm text-accent-support hover:opacity-80 underline">
              Run a cross-document analysis →
            </a>
          </>
        )}
      </div>
    ) : (
      <ul class="divide-y divide-hairline">
        {documents.map(doc => (
          <li class="py-4 flex items-center justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 min-w-0">
                <a
                  href={openHref(doc)}
                  class="block text-sm font-medium text-ink-strong hover:text-accent-support truncate transition-colors"
                >
                  {doc.title}
                </a>
                {doc.kind !== 'draft' && (
                  <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.08em] text-muted border border-hairline rounded px-1.5 py-0.5">
                    {KIND_BADGES[doc.kind] ?? doc.kind}
                  </span>
                )}
              </div>
              <div class="flex items-center gap-3 mt-0.5">
                <p class="text-xs text-muted">Updated {formatDate(doc.updated_at)}</p>
                {doc.kind === 'draft' && (
                  <a
                    href={`/creator/documents/${doc.id}/versions`}
                    class="text-xs text-muted hover:text-accent-support transition-colors"
                  >
                    {versionCounts[doc.id] ?? 0} version{(versionCounts[doc.id] ?? 0) === 1 ? '' : 's'}
                  </a>
                )}
              </div>
              {doc.kind === 'draft' && (
                <div class="mt-2">
                  <ReAuditButton docId={doc.id} quotaPeriod={hasActiveSubscription ? 'month' : 'day'} client:load />
                </div>
              )}
            </div>
            <a
              href={openHref(doc)}
              class="shrink-0 text-xs text-muted hover:text-accent-support transition-colors"
            >
              Open →
            </a>
          </li>
        ))}
      </ul>
    )}

  </main>
</Base>
