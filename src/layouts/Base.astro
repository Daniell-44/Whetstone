---
import '../styles/global.css';

interface Props {
  title:         string;
  description?:  string;
  canonicalPath?: string;
}

const {
  title,
  description = "The Whetstone — a tool for thinking more carefully about arguments.",
  canonicalPath = '/',
} = Astro.props;

const siteUrl = 'https://devils-advocate-site.pages.dev';
const ogImage = `${siteUrl}/og-image.png`;
const pageUrl = `${siteUrl}${canonicalPath}`;

const currentPath = canonicalPath;
---
<!doctype html>
<html lang="en" class="bg-gray-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={pageUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />

    <!-- Twitter card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
  </head>
  <body class="min-h-screen text-gray-900 font-sans antialiased">

    <!-- Site navigation -->
    <header class="border-b border-gray-100 bg-white/80 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-3xl mx-auto px-6 h-14 flex items-center justify-between gap-6">

        <!-- Brand mark -->
        <a href="/" class="font-serif text-base text-gray-900 hover:text-gray-700 transition-colors shrink-0">
          The Whetstone.
        </a>

        <!-- Nav links -->
        <nav class="flex items-center gap-5 text-sm">
          <a
            href="/audit"
            class={`transition-colors ${currentPath === '/audit' ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-800'}`}
          >
            Audit
          </a>
          <a
            href="/reader"
            class={`transition-colors hidden sm:block ${currentPath === '/reader' ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-800'}`}
          >
            Reader
          </a>
          <a
            href="/creator"
            class={`transition-colors ${currentPath?.startsWith('/creator') ? 'text-amber-600 font-medium' : 'text-gray-500 hover:text-gray-800'}`}
          >
            Creator
          </a>
          <a
            href="/how-it-works"
            class={`transition-colors hidden sm:block ${currentPath === '/how-it-works' ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-800'}`}
          >
            How it works
          </a>
          <a
            href="/privacy"
            class={`transition-colors hidden sm:block ${currentPath === '/privacy' ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-800'}`}
          >
            Privacy
          </a>
        </nav>

      </div>
    </header>

    <slot />

    <footer class="border-t border-gray-100 mt-24 py-8">
      <div class="max-w-3xl mx-auto px-6 flex flex-wrap items-center justify-between gap-4 text-xs text-gray-400">
        <a href="/" class="hover:text-gray-600 transition-colors">The Whetstone <span class="text-gray-300">·</span> Devil's Advocate Chrome extension</a>
        <nav class="flex gap-5">
          <a href="/audit"        class="hover:text-gray-600 transition-colors">Audit</a>
          <a href="/reader"       class="hover:text-gray-600 transition-colors">Reader</a>
          <a href="/creator"      class="hover:text-gray-600 transition-colors">Creator</a>
          <a href="/how-it-works" class="hover:text-gray-600 transition-colors">How it works</a>
          <a href="/privacy"      class="hover:text-gray-600 transition-colors">Privacy</a>
        </nav>
      </div>
    </footer>

  </body>
</html>
