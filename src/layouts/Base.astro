---
import '../styles/global.css';

interface Props {
  title:          string;
  description?:   string;
  canonicalPath?: string;
  isLoggedIn?:    boolean;
}

const {
  title,
  description = "The Whetstone: a tool for thinking more carefully about arguments.",
  canonicalPath = '/',
  isLoggedIn = false,
} = Astro.props;

const siteUrl = 'https://thewhetstone.review';
const ogImage = `${siteUrl}/og-image.png`;
const pageUrl = `${siteUrl}${canonicalPath}`;

const currentPath = canonicalPath;
---
<!doctype html>
<html lang="en" class="bg-paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={pageUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />

    <!-- Twitter card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!--
      page_view analytics fire — opt-in only.
      Stays inline so it doesn't add a JS import to every page. It just POSTs
      one event if the consent flag is set. Silent on failure.
    -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('whetstone.analytics_consent') !== 'on') return;
          var ref = document.referrer || '';
          var kind = !ref ? 'direct'
            : (ref.indexOf(window.location.origin) === 0 ? 'internal' : 'external');
          var h = sessionStorage.getItem('whetstone.session_hash');
          if (!h) {
            var b = new Uint8Array(8); crypto.getRandomValues(b);
            h = Array.from(b, function (x) { return x.toString(16).padStart(2, '0'); }).join('');
            sessionStorage.setItem('whetstone.session_hash', h);
          }
          fetch('/api/analytics/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({
              events: [{
                eventName:   'page_view',
                sessionHash: h,
                path:        location.pathname,
                metadata:    { referrer_kind: kind },
              }],
            }),
          }).catch(function () {});
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen text-ink font-sans antialiased pb-16 sm:pb-0">

    <!-- Site navigation — desktop -->
    <header class="hidden sm:block border-b border-hairline bg-surface/90 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-8 h-16 flex items-center justify-between gap-6">

        <!-- Brand — "The Wire" nameplate: indigo mark + compact serif wordmark + sans strapline -->
        <a href="/" class="group flex items-center gap-2.5 shrink-0">
          <svg viewBox="4 22 92 57" fill="currentColor" class="h-6 w-auto shrink-0 text-accent transition-colors" aria-hidden="true"><path d="M16 59A34 34 0 0 1 84 59L60 59A10 10 0 0 0 40 59Z"/><rect x="7.5" y="65" width="85" height="10.5"/></svg>
          <span class="flex flex-col leading-none">
            <span class="font-serif text-lg text-ink-strong group-hover:text-accent transition-colors">The Whetstone</span>
            <span class="mt-1 text-[9px] font-semibold uppercase tracking-[0.2em] text-muted">Arguments, examined</span>
          </span>
        </a>

        <!-- Nav links -->
        <nav class="flex items-center gap-5 text-sm">
          <a
            href="/"
            class={`transition-colors ${currentPath === '/' ? 'text-accent font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent'}`}
          >
            Briefings
          </a>
          <a
            href="/audit"
            class={`transition-colors ${currentPath === '/audit' ? 'text-accent font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent'}`}
          >
            Audit
          </a>
          <a
            href="/creator"
            class={`transition-colors ${currentPath?.startsWith('/creator') ? 'text-accent font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent'}`}
          >
            Studio
          </a>
          <a
            href="/about"
            class={`transition-colors hidden sm:block ${currentPath === '/about' ? 'text-accent font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent'}`}
          >
            About
          </a>
          <a
            href="/pricing"
            class={`transition-colors hidden sm:block ${currentPath === '/pricing' ? 'text-accent font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent'}`}
          >
            Pricing
          </a>
          {isLoggedIn ? (
            <a
              href="/account"
              class={`transition-colors ${currentPath === '/account' ? 'text-accent font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent'}`}
            >
              Account
            </a>
          ) : (
            <a
              href="/login"
              class={`transition-colors ${currentPath === '/login' ? 'text-accent font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent'}`}
            >
              Sign in
            </a>
          )}
        </nav>

      </div>
    </header>

    <!-- Site navigation — mobile (slim top brand bar) -->
    <header class="sm:hidden border-b border-hairline bg-surface/95 backdrop-blur-sm sticky top-0 z-30">
      <div class="px-4 h-12 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-serif text-base text-ink-strong">
          <svg viewBox="4 22 92 57" fill="currentColor" class="h-[1.15rem] w-auto shrink-0 text-accent" aria-hidden="true"><path d="M16 59A34 34 0 0 1 84 59L60 59A10 10 0 0 0 40 59Z"/><rect x="7.5" y="65" width="85" height="10.5"/></svg>
          <span>The Whetstone</span>
        </a>
        {isLoggedIn ? (
          <a href="/account" class="text-xs text-ink">Account</a>
        ) : (
          <a href="/login" class="text-xs text-ink">Sign in</a>
        )}
      </div>
    </header>

    <slot />

    <!-- Mobile bottom tab bar — primary navigation -->
    <nav
      class="sm:hidden fixed bottom-0 left-0 right-0 z-30 bg-paper border-t border-hairline grid grid-cols-3 h-16"
      style="padding-bottom: env(safe-area-inset-bottom, 0);"
    >
      <a
        href="/"
        class={`flex flex-col items-center justify-center gap-0.5 transition-colors ${currentPath === '/' ? 'text-accent' : 'text-muted'}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        <span class="text-xs font-medium">Briefings</span>
      </a>
      <a
        href="/audit"
        class={`flex flex-col items-center justify-center gap-0.5 transition-colors ${currentPath?.startsWith('/audit') ? 'text-accent' : 'text-muted'}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
        <span class="text-xs font-medium">Audit</span>
      </a>
      <a
        href="/creator"
        class={`flex flex-col items-center justify-center gap-0.5 transition-colors ${currentPath?.startsWith('/creator') ? 'text-accent' : 'text-muted'}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        <span class="text-xs font-medium">Studio</span>
      </a>
    </nav>

    <!-- Footer — visible on mobile too (About/Pricing dropped off the tab bar
         when Audit joined it; the footer is their mobile home). pb clears the
         fixed tab bar. -->
    <footer class="border-t border-hairline mt-24 py-8 pb-24 sm:pb-8">
      <div class="max-w-3xl mx-auto px-6 flex flex-wrap items-center justify-between gap-4 text-xs text-muted">
        <a href="/" class="hover:text-accent transition-colors">The Whetstone <span class="text-hairline">·</span> Arguments, examined</a>
        <nav class="flex flex-wrap gap-5">
          <a href="/"        class="hover:text-accent transition-colors">Briefings</a>
          <a href="/audit"   class="hover:text-accent transition-colors">Audit</a>
          <a href="/creator" class="hover:text-accent transition-colors">Studio</a>
          <a href="/about"   class="hover:text-accent transition-colors">About</a>
          <a href="/pricing" class="hover:text-accent transition-colors">Pricing</a>
          <a href="/feedback" class="hover:text-accent transition-colors">Feedback</a>
          <a href="/account" class="hover:text-accent transition-colors">Account</a>
          <a href="/privacy" class="hover:text-accent transition-colors">Privacy</a>
        </nav>
      </div>
    </footer>

  </body>
</html>
