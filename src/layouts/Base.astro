---
import '@fontsource-variable/besley';
import '../styles/global.css';

import EmailCapture from '../components/capture/EmailCapture';
import { SITE_URL } from '../lib/site';

interface Props {
  title:          string;
  description?:   string;
  canonicalPath?: string;
  isLoggedIn?:    boolean;
  ogType?:        string;   // 'website' (default) | 'article' for briefings
  ogImage?:       string;   // per-page share card; falls back to the site card
  /** Pages that mount their own inline EmailCapture pass true so the page
     doesn't ask for the same address twice (inline block + footer). */
  hideFooterCapture?: boolean;
  /** Suppress the AdSense tag. Set on labs and admin surfaces. */
  noAds?: boolean;
}

// Daniel's AdSense publisher ID, supplied 2026-08-10. Not a secret (it ships
// in the page source of every AdSense site by design), so it lives in code
// rather than an env var, where it is greppable and reviewable.
const ADSENSE_CLIENT = 'ca-pub-7549919425238742';

const {
  title,
  description = "The Whetstone: a tool for thinking more carefully about arguments.",
  canonicalPath = '/',
  isLoggedIn = false,
  ogType = 'website',
  ogImage: ogImageProp,
  hideFooterCapture = false,
  noAds = false,
} = Astro.props;

const siteUrl = SITE_URL;
// Per-page OG image when supplied (a briefing's own card); site card otherwise.
// Absolute-URL the relative paths callers pass.
const ogImage = ogImageProp
  ? (ogImageProp.startsWith('http') ? ogImageProp : `${siteUrl}${ogImageProp}`)
  : `${siteUrl}/og-image.png`;
const pageUrl = `${siteUrl}${canonicalPath}`;

const currentPath = canonicalPath;
---
<!doctype html>
<html lang="en" class="bg-paper">
  <head>
    <meta charset="UTF-8" />
    {/* viewport-fit=cover makes env(safe-area-inset-*) actually resolve on
       notched iPhones — without it the tab bar's safe-area padding is dead
       code, and in standalone/PWA mode the bar would sit under the home
       indicator. The bar + clearances below grow by the inset. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* PWA on-ramp: the manifest (with an Android share-target into /audit)
       makes the site installable; icons already lived in public/ unreferenced.
       Everything here is origin-relative — the domain decision gates
       PROMOTING installs, not this wiring. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F3F4F1" />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={pageUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />

    <!-- Twitter card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!--
      page_view analytics fire — opt-in only.
      Stays inline so it doesn't add a JS import to every page. It just POSTs
      one event if the consent flag is set. Silent on failure.
    -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('whetstone.analytics_consent') !== 'on') return;
          var ref = document.referrer || '';
          var kind = !ref ? 'direct'
            : (ref.indexOf(window.location.origin) === 0 ? 'internal' : 'external');
          var h = sessionStorage.getItem('whetstone.session_hash');
          if (!h) {
            var b = new Uint8Array(8); crypto.getRandomValues(b);
            h = Array.from(b, function (x) { return x.toString(16).padStart(2, '0'); }).join('');
            sessionStorage.setItem('whetstone.session_hash', h);
          }
          fetch('/api/analytics/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({
              events: [{
                eventName:   'page_view',
                sessionHash: h,
                path:        location.pathname,
                metadata:    { referrer_kind: kind },
              }],
            }),
          }).catch(function () {});
        } catch (_) {}
      })();
    </script>

    {/* Google AdSense (Daniel's publisher account, ID supplied 2026-08-10).
       This tag is BOTH the site-verification method and the ad loader, which
       is why it ships before any ad unit exists: AdSense reads it to confirm
       Daniel owns the domain when he applies.

       Daniel is applying once three finished articles are up, because the
       usual rejection is "low value content" and re-applying costs weeks.
       Until approval it loads, finds no ad units, and renders nothing.

       Deliberately NOT loaded on the labs pages or any admin route: those are
       noindexed working surfaces and there is no reason to hand a third party
       a request from them. `noAds` is the opt-out. */}
    {!noAds && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}

    {/* Page-specific head tags (e.g. per-briefing JSON-LD structured data,
       article:published_time). Injected via <... slot="head">. */}
    <slot name="head" />
  </head>
  <body class="min-h-screen text-ink font-sans antialiased pb-[calc(4rem+env(safe-area-inset-bottom,0px))] sm:pb-0">

    <!-- Site navigation — desktop -->
    <header class="hidden sm:block border-b border-hairline bg-surface/90 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-8 h-16 flex items-center justify-between gap-6">

        <!-- Brand — instrument nameplate: gauge mark + Besley wordmark + mono strapline -->
        <a href="/" class="group flex items-center gap-2.5 shrink-0">
          <svg viewBox="4 22 92 57" fill="currentColor" class="h-6 w-auto shrink-0 text-ink-strong transition-colors" aria-hidden="true"><path d="M16 59A34 34 0 0 1 84 59L60 59A10 10 0 0 0 40 59Z"/><rect x="7.5" y="65" width="85" height="10.5"/></svg>
          <span class="flex flex-col leading-none">
            <span class="font-serif text-lg font-semibold text-ink-strong group-hover:text-accent-support transition-colors">The Whetstone</span>
            <span class="mt-1 font-mono text-[9px] uppercase tracking-[0.18em] text-muted">Arguments, examined <span class="text-accent">▮</span></span>
          </span>
        </a>

        <!-- Nav links -->
        <nav class="flex items-center gap-5 text-sm">
          <a
            href="/"
            aria-current={currentPath === '/' || currentPath?.startsWith('/briefing') ? 'page' : undefined}
            class={`transition-colors ${currentPath === '/' || currentPath?.startsWith('/briefing') ? 'text-accent-support font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent-support'}`}
          >
            Briefings
          </a>
          <a
            href="/audit"
            class={`transition-colors ${currentPath === '/audit' ? 'text-accent-support font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent-support'}`}
          >
            Audit
          </a>
          <a
            href="/creator"
            class={`transition-colors ${currentPath?.startsWith('/creator') ? 'text-accent-support font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent-support'}`}
          >
            Studio
          </a>
          <a
            href="/about"
            class={`transition-colors hidden sm:block ${currentPath === '/about' ? 'text-accent-support font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent-support'}`}
          >
            About
          </a>
          <a
            href="/pricing"
            class={`transition-colors hidden sm:block ${currentPath === '/pricing' ? 'text-accent-support font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent-support'}`}
          >
            Pricing
          </a>
          {isLoggedIn ? (
            <a
              href="/account"
              class={`transition-colors ${currentPath === '/account' ? 'text-accent-support font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent-support'}`}
            >
              Account
            </a>
          ) : (
            <a
              href="/login"
              class={`transition-colors ${currentPath === '/login' ? 'text-accent-support font-medium underline decoration-2 underline-offset-[6px]' : 'text-ink hover:text-accent-support'}`}
            >
              Sign in
            </a>
          )}
        </nav>

      </div>
    </header>

    <!-- Site navigation — mobile (slim top brand bar) -->
    <header class="sm:hidden border-b border-hairline bg-surface/95 backdrop-blur-sm sticky top-0 z-30">
      <div class="px-4 h-12 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-serif text-base text-ink-strong">
          {/* Ink, not the redline: the accent is reserved for findings and the
             one masthead tick — a decorative logo tint was a contract breach. */}
          <svg viewBox="4 22 92 57" fill="currentColor" class="h-[1.15rem] w-auto shrink-0 text-ink-strong" aria-hidden="true"><path d="M16 59A34 34 0 0 1 84 59L60 59A10 10 0 0 0 40 59Z"/><rect x="7.5" y="65" width="85" height="10.5"/></svg>
          <span>The Whetstone</span>
        </a>
        {/* Full-bar-height hit area (~48px) — the bare text anchor was a
           ~40x16px target on the only persistent auth entry on mobile. */}
        {isLoggedIn ? (
          <a href="/account" class="text-xs text-ink flex items-center h-12 px-4 -mr-4">Account</a>
        ) : (
          <a href="/login" class="text-xs text-ink flex items-center h-12 px-4 -mr-4">Sign in</a>
        )}
      </div>
    </header>

    <slot />

    <!-- Mobile bottom tab bar — primary navigation. Height GROWS by the
         safe-area inset (bar h-16 + inset) so the 64px tab targets are never
         crushed by the home-indicator padding on notched iPhones/PWA. The
         Briefings tab stays lit through /briefing/* (iOS HIG: the originating
         tab owns its navigation stack). -->
    <nav
      aria-label="Primary"
      class="sm:hidden fixed bottom-0 left-0 right-0 z-30 bg-paper border-t border-hairline grid grid-cols-3"
      style="height: calc(4rem + env(safe-area-inset-bottom, 0px)); padding-bottom: env(safe-area-inset-bottom, 0px);"
    >
      {/* Active tab carries THREE channels — a 2px top bar, semibold label,
         and the hue — because hue alone (blue vs grey) is invisible to a
         chunk of colourblind readers. The transparent border on inactive
         tabs keeps the geometry stable. */}
      <a
        href="/"
        aria-current={currentPath === '/' || currentPath?.startsWith('/briefing') ? 'page' : undefined}
        class={`flex flex-col items-center justify-center gap-0.5 transition-colors border-t-2 ${currentPath === '/' || currentPath?.startsWith('/briefing') ? 'text-accent-support border-accent-support' : 'text-muted border-transparent'}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        <span class={`text-[13px] ${currentPath === '/' || currentPath?.startsWith('/briefing') ? 'font-semibold' : 'font-medium'}`}>Briefings</span>
      </a>
      <a
        href="/audit"
        aria-current={currentPath?.startsWith('/audit') ? 'page' : undefined}
        class={`flex flex-col items-center justify-center gap-0.5 transition-colors border-t-2 ${currentPath?.startsWith('/audit') ? 'text-accent-support border-accent-support' : 'text-muted border-transparent'}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
        <span class={`text-[13px] ${currentPath?.startsWith('/audit') ? 'font-semibold' : 'font-medium'}`}>Audit</span>
      </a>
      {/* Tab 3 is session-aware: signed-out visitors get the Studio pitch
         (/creator); signed-in users skip the sell page and land straight in
         the editor (/creator/studio). Spending a scarce mobile tab on a pure
         sell page even for paying subscribers was the wrong trade. */}
      <a
        href={isLoggedIn ? '/creator/studio' : '/creator'}
        aria-current={currentPath?.startsWith('/creator') ? 'page' : undefined}
        class={`flex flex-col items-center justify-center gap-0.5 transition-colors border-t-2 ${currentPath?.startsWith('/creator') ? 'text-accent-support border-accent-support' : 'text-muted border-transparent'}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        <span class={`text-[13px] ${currentPath?.startsWith('/creator') ? 'font-semibold' : 'font-medium'}`}>Studio</span>
      </a>
    </nav>

    <!-- Footer — visible on mobile too (About/Pricing dropped off the tab bar
         when Audit joined it; the footer is their mobile home). pb clears the
         fixed tab bar. -->
    <footer class="border-t border-hairline mt-24 py-8 pb-[calc(6rem+env(safe-area-inset-bottom,0px))] sm:pb-8">
      {/* Compact email capture — the list lives in our own D1; nothing is
         sent until a sending address is wired. Suppressed on pages that carry
         their own inline capture (two identical asks reads as a banner). */}
      {!hideFooterCapture && (
        <div class="max-w-3xl mx-auto px-6 mb-4 pb-4 border-b border-hairline">
          <EmailCapture
            client:visible
            source="footer"
            heading="New briefings by email"
            compact
          />
        </div>
      )}
      {/* py-2 on each link lifts the tap targets past the WCAG 2.5.8 24px
         floor — this list is the only mobile home for About/Pricing/etc. */}
      <div class="max-w-3xl mx-auto px-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs text-muted">
        <a href="/" class="inline-block py-2 hover:text-accent-support transition-colors">The Whetstone <span class="text-hairline">·</span> Arguments, examined</a>
        <nav class="flex flex-wrap gap-x-5" aria-label="Footer">
          <a href="/"        class="inline-block py-2 hover:text-accent-support transition-colors">Briefings</a>
          <a href="/audit"   class="inline-block py-2 hover:text-accent-support transition-colors">Audit</a>
          <a href="/creator" class="inline-block py-2 hover:text-accent-support transition-colors">Studio</a>
          <a href="/about"   class="inline-block py-2 hover:text-accent-support transition-colors">About</a>
          <a href="/pricing" class="inline-block py-2 hover:text-accent-support transition-colors">Pricing</a>
          <a href="/feedback" class="inline-block py-2 hover:text-accent-support transition-colors">Feedback</a>
          <a href="/account" class="inline-block py-2 hover:text-accent-support transition-colors">Account</a>
          <a href="/archive" class="inline-block py-2 hover:text-accent-support transition-colors">Archive</a> <a href="/privacy" class="inline-block py-2 hover:text-accent-support transition-colors">Privacy</a>
        </nav>
      </div>
    </footer>

  </body>
</html>
